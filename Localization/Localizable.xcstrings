    "Tells Finder not to leave .DS_Store files on network shares and USB drives. Changes a Finder setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weist den Finder an, keine .DS_Store-Dateien auf Netzwerkfreigaben und USB-Laufwerken zu hinterlassen. Ändert eine Finder-Einstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica al Finder que no deje archivos .DS_Store en recursos compartidos de red ni en unidades USB. Cambia un ajuste del Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande au Finder de ne pas laisser de fichiers .DS_Store sur les partages réseau et les clés USB. Modifie un réglage du Finder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder को नेटवर्क शेयर और USB ड्राइव पर .DS_Store फ़ाइलें न छोड़ने को कहता है। एक Finder सेटिंग बदलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice al Finder di non lasciare file .DS_Store nelle condivisioni di rete e sulle unità USB. Cambia un’impostazione del Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク共有とUSBドライブに.DS_Storeファイルを作成しないようFinderに指示します。Finderの設定を変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder가 네트워크 공유 및 USB 드라이브에 .DS_Store 파일을 남기지 않도록 합니다. Finder 설정을 변경합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat Finder geen .DS_Store-bestanden achterlaten op netwerkshares en USB-schijven. Wijzigt een Finder-instelling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz ao Finder para não deixar arquivos .DS_Store em compartilhamentos de rede e unidades USB. Altera um ajuste do Finder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säger åt Finder att inte lämna .DS_Store-filer på nätverksresurser och USB-enheter. Ändrar en Finder-inställning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让访达不在网络共享和 USB 驱动器上留下 .DS_Store 文件。会更改一项访达设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告知Finder不要在網路共享和USB磁碟上留下 .DS_Store檔案。會更改一項Finder設定。"
          }
        }
      }
    },

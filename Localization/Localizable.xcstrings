    "Approve MyMole's helper in System Settings → General → Login Items & Extensions, then try the action again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genehmige den Helfer von MyMole unter „Systemeinstellungen“ → „Allgemein“ → „Anmeldeobjekte & Erweiterungen“ und versuche die Aktion dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba el asistente de MyMole en Ajustes del Sistema → General → Ítems de inicio y extensiones y vuelve a intentar la acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvez l’assistant de MyMole dans Réglages Système → Général → Ouverture et extensions, puis réessayez l’action."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग → सामान्य → लॉगइन आइटम और एक्सटेंशन में MyMole के हेल्पर को स्वीकृति दें, फिर क्रिया को फिर से आज़माएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva l’assistente di MyMole in Impostazioni di Sistema → Generali → Elementi login ed estensioni, poi riprova l’azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“システム設定”→“一般”→“ログイン項目と機能拡張”でMyMoleのヘルパーを承認してから、もう一度操作してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 일반 → 로그인 항목 및 확장 프로그램에서 MyMole의 도우미를 승인한 다음 작업을 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keur de helper van MyMole goed in Systeeminstellingen → Algemeen → Inlogonderdelen en extensies en probeer de handeling opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprove o auxiliar do MyMole em Ajustes do Sistema → Geral → Itens de Início de Sessão e Extensões e tente a ação novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänn MyMoles hjälpprogram i Systeminställningar → Allmänt → Startobjekt och tillägg och försök sedan igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”→“通用”→“登录项与扩展”中批准 MyMole 的辅助程序，然后重试该操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」→「一般」→「登入項目與延伸功能」中核准MyMole的輔助程式，然後再次嘗試此動作。"
          }
        }
      }
    },

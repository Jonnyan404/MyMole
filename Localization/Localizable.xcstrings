          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitの設定によってプログラムが実行される可能性があるため、確認されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 설정이 프로그램을 실행할 수 있어 확인하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

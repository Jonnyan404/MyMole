              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg सिस्टम आइटम स्थायी रूप से हटाया जाता है; यह रद्दी में नहीं जा सकता। इसे बनाने वाली सेवा जो चाहिए वह फिर से बनाती है। macOS पहले एडमिनिस्ट्रेटर का पासवर्ड माँगता है।"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg सिस्टम आइटम स्थायी रूप से हटाए जाते हैं; ये रद्दी में नहीं जा सकते। इन्हें बनाने वाली सेवाएँ जो चाहिए वह फिर से बनाती हैं। macOS पहले एडमिनिस्ट्रेटर का पासवर्ड माँगता है।"
                    }
                  }
                }
              }
            }
          }
        },

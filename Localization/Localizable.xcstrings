                      "value" : "%arg restaurados"
                    }
                  }
                }
              }
            },
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg no se pudo devolver"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg no se pudieron devolver"
                    }
                  }
                }

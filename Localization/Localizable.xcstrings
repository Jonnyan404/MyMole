    },
    "%@ is on one of your keep lists, or holds something that is, so it stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ steht auf einer deiner Behalten-Listen oder enthält etwas, das darauf steht, daher bleibt es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en una de tus listas de conservación, o contiene algo que lo está, así que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ figure dans l’une de vos listes de conservation, ou contient un élément qui y figure : il reste donc en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आपकी किसी रखें-सूची में है, या उसमें ऐसा कुछ है जो सूची में है, इसलिए यह बना रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in uno dei tuoi elenchi “Conserva”, o contiene qualcosa che lo è, quindi resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は保持リストにあるか、保持されているものを含んでいるため、残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 보관 목록 중 하나에 있거나 목록에 있는 항목을 포함하므로 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ staat op een van je behoudlijsten, of bevat iets dat daarop staat, en blijft dus staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está em uma das suas listas de mantidos, ou contém algo que está, por isso fica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ står på en av dina Behåll-listor, eller innehåller något som gör det, och blir därför kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 在你的某个保留清单上，或其中包含这类项目，因此保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在你的其中一個保留列表上，或包含列表上的項目，因此會留下。"
          }
        }
      }
    },

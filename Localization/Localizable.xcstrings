    "Unverified — use with caution" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未核实 —— 请谨慎使用"
          }
        }
      }
    },
    "Unverified — use with caution. You chose %lld unverified match%@. Ownership couldn't be confirmed; other apps may use this data. Continue only if you reviewed the selected paths. They go to the Trash, where you can restore them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unverified — use with caution. You chose %1$lld unverified match%2$@. Ownership couldn't be confirmed; other apps may use this data. Continue only if you reviewed the selected paths. They go to the Trash, where you can restore them."
          }
        }
      }
    },
    "Up to %@ in memory, then disk · %@ of saved scans · a history point at most every %lld h" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",

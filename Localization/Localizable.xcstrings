    "Widen the window to change card width." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbreitere das Fenster, um die Kartenbreite zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensancha la ventana para cambiar el ancho de las tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {

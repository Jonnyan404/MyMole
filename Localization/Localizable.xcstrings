    "Background processes couldn't be checked after stopping the agents. The app stayed in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundprozesse konnten nach dem Stoppen der Agents nicht geprüft werden. Die App ist geblieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron comprobar los procesos en segundo plano tras detener los agentes. La app se quedó donde estaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les processus d’arrière-plan n’ont pas pu être vérifiés après l’arrêt des agents. L’app est restée en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजेंट रोकने के बाद बैकग्राउंड प्रोसेस जाँचे नहीं जा सके। ऐप अपनी जगह रहा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile controllare i processi in background dopo l’interruzione degli agenti. L’app è rimasta al suo posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントの停止後にバックグラウンドプロセスを確認できませんでした。アプリは元の場所に残りました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트를 중지한 후 백그라운드 프로세스를 확인할 수 없었습니다. 앱은 그대로 남았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtergrondprocessen konden na het stoppen van de agents niet worden gecontroleerd. De app is op zijn plaats gebleven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar os processos em segundo plano após parar os agentes. O app continua no lugar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrundsprocesser kunde inte kontrolleras efter att agenterna stoppats. Appen blev kvar på sin plats."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止自启动项后无法检查后台进程。应用保持原位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止代理程式後，無法檢查背景程序。App留在原處。"
          }
        }
      }
    },

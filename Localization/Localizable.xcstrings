            "state" : "translated",
            "value" : "%1$@%2$@（较 %3$@）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@（自%@起）"
          }
        }
      }
    },

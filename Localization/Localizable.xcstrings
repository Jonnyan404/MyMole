          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को ड्रैग और ड्रॉप से जोड़ें, या ऐप सूची के नीचे + पर क्लिक करके यह कॉपी चुनें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 드래그 앤 드롭으로 추가하거나, 앱 목록 아래의 +를 클릭하고 이 사본을 선택하세요."

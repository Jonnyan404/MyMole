    "Drag %@ to App Management" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in die App-Verwaltung ziehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra %@ a Gestión de apps"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser %@ dans Gestion des apps"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को ऐप प्रबंधन में खींचें"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 앱 관리로 드래그"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 %1$@ 拖到“应用管理”"
          }
        }
      }
    },
    "Drag a handle to move a card. Drag its corner sideways to resize. Cards fill each row and share its height." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe einen Griff, um eine Karte zu bewegen. Ziehe ihre Ecke seitwärts, um die Größe zu ändern. Karten füllen jede Zeile und teilen ihre Höhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un tirador para mover una tarjeta. Arrastra su esquina hacia los lados para cambiar su tamaño. Las tarjetas llenan cada fila y comparten su altura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une poignée pour déplacer une carte. Faites glisser son coin latéralement pour la redimensionner. Les cartes remplissent chaque ligne et en partagent la hauteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड ले जाने के लिए हैंडल खींचें। आकार बदलने के लिए उसका कोना बगल में खींचें। कार्ड हर पंक्ति भरते हैं और उसकी ऊँचाई साझा करते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핸들을 드래그해 카드를 이동하세요. 모서리를 옆으로 드래그하면 크기가 바뀝니다. 카드는 각 행을 채우고 높이를 공유합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动控制柄可移动卡片。横拖卡片角可调整大小。卡片铺满每行并共用行高。"
          }
        }
      }
    },
    "Drag column dividers to resize. Double-click a divider to fit visible contents. Right-click a heading to show or hide columns. Scroll sideways or hover to read full text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe Spaltentrenner, um die Größe zu ändern. Doppelklicke auf einen Trenner, um ihn an den sichtbaren Inhalt anzupassen. Klicke mit der rechten Maustaste auf eine Überschrift, um Spalten ein- oder auszublenden. Scrolle seitwärts oder bewege den Zeiger darüber, um den vollständigen Text zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los divisores de columna para cambiar su tamaño. Haz doble clic en un divisor para ajustarlo al contenido visible. Haz clic con el botón derecho en un encabezado para mostrar u ocultar columnas. Desplázate hacia los lados o pasa el puntero para leer el texto completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les séparateurs de colonnes pour les redimensionner. Double-cliquez sur un séparateur pour ajuster au contenu visible. Cliquez avec le bouton droit sur un en-tête pour afficher ou masquer des colonnes. Faites défiler latéralement ou survolez pour lire le texte entier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार बदलने के लिए कॉलम विभाजक खींचें। दिखने वाली सामग्री के अनुसार फ़िट करने के लिए विभाजक पर डबल-क्लिक करें। कॉलम दिखाने या छिपाने के लिए शीर्षक पर राइट-क्लिक करें। पूरा टेक्स्ट पढ़ने के लिए बगल में स्क्रॉल करें या पॉइंटर ले जाएँ।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 구분선을 드래그해 크기를 조절하세요. 구분선을 이중 클릭하면 보이는 내용에 맞춥니다. 머리글을 마우스 오른쪽 버튼으로 클릭해 열을 표시하거나 가립니다. 옆으로 스크롤하거나 포인터를 올려 전체 텍스트를 읽으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动列分隔线可调整宽度。双击分隔线可贴合可见内容。右键点击标题可显示或隐藏列。横向滚动或悬停可查看完整文字。"
          }
        }
      }
    },
    "Drag sideways to resize, or click to toggle width. Cards in a row share a height." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitwärts ziehen, um die Größe zu ändern, oder klicken, um die Breite umzuschalten. Karten in einer Zeile teilen eine Höhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra hacia los lados para cambiar el tamaño, o haz clic para alternar el ancho. Las tarjetas de una fila comparten altura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser latéralement pour redimensionner, ou cliquez pour changer la largeur. Les cartes d’une même ligne partagent une hauteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार बदलने के लिए बगल में खींचें, या चौड़ाई बदलने के लिए क्लिक करें। एक पंक्ति के कार्ड ऊँचाई साझा करते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "옆으로 드래그해 크기를 조절하거나 클릭해 너비를 전환하세요. 한 행의 카드는 높이를 공유합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横向拖动可调整大小，点按可切换宽度。同一行的卡片共用高度。"
          }
        }
      }
    },
    "Drag this app into the App Management list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe diese App in die Liste der App-Verwaltung."

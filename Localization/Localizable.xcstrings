    "The app's move to the Trash could not be verified. No app data was moved. Check the app in Finder before trying again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bewegen der App in den Papierkorb konnte nicht geprüft werden. Es wurden keine App-Daten bewegt. Sieh dir die App im Finder an, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el traslado de la app a la Papelera. No se movió ningún dato de apps. Comprueba la app en el Finder antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le placement de l’app dans la Corbeille n’a pas pu être vérifié. Aucune donnée d’app n’a été déplacée. Vérifiez l’app dans le Finder avant de réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को रद्दी में ले जाना सत्यापित नहीं हो सका। कोई ऐप डेटा नहीं ले जाया गया। फिर से कोशिश करने से पहले Finder में ऐप जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile verificare lo spostamento dell’app nel Cestino. Non è stato spostato nessun dato delle app. Controlla l’app nel Finder prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがゴミ箱に入ったことを確認できませんでした。アプリのデータは移動されていません。やり直す前に、Finderでアプリを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 휴지통으로 이동한 것을 확인할 수 없었습니다. 앱 데이터는 이동되지 않았습니다. 다시 시도하기 전에 Finder에서 앱을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verplaatsen van de app naar de prullenmand kon niet worden geverifieerd. Er zijn geen appgegevens verplaatst. Controleer de app in Finder voordat je het opnieuw probeert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar a movimentação do app para o Lixo. Nenhum dado do app foi movido. Verifique o app no Finder antes de tentar novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att verifiera att appen flyttades till papperskorgen. Inga appdata flyttades. Kontrollera appen i Finder innan du försöker igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法核实应用移到废纸篓的操作。没有移动任何应用数据。重试前请在访达中确认该应用。"

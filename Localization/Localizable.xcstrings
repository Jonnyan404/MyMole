    "Used by macOS itself. Usually rebuilt, but some services take a while." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird von macOS selbst verwendet. Wird meist neu erstellt, manche Dienste brauchen aber eine Weile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usa el propio macOS. Normalmente se reconstruye, aunque algunos servicios tardan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé par macOS lui-même. En général reconstruit, mais certains services prennent du temps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS खुद इसका उपयोग करता है। आमतौर पर फिर से बनता है, पर कुछ सेवाओं को समय लगता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato da macOS stesso. Di solito si ricrea, ma alcuni servizi impiegano un po’."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS自体が使用します。通常は再生成されますが、時間がかかるサービスもあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 자체가 사용합니다. 보통 다시 만들어지지만 일부 서비스는 시간이 걸립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt door macOS zelf gebruikt. Meestal opnieuw opgebouwd, maar bij sommige voorzieningen duurt dat even."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado pelo próprio macOS. Normalmente é recriado, mas alguns serviços demoram um pouco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används av macOS självt. Återskapas vanligtvis, men en del tjänster tar en stund."
          }

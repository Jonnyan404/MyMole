        }
      }
    },
    "Caches macOS manages and local Time Machine snapshots. Finder counts it as free; macOS removes it when space is needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches, die macOS verwaltet, und lokale Time Machine-Schnappschüsse. Der Finder zählt sie als frei; macOS entfernt sie, wenn Platz gebraucht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachés que gestiona macOS e instantáneas locales de Time Machine. El Finder lo cuenta como libre; macOS lo elimina cuando hace falta espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches gérés par macOS et instantanés Time Machine locaux. Le Finder les compte comme libres ; macOS les supprime quand de l’espace est nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS द्वारा प्रबंधित कैश और लोकल Time Machine स्नैपशॉट। Finder इसे खाली गिनता है; जगह की ज़रूरत होने पर macOS इसे हटा देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache gestite da macOS e istantanee locali di Time Machine. Il Finder le conta come spazio libero; macOS le rimuove quando serve spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが管理するキャッシュとTime Machineのローカルスナップショットです。Finderでは空き領域として数えられます。領域が必要になると、macOSが削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 관리하는 캐시와 로컬 Time Machine 스냅샷입니다. Finder는 이를 여유 공간으로 계산하며, 공간이 필요하면 macOS가 제거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches die macOS beheert en lokale Time Machine-momentopnamen. Finder telt dit als vrij; macOS verwijdert het wanneer er ruimte nodig is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches que o macOS gerencia e capturas locais do Time Machine. O Finder os conta como livres; o macOS os remove quando é preciso espaço."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachar som macOS hanterar och lokala Time Machine-ögonblicksbilder. Finder räknar det som ledigt. macOS tar bort det när utrymmet behövs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 管理的缓存和本地 Time Machine 快照。访达将其计为可用空间；需要空间时 macOS 会将其移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS管理的快取和本機時光機快照。Finder會將其計為可用空間；需要空間時，macOS會將其移除。"
          }
        }
      }
    },

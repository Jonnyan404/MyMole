    "Copies %@ and MyMole's version, to quote when asking for help. No file names or paths are included." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert %@ und die Version von MyMole, um sie bei einer Hilfeanfrage anzugeben. Es werden keine Dateinamen oder Pfade übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia %@ y la versión de MyMole, para citarlos al pedir ayuda. No se incluyen nombres de archivo ni rutas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie %@ et la version de MyMole, à citer pour demander de l’aide. Aucun nom de fichier ni chemin n’est inclus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मदद माँगते समय बताने के लिए %@ और MyMole का संस्करण कॉपी करता है। कोई फ़ाइल नाम या पथ शामिल नहीं होते।"

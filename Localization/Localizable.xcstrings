          }
        }
      }
    },
    "This folder wasn't fully scanned and may contain personal data. Check its location before moving it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner wurde nicht vollständig gescannt und kann persönliche Daten enthalten. Prüfe seinen Ort, bevor du ihn bewegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta carpeta no se analizó por completo y puede contener datos personales. Comprueba su ubicación antes de moverla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier n’a pas été entièrement analysé et peut contenir des données personnelles. Vérifiez son emplacement avant de le déplacer."
          }
        },
        "hi" : {
          "stringUnit" : {

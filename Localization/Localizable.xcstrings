    "Nothing that's compared moved by %@ or more between these two scans. Smaller changes, and files under %@, aren't compared one by one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts Verglichenes hat sich zwischen diesen beiden Scans um %@ oder mehr bewegt. Kleinere Änderungen und Dateien unter %@ werden nicht einzeln verglichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing that's compared moved by %1$@ or more between these two scans. Smaller changes, and files under %2$@, aren't compared one by one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de lo comparado cambió %@ o más entre estos dos análisis. Los cambios más pequeños, y los archivos de menos de %@, no se comparan uno a uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de ce qui est comparé n’a bougé de %@ ou plus entre ces deux analyses. Les plus petits changements, et les fichiers de moins de %@, ne sont pas comparés un par un."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन दो स्कैन के बीच तुलना की गई कोई चीज़ %@ या उससे ज़्यादा नहीं बदली। छोटे बदलाव, और %@ से छोटी फ़ाइलें, एक-एक करके तुलना नहीं की जातीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla di ciò che viene confrontato è cambiato di %@ o più tra queste due scansioni. Le variazioni più piccole e i file sotto %@ non vengono confrontati uno per uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この2つのスキャンの間に、比較できる範囲で%@以上変化したものはありません。これより小さい変化と、%@未満のファイルは個別には比較されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 스캔 사이에 비교 대상 중 %@ 이상 변한 것이 없습니다. 더 작은 변경 사항과 %@ 미만 파일은 하나씩 비교하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets van wat wordt vergeleken, is tussen deze twee scans met %@ of meer veranderd. Kleinere wijzigingen en bestanden kleiner dan %@ worden niet een voor een vergeleken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada do que é comparado variou %@ ou mais entre estas duas análises. Alterações menores e arquivos com menos de %@ não são comparados um a um."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget av det som jämförs ändrades med minst %@ mellan de här två skanningarna. Mindre ändringar, och filer under %@, jämförs inte en och en."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两次扫描之间，参与比对的内容都没有 %1$@ 及以上的变化。更小的变化以及 %2$@ 以下的文件不会逐个比对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這兩次掃描之間，比較的內容都沒有%@或以上的變化。較小的變更和小於%@的檔案不會逐一比較。"
          }
        }
      }
    },

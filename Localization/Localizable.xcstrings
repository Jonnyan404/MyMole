    "Only reads; the disk is busier while it runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest nur; die Festplatte ist während der Ausführung stärker belastet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lee; el disco está más ocupado mientras se ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture seule ; le disque est plus occupé pendant l’opération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल पढ़ता है; चलते समय डिस्क ज़्यादा व्यस्त रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge soltanto; il disco è più impegnato durante l’esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取るだけです。実行中はディスクの負荷が高くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기만 합니다. 실행 중에는 디스크가 더 바빠집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest alleen; de schijf is drukker zolang dit bezig is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas lê; o disco fica mais ocupado durante a execução."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser bara. Skivan är mer upptagen medan det körs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读取；运行期间磁盘会更忙。"

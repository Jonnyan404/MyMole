            "value" : "Un dispositivo virtual con sus apps y datos. Android Studio puede crear uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un appareil virtuel avec ses apps et ses données. Android Studio peut en créer un nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने ऐप और डेटा के साथ एक वर्चुअल डिवाइस। Android Studio नया बना सकता है।"
          }
        },
        "ko" : {
          "stringUnit" : {

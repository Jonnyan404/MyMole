    "Not scanned before stopping. Scan Again to include this folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Stoppen nicht gescannt. Scanne erneut, um diesen Ordner einzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se analizó antes de detenerse. Vuelve a analizar para incluir esta carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non analysé avant l’arrêt. Relancez l’analyse pour inclure ce dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोकने से पहले स्कैन नहीं हुआ। इस फ़ोल्डर को शामिल करने के लिए फिर से स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non scansionata prima dell’interruzione. Usa “Scansiona di nuovo” per includere questa cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止前にスキャンされませんでした。このフォルダを含めるには、“もう一度スキャン”を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중지 전에 스캔되지 않았습니다. 이 폴더를 포함하려면 다시 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet gescand vóór het stoppen. Scan opnieuw om deze map mee te nemen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não analisada antes da interrupção. Use Analisar Novamente para incluir esta pasta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannades inte innan skanningen stoppades. Välj Skanna igen för att ta med mappen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止前未扫描。请再次扫描以包含此文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止前尚未掃描。請使用「再次掃描」來納入此檔案夾。"
          }
        }
      }
    },

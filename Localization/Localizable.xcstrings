    "Mozilla's shared folder. Other apps put their browser connections here too, so it stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsamer Ordner von Mozilla. Auch andere Apps legen hier ihre Browserverbindungen ab, daher bleibt er."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta compartida de Mozilla. Otras apps también guardan aquí sus conexiones con el navegador, así que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier partagé de Mozilla. D’autres apps y placent aussi leurs connexions au navigateur : il reste donc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozilla का साझा फ़ोल्डर। दूसरे ऐप भी अपने ब्राउज़र कनेक्शन यहाँ रखते हैं, इसलिए यह रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella condivisa di Mozilla. Anche altre app mettono qui le loro connessioni con il browser, quindi resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozillaの共有フォルダです。ほかのアプリもブラウザとの接続情報をここに置くため、残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozilla의 공유 폴더입니다. 다른 앱도 이곳에 브라우저 연결 정보를 두므로 남겨 둡니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedeelde map van Mozilla. Andere apps zetten hier ook hun browserverbindingen in, dus deze map blijft staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta compartilhada da Mozilla. Outros apps também colocam aqui suas conexões com o navegador, por isso fica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozillas delade mapp. Andra appar lägger också sina webbläsarkopplingar här, så den blir kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozilla 的共享文件夹。其他应用也会在此存放其浏览器连接，因此保留它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozilla的共用檔案夾。其他App也會將瀏覽器連線放在這裡，因此會留下。"
          }
        }
      }
    },

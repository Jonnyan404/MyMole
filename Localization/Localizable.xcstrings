    "In the selected files, or in all when none is selected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den ausgewählten Dateien oder in allen, wenn keine ausgewählt ist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los archivos seleccionados, o en todos si no hay ninguno seleccionado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les fichiers sélectionnés, ou dans tous si aucun n’est sélectionné"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित फ़ाइलों में, या कोई न चुनी हो तो सभी में"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei file selezionati, o in tutti se non ne è selezionato nessuno"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したファイルが対象です。何も選択していない場合はすべてのファイルが対象です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 파일에서, 선택한 파일이 없으면 모든 파일에서"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de geselecteerde bestanden, of in alle als er geen zijn geselecteerd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos arquivos selecionados, ou em todos quando nenhum está selecionado"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I de markerade filerna, eller i alla om ingen är markerad"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所选文件中；未选择时为全部"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用到所選取的檔案；若未選取則套用到全部"
          }
        }
      }
    },
    "In the selected visible groups, or all visible groups when none is selected: every picture but the one with the most pixels" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den ausgewählten sichtbaren Gruppen oder in allen sichtbaren Gruppen, wenn keine ausgewählt ist: jedes Bild außer dem mit den meisten Pixeln"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los grupos visibles seleccionados, o en todos los grupos visibles si no hay ninguno seleccionado: todas las imágenes menos la que tiene más píxeles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les groupes visibles sélectionnés, ou dans tous les groupes visibles si aucun n’est sélectionné : toutes les images sauf celle qui a le plus de pixels"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित दिखने वाले समूहों में, या कोई न चुना हो तो सभी दिखने वाले समूहों में: सबसे ज़्यादा पिक्सेल वाली को छोड़कर हर तस्वीर"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei gruppi visibili selezionati, o in tutti i gruppi visibili se non ne è selezionato nessuno: tutte le immagini tranne quella con più pixel"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した表示中のグループ（何も選択していない場合は表示中のすべてのグループ）で、ピクセル数が最も多い画像以外のすべての画像"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 표시 그룹에서, 선택한 그룹이 없으면 모든 표시 그룹에서: 픽셀이 가장 많은 사진을 제외한 모든 사진"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de geselecteerde zichtbare groepen, of in alle zichtbare groepen als er geen is geselecteerd: elke afbeelding behalve die met de meeste pixels"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos grupos visíveis selecionados, ou em todos os grupos visíveis quando nenhum está selecionado: todas as imagens menos a que tem mais pixels"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I de markerade synliga grupperna, eller i alla synliga grupper om ingen är markerad: alla bilder utom den med flest pixlar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已选的可见组中；未选择时为所有可见组：除像素最多的那张之外的所有照片"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用到選取的可見群組；若未選取則套用到所有可見群組：像素最多的圖片以外的每張圖片"
          }
        }
      }
    },

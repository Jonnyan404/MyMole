          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld पुनर्स्थापित; %lld वापस नहीं रखे जा सके। पहले जैसा करें उन्हें फिर से आज़माता है, या रद्दी में वापस रखें का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n1@; %#@n2@. “Annulla azione” ci riprova; in alternativa usa Ripristina nel Cestino."
          },
          "substitutions" : {
            "n1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Ripristinato %arg"

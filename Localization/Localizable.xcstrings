    "Named in your settings at %@. MyMole doesn't change these files; edit them yourself if needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deinen Einstellungen genannt unter %@. MyMole ändert diese Dateien nicht; bearbeite sie bei Bedarf selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencionado en tus ajustes en %@. MyMole no cambia estos archivos; edítalos tú si hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentionné dans vos réglages à %@. MyMole ne modifie pas ces fichiers ; modifiez-les vous-même si besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सेटिंग्ज़ में %@ पर नामित। MyMole इन फ़ाइलों को नहीं बदलता; ज़रूरत हो तो इन्हें खुद संपादित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citato nelle tue impostazioni in %@. MyMole non modifica questi file; modificali tu se necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にある設定に名前が記述されています。MyMoleはこれらのファイルを変更しません。必要に応じて自分で編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정의 %@에 언급되어 있습니다. MyMole은 이 파일을 변경하지 않으므로 필요하면 직접 편집하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt in je instellingen genoemd in %@. MyMole wijzigt deze bestanden niet; bewerk ze zo nodig zelf."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citado nos seus ajustes em %@. O MyMole não altera esses arquivos; edite-os você mesmo se necessário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämns i dina inställningar i %@. MyMole ändrar inte de här filerna. Redigera dem själv om det behövs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的设置中指定于 %1$@。MyMole 不会改动这些文件；如有需要请自行编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的設定中提及，位於%@。MyMole不會更改這些檔案；若有需要，請自行編輯。"
          }
        }
      }
    },

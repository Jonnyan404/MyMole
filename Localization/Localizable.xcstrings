      }
    },
    "The folders searched for installers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nach Installationsprogrammen durchsuchten Ordner"
          }
        },
        "es" : {

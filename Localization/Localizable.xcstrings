        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검토 후 앱이 변경되었습니다. 아무것도 이동되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app is gewijzigd nadat je die hebt bekeken. Er is niets verplaatst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app mudou após a revisão. Nada foi movido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen ändrades efter granskningen. Inget flyttades."

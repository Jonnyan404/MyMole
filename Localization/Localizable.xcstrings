    "Tagged %@; other copies are tagged differently. Choose which one stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Tag %@ versehen; andere Kopien haben andere Tags. Wähle, welche bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetado %@; las otras copias tienen otras etiquetas. Elige cuál se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiqueté %@ ; les autres copies ont d’autres étiquettes. Choisissez celle qui reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ टैग किया गया; अन्य कॉपियों के टैग अलग हैं। चुनें कि कौन-सी रहे।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그 %@이(가) 지정됨. 다른 사본에는 다른 태그가 있습니다. 남길 사본을 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已标记 %1$@；其他副本的标记不同。请选择保留哪一个。"
          }
        }
      }
    },
    "Tags differ" : {

    "Runs a few minutes in the background. Trimmed logs can't be put back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft einige Minuten im Hintergrund. Gekürzte Protokolle können nicht zurückgelegt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta unos minutos en segundo plano. Los registros recortados no se pueden recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne quelques minutes en arrière-plan. Les journaux réduits ne peuvent pas être restaurés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकग्राउंड में कुछ मिनट चलता है। छोटे किए लॉग वापस नहीं रखे जा सकते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede alcuni minuti in background. I log ridotti non possono essere ripristinati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドで数分間実行されます。切り詰められたログは元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드에서 몇 분 동안 실행됩니다. 줄어든 로그는 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duurt een paar minuten op de achtergrond. Ingekorte logbestanden kunnen niet worden teruggezet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É executado em segundo plano por alguns minutos. Os registros reduzidos não podem ser colocados de volta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körs några minuter i bakgrunden. Förkortade loggar kan inte läggas tillbaka."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台运行几分钟。被裁剪的日志无法恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背景執行幾分鐘。已修剪的記錄檔無法放回原位。"
          }
        }
      }
    },
    "Runs macOS's daily, weekly and monthly housekeeping scripts, which rotate and trim system logs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt die täglichen, wöchentlichen und monatlichen Wartungsskripte von macOS aus, die Systemprotokolle rotieren und kürzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta los scripts de mantenimiento diarios, semanales y mensuales de macOS, que rotan y recortan los registros del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance les scripts d’entretien quotidiens, hebdomadaires et mensuels de macOS, qui renouvellent et réduisent les journaux système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS की दैनिक, साप्ताहिक और मासिक रखरखाव स्क्रिप्ट चलाता है, जो सिस्टम लॉग रोटेट और छोटा करती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue gli script di manutenzione giornalieri, settimanali e mensili di macOS, che ruotano e riducono i log di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSの日次、週次、月次の定期保守スクリプトを実行し、システムログを入れ替えて切り詰めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 로그를 순환하고 줄이는 macOS의 일간, 주간, 월간 유지 관리 스크립트를 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voert de dagelijkse, wekelijkse en maandelijkse onderhoudsscripts van macOS uit, die systeemlogbestanden roteren en inkorten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa os scripts de manutenção diária, semanal e mensal do macOS, que fazem a rotação e a redução dos registros do sistema."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kör macOS dagliga, veckovisa och månatliga underhållsskript, som roterar och förkortar systemloggar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行 macOS 的每日、每周和每月维护脚本，这些脚本会轮转并裁剪系统日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

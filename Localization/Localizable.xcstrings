    "Changed since it was compared, so it isn't known to be the same any more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem Vergleich geändert, daher ist nicht mehr sicher, dass sie gleich ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambió desde que se comparó, así que ya no se sabe si es igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiée depuis la comparaison : on ne sait plus si elle est identique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुलना के बाद बदल गई, इसलिए अब पता नहीं कि यह वैसी ही है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

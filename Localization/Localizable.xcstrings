        }
      }
    },
    "Deep Clean, Projects, Installers, the disk map and app leftovers all work in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefenreinigung, Projekte, Installationsprogramme, die Festplattenkarte und App-Reste funktionieren alle darin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpieza profunda, Proyectos, Instaladores, el mapa del disco y los restos de apps funcionan ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nettoyage approfondi, les projets, les installeurs, la carte du disque et les restes d’apps y fonctionnent tous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गहरी सफ़ाई, प्रोजेक्ट, इंस्टॉलर, डिस्क मैप और ऐप के बचे हुए आइटम सभी इसमें काम करते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정밀 정리, 프로젝트, 설치 프로그램, 디스크 맵 및 앱 잔여 항목이 모두 여기서 작동합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度清理、项目、安装包、磁盘图和应用残留都在其中工作。"
          }
        }
      }
    },

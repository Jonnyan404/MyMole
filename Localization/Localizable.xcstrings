        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其磁碟無法製作APFS複製檔。只有APFS磁碟可以。"
          }
        }
      }
    },
    "Its job couldn't be stopped (launchctl %d), so it stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Job konnte nicht gestoppt werden (launchctl %d), daher bleibt es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo detener su tarea (launchctl %d), así que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa tâche n’a pas pu être arrêtée (launchctl %d), il reste donc en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका जॉब रोका नहीं जा सका (launchctl %d), इसलिए यह बना रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile interrompere la sua attività (launchctl %d), quindi resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブを停止できなかったため（launchctl %d）、残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업을 중지할 수 없어(launchctl %d) 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De taak ervan kon niet worden gestopt (launchctl %d), dus dit blijft staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível parar a tarefa dele (launchctl %d), por isso fica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess jobb kunde inte stoppas (launchctl %d), så det blir kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法停止它的任务（launchctl %d），因此予以保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法停止其工作（launchctl %d），因此會留下。"
          }
        }
      }
    },
    "Its job didn't stop in time, so it stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Job wurde nicht rechtzeitig beendet, daher bleibt es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su tarea no se detuvo a tiempo, así que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa tâche ne s’est pas arrêtée à temps, il reste donc en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका जॉब समय पर नहीं रुका, इसलिए यह बना रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua attività non si è interrotta in tempo, quindi resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブが時間内に停止しなかったため、残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업이 제시간에 중지되지 않아 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De taak ervan is niet op tijd gestopt, dus dit blijft staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tarefa dele não parou a tempo, por isso fica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess jobb stoppades inte i tid, så det blir kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的任务未能及时停止，因此予以保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其工作未及時停止，因此會留下。"
          }
        }
      }
    },
    "Its job isn't named after the app, so it stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Job ist nicht nach der App benannt, daher bleibt es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su tarea no lleva el nombre de la app, así que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa tâche ne porte pas le nom de l’app, il reste donc en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके जॉब का नाम ऐप के नाम पर नहीं है, इसलिए यह बना रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {

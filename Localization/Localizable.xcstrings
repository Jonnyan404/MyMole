          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håller lagringskartan och de senaste diagrammen redo och ritar om pågående skanningar fem gånger i sekunden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

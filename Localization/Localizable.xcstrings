    "Quietest. Two threads at the lowest priority, one scan at a time; scans take longest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am leisesten. Zwei Threads mit niedrigster Priorität, ein Scan nach dem anderen; Scans dauern am längsten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El más silencioso. Dos hilos con la prioridad más baja, un análisis a la vez; los análisis tardan más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus discret. Deux threads à la priorité la plus basse, une analyse à la fois ; les analyses sont les plus longues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे शांत। सबसे कम प्राथमिकता पर दो थ्रेड, एक बार में एक स्कैन; स्कैन सबसे लंबे समय लेते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il più silenzioso. Due thread con la priorità più bassa, una scansione alla volta; le scansioni sono le più lunghe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も静かです。最も低い優先順位の2スレッドで、一度に1件ずつスキャンします。スキャンに最も時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 조용함. 가장 낮은 우선순위의 스레드 2개, 한 번에 스캔 하나. 스캔이 가장 오래 걸립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het rustigst. Twee threads met de laagste prioriteit, één scan tegelijk; scans duren het langst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais discreto. Duas threads com a prioridade mais baixa, uma análise por vez; as análises demoram mais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tystast. Två trådar med lägsta prioritet, en skanning i taget. Skanningar tar längst tid."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最安静。两个最低优先级线程，一次只跑一个扫描；扫描耗时最长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最安靜。兩個最低優先順序的執行緒，一次一個掃描；掃描時間最長。"
          }
        }
      }
    },

          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法替换副本：%@。"
          }
        }
      }
    },
    "The copy you keep is on %@, which can be disconnected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie, die du behältst, liegt auf %@, das getrennt werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia que conservas está en %@, que se puede desconectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie que vous gardez est sur %@, qui peut être déconnecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो कॉपी रखते हैं वह %@ पर है, जिसे डिस्कनेक्ट किया जा सकता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관하는 사본이 연결을 해제할 수 있는 %@에 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你保留的副本位于 %1$@ 上，该位置可能会断开连接。"
          }
        }
      }
    },
    "The copy's dates, permissions and tags couldn't be given to the clone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datum, Rechte und Tags der Kopie konnten nicht auf den Klon übertragen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron pasar al clon las fechas, permisos y etiquetas de la copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dates, autorisations et tags de la copie n’ont pas pu être donnés au clone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रति की तिथियाँ, अनुमतियाँ और टैग क्लोन को नहीं दिए जा सके।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본의 날짜, 권한, 태그를 클론에 적용할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法把副本的日期、权限和标签赋予克隆。"
          }
        }
      }
    },
    "The destination could not accept the app (POSIX %d). %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel konnte die App nicht aufnehmen (POSIX %d). %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The destination could not accept the app (POSIX %1$d). %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino no pudo aceptar la app (POSIX %d). %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destination n’a pas pu accepter l’app (POSIX %d). %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गंतव्य ऐप स्वीकार नहीं कर सका (POSIX %d)। %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 위치가 앱을 받을 수 없었습니다(POSIX %d). %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标位置无法接收该应用（POSIX %d）。%@"
          }
        }
      }
    },
    "The destination is occupied. Nothing was overwritten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel ist belegt. Nichts wurde überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino está ocupado. No se sobrescribió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destination est occupée. Rien n’a été écrasé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गंतव्य भरा हुआ है। कुछ भी अधिलेखित नहीं हुआ।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 위치가 이미 사용 중입니다. 아무것도 덮어쓰지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标位置已被占用。没有覆盖任何内容。"
          }
        }
      }
    },
    "The disk image file couldn't be found." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Image-Datei wurde nicht gefunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró el archivo de la imagen de disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de l’image disque est introuvable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क इमेज फ़ाइल नहीं मिली।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 이미지 파일을 찾을 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到该磁盘映像文件。"
          }
        }
      }
    },
    "The disk image is ejected, then moved to the Trash. You can undo right after." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Image wird ausgeworfen und dann in den Papierkorb gelegt. Du kannst direkt danach widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de disco se expulsa y luego se traslada a la Papelera. Puedes deshacer justo después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image disque est éjectée, puis placée dans la Corbeille. Vous pouvez annuler juste après."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क इमेज इजेक्ट होती है, फिर ट्रैश में ले जाई जाती है। आप तुरंत बाद पहले जैसा कर सकते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 이미지를 추출한 다음 휴지통으로 이동합니다. 바로 실행 취소할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会先推出磁盘映像，再移到废纸篓。你可以随后立即撤销。"
          }
        }
      }
    },
    "The disk, memory and what the scans found at a glance. MyMole keeps running there when its window is closed; Quit ends it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festplatte, Arbeitsspeicher und Scanfunde auf einen Blick. MyMole läuft dort weiter, wenn sein Fenster geschlossen ist; „Beenden“ beendet es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco, la memoria y lo que encontraron los análisis de un vistazo. MyMole sigue funcionando ahí cuando su ventana está cerrada; Salir lo cierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque, la mémoire et ce que les analyses ont trouvé d’un coup d’œil. MyMole continue d’y tourner quand sa fenêtre est fermée ; Quitter l’arrête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क, मेमोरी और स्कैन में मिली चीज़ें एक नज़र में। विंडो बंद होने पर भी MyMole वहाँ चलता रहता है; बंद करें इसे समाप्त करता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크, 메모리 및 스캔 결과를 한눈에 볼 수 있습니다. 윈도우를 닫아도 MyMole은 그곳에서 계속 실행되며, 종료하면 끝납니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一眼看到磁盘、内存和扫描发现。关闭窗口后 MyMole 仍会在菜单栏运行；选择“退出”才会结束。"
          }
        }
      }
    },
    "The docker command's own settings, contexts and sign-ins. Docker installed another way uses it too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eigenen Einstellungen, Kontexte und Anmeldungen des docker-Befehls. Auf andere Weise installiertes Docker verwendet sie auch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes, contextos y sesiones propios del comando docker. Docker instalado de otra forma también lo usa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages, contextes et connexions propres à la commande docker. Docker installé autrement l’utilise aussi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "docker कमांड की अपनी सेटिंग्ज़, कॉन्टेक्स्ट और साइन-इन। दूसरे तरीके से इंस्टॉल Docker भी इसका उपयोग करता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "docker 명령 자체의 설정, 컨텍스트 및 로그인 정보입니다. 다른 방법으로 설치한 Docker도 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "docker 命令自身的设置、上下文和登录信息。以其他方式安装的 Docker 也会使用它。"
          }
        }
      }
    },
    "The emulator is running it. Close the emulator first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Emulator führt es aus. Schließe zuerst den Emulator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El emulador lo está usando. Cierra primero el emulador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’émulateur l’utilise. Fermez d’abord l’émulateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एमुलेटर इसे चला रहा है। पहले एमुलेटर बंद करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에뮬레이터가 실행 중입니다. 먼저 에뮬레이터를 닫으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟器正在运行它。请先关闭模拟器。"
          }
        }
      }
    },
    "The file has other names (hard links), which would no longer be the same file." : {
      "localizations" : {
        "de" : {

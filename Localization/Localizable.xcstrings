        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ajuste del Finder; a partir de entonces, las vistas de carpetas del Finder en esas unidades no se recuerdan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un réglage du Finder ; les présentations des dossiers du Finder sur ces disques ne sont plus mémorisées ensuite."

    "Few threads at low priority, one scan at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenige Threads mit niedriger Priorität, ein Scan nach dem anderen."
          }
        },
        "es" : {

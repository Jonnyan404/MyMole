          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시동 디스크의 파일 시스템 오류를 확인합니다. 읽기 전용이며 아무것도 변경되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

            "state" : "translated",
            "value" : "디스크가 거의 찼을 때"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘将满时"
          }
        }
      }
    },
    "Where your space went" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {

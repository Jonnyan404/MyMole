          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dockerコマンド自身の設定、コンテキスト、サインイン情報です。別の方法でインストールしたDockerも使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {

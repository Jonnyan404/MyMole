    "Excluded from cleanup, including everything inside. They stay even when a parent is chosen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Bereinigung ausgeschlossen, samt allem Inhalt. Sie bleiben, auch wenn ein übergeordnetes Objekt ausgewählt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluidas de la limpieza, con todo su contenido. Se quedan aunque se elija una carpeta superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclus du nettoyage, y compris tout leur contenu. Ils restent même quand un parent est choisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफ़ाई से बाहर, अंदर की हर चीज़ समेत। पैरेंट चुने जाने पर भी ये बने रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esclusi dalla pulizia, compreso tutto ciò che contengono. Restano anche quando viene scelto un elemento superiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その中のすべてのものを含めて、クリーンアップから除外されます。親項目が対象になっていても残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내용 전체를 포함해 정리에서 제외됩니다. 상위 항목을 선택해도 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgesloten van opruiming, inclusief alles erin. Ze blijven staan, ook wanneer een bovenliggende map is gekozen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora da limpeza, incluindo tudo o que está dentro. Ficam mesmo quando um item superior é escolhido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undantas från rensning, inklusive allt inuti. De blir kvar även när en överordnad mapp väljs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已排除在清理之外，包括其中的所有内容。即使选中上层文件夹，它们也会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排除在清理之外，包括其中的所有內容。即使選擇了上層項目，這些內容也會留下。"
          }
        }
      }
    },

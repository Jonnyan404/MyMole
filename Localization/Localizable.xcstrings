    "Removing this item can reset settings or remove local app data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Entfernen dieses Objekts kann Einstellungen zurücksetzen oder lokale App-Daten entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar este elemento puede restablecer ajustes o eliminar datos locales de apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer cet élément peut réinitialiser des réglages ou supprimer des données locales d’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस आइटम को हटाने से सेटिंग्ज़ रीसेट हो सकती हैं या लोकल ऐप डेटा हट सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rimozione di questo elemento può reimpostare le impostazioni o rimuovere i dati locali dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この項目を削除すると、設定がリセットされたり、アプリのローカルデータが削除されたりすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목을 제거하면 설정이 재설정되거나 로컬 앱 데이터가 제거될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je dit onderdeel verwijdert, kunnen instellingen opnieuw worden ingesteld of lokale appgegevens worden verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover este item pode redefinir ajustes ou remover dados locais do app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ta bort det här objektet kan nollställa inställningar eller ta bort lokala appdata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除此项目可能会重置设置或删除本地应用数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除此項目可能會重置設定或移除本機App資料。"
          }
        }
      }
    },

    "%@ comes with its own uninstaller, which also removes parts MyMole can't see. Use it instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat ein eigenes Deinstallationsprogramm, das auch Teile entfernt, die MyMole nicht sehen kann. Verwende stattdessen dieses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ incluye su propio desinstalador, que también elimina partes que MyMole no ve. Úsalo en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est fourni avec son propre programme de désinstallation, qui supprime aussi des éléments que MyMole ne voit pas. Utilisez-le plutôt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के साथ अपना अनइंस्टॉलर आता है, जो वे हिस्से भी हटाता है जिन्हें MyMole नहीं देख सकता। इसके बजाय उसी का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha un proprio programma di disinstallazione, che rimuove anche parti che MyMole non può vedere. Usa quello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には専用のアンインストーラがあり、MyMoleから見えない部分も削除されます。そちらを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 자체 제거 프로그램이 있으며, MyMole이 볼 수 없는 부분도 제거합니다. 대신 그것을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft een eigen deïnstallatieprogramma, dat ook delen verwijdert die MyMole niet kan zien. Gebruik dat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vem com seu próprio desinstalador, que também remove partes que o MyMole não vê. Use-o em vez disso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har ett eget avinstallationsprogram, som även tar bort delar som MyMole inte kan se. Använd det i stället."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 自带卸载程序，还能清除 MyMole 看不到的部分。请改用它的卸载程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」附有自己的解除安裝程式，該程式也會移除MyMole看不到的部分。請改用該程式。"
          }
        }

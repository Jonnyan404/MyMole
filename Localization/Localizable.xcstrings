                    }
                  }
                }
              }
            }
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %#@n2@:\n%3$@\n\nTudo o que contém um repositório Git (exceto checkouts de pacotes inalterados), arquivos de chave, arquivos que o Git rastreia ou trabalho sem commit fica onde está. Você pode desfazer logo em seguida ou colocar os itens de volta a partir do Lixo mais tarde."
          },
          "substitutions" : {

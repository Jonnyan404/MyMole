        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein sicherer Ort, von dem es entfernt werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay un lugar seguro desde donde eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun emplacement sûr d’où le supprimer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे हटाने के लिए कोई सुरक्षित स्थान नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun posto sicuro da cui rimuoverlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除のための安全な場所がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제거할 안전한 위치가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen veilige plaats van waaruit het kan worden verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há um local seguro a partir do qual removê-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen säker plats att ta bort det från."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可以安全移除它的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可從中移除的安全位置。"
          }
        }
      }
    },
    "No simulator uses it. Xcode downloads it again when one needs it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Simulator verwendet es. Xcode lädt es erneut, wenn einer es braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún simulador lo usa. Xcode lo vuelve a descargar cuando uno lo necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun simulateur ne l’utilise. Xcode le retélécharge quand un simulateur en a besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई सिम्युलेटर इसका उपयोग नहीं करता। जब किसी को ज़रूरत होगी, Xcode इसे फिर से डाउनलोड करेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non lo usa nessun simulatore. Xcode lo scarica di nuovo quando a uno serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用しているシミュレータはありません。必要になると、Xcodeが再びダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하는 시뮬레이터가 없습니다. 필요할 때 Xcode가 다시 다운로드합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen simulator gebruikt deze runtime. Xcode downloadt die opnieuw wanneer er een nodig is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum simulador o usa. O Xcode o baixa novamente quando um precisar dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen simulator använder den. Xcode hämtar den igen när någon behöver den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有模拟器在使用它。需要时 Xcode 会重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有模擬器使用。有模擬器需要時，Xcode會再次下載。"
          }
        }
      }
    },
    "No two files of %@ or more in the searched folders have the same content." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine zwei Dateien ab %@ in den durchsuchten Ordnern haben denselben Inhalt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay dos archivos de %@ o más en las carpetas buscadas con el mismo contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun fichier de %@ ou plus dans les dossiers fouillés n’a le même contenu qu’un autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोजे गए फ़ोल्डरों में %@ या उससे बड़ी कोई दो फ़ाइलें एक जैसी सामग्री वाली नहीं हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle cartelle di ricerca non ci sono due file da %@ o più con lo stesso contenuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索したフォルダに、内容が同じ%@以上のファイルはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색한 폴더에서 %@ 이상 파일 중 내용이 같은 파일이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen twee bestanden van %@ of meer in de doorzochte mappen hebben dezelfde inhoud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há dois arquivos de %@ ou mais com o mesmo conteúdo nas pastas da busca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga två filer på minst %@ i de genomsökta mapparna har samma innehåll."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索的文件夹中没有两个 %1$@ 及以上的文件内容相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋的檔案夾中，沒有兩個%@或以上的檔案內容相同。"
          }
        }
      }
    },
    "No two pictures of 50 KB or more in the searched folders look the same." : {

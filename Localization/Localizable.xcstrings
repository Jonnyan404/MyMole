        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een hele computer met alles wat erin is geïnstalleerd. Verwijder die in %@, waar ook de momentopnamen ervan worden afgehandeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

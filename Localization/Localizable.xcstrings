    "%@ is open. Quit it first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在运行。请先退出。"
          }
        }
      }
    },
    "%@ is part of macOS, so it stays. Its caches and settings can be reset; its data is never offered." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 属于 macOS，因此保留。它的缓存和设置可以重置；它的数据永远不会被选中。"
          }
        }
      }
    },
    "%@ is part of macOS." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 属于 macOS。"
          }
        }
      }
    },
    "%@ isn't a disk image MyMole can move." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不是 MyMole 可以移动的磁盘映像。"

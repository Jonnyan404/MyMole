    "%@ Try again once it's done, or untick the system-wide leftovers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Versuche es erneut, wenn es fertig ist, oder entferne die Markierung bei den systemweiten Resten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vuelve a intentarlo cuando termine, o desmarca los restos de todo el sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Réessayez une fois l’opération terminée, ou décochez les restes à l’échelle du système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इसके पूरा होने पर फिर से कोशिश करें, या सिस्टम-व्यापी बचे हुए आइटम का चयन हटा दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Riprova al termine, oppure togli la spunta ai residui a livello di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 完了してからやり直すか、システム全体の残存ファイルのチェックを外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 작업이 끝난 후 다시 시도하거나 시스템 전체 잔여 항목의 선택을 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Probeer het opnieuw als dat klaar is, of vink de systeembrede restanten uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tente novamente quando terminar ou desmarque as sobras no nível do sistema."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Försök igen när det är klart, eller kryssa ur de systemgemensamma resterna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 等它完成后重试，或取消勾选系统级残留项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@完成後請再試一次，或取消勾選系統層級的殘留項目。"
          }
        }
      }
    },

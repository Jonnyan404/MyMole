        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 MB या उससे बड़ी फ़ाइलों की यह सूची सीमित करें। डिस्क मैप और आपके हटाने के चयन वही रहते हैं।"

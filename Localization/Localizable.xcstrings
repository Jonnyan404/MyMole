    "Downloaded again by the program that asks for it. When it was last read doesn't tell whether a program still needs it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird vom Programm, das es anfordert, erneut geladen. Wann es zuletzt gelesen wurde, sagt nicht, ob ein Programm es noch braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo vuelve a descargar el programa que lo pide. Cuándo se leyó por última vez no indica si un programa aún lo necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retéléchargé par le programme qui le demande. La date de dernière lecture ne dit pas si un programme en a encore besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो प्रोग्राम इसे माँगता है वह इसे फिर से डाउनलोड करता है। इसे आख़िरी बार कब पढ़ा गया, इससे यह पता नहीं चलता कि किसी प्रोग्राम को अब भी इसकी ज़रूरत है या नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene scaricato di nuovo dal programma che lo richiede. La data dell’ultima lettura non dice se un programma ne ha ancora bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求したプログラムが再びダウンロードします。最後に読み取られた日からは、プログラムがまだ必要としているかどうかはわかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하는 프로그램이 다시 다운로드합니다. 마지막으로 읽은 시점만으로는 프로그램이 아직 필요로 하는지 알 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt opnieuw gedownload door het programma dat erom vraagt. Wanneer het voor het laatst is gelezen, zegt niet of een programma het nog nodig heeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixado novamente pelo programa que o pedir. A data da última leitura não diz se um programa ainda precisa dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämtas igen av programmet som ber om den. När den senast lästes säger inte om ett program fortfarande behöver den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要它的程序会重新下载。上次读取的时间并不能说明程序是否仍需要它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由要求它的程式再次下載。上次讀取的時間無法得知是否仍有程式需要它。"
          }
        }
      }
    },
    "Downloaded again with ollama pull. Its own layers go with it; layers other models use stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit ollama pull erneut ladbar. Seine eigenen Schichten gehen mit; Schichten, die andere Modelle nutzen, bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuelve a descargar con ollama pull. Sus propias capas se van con él; las capas que usan otros modelos se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se retélécharge avec ollama pull. Ses propres couches partent avec lui ; les couches utilisées par d’autres modèles restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ollama pull से फिर से डाउनलोड होता है। इसकी अपनी लेयर इसके साथ जाती हैं; दूसरे मॉडल जिन लेयर का उपयोग करते हैं वे रहती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si scarica di nuovo con ollama pull. I livelli che appartengono solo al modello se ne vanno con lui; quelli usati da altri modelli restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ollama pullで再びダウンロードされます。このモデル独自のレイヤーも一緒になくなり、ほかのモデルが使うレイヤーは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ollama pull로 다시 다운로드할 수 있습니다. 이 모델만의 레이어는 함께 이동하고, 다른 모델이 쓰는 레이어는 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt opnieuw gedownload met ollama pull. De eigen lagen gaan mee; lagen die andere modellen gebruiken, blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixado novamente com ollama pull. As camadas que são só dele vão junto; as camadas usadas por outros modelos ficam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämtas igen med ollama pull. Dess egna lager följer med. Lager som andra modeller använder blir kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用 ollama pull 重新下载。它自己的层会一起移走；其他模型使用的层会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可使用ollama pull再次下載。其專屬的層會隨之移除；其他模型使用的層會留下。"
          }
        }
      }
    },

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリまたはその保護の状態が変わりました。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 또는 보호 규칙이 변경되었습니다. %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app of de bescherming ervan is gewijzigd. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app ou suas proteções mudaram. %@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen eller dess skydd har ändrats. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用或其保护规则发生了变化。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App或其保護已更改。%@"
          }
        }
      }
    },
    "The app or one of its background processes is still running. Nothing was moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App oder einer ihrer Hintergrundprozesse läuft noch. Nichts wurde bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app o uno de sus procesos en segundo plano sigue en ejecución. No se movió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ou l’un de ses processus d’arrière-plan est encore en cours. Rien n’a été déplacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप या इसका कोई बैकग्राउंड प्रोसेस अभी चल रहा है। कुछ नहीं ले जाया गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app o uno dei suoi processi in background è ancora in esecuzione. Non è stato spostato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリまたはそのバックグラウンドプロセスがまだ実行中です。何も移動されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 또는 백그라운드 프로세스 중 하나가 아직 실행 중입니다. 아무것도 이동되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app of een van de achtergrondprocessen ervan is nog actief. Er is niets verplaatst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app ou um dos seus processos em segundo plano ainda está em execução. Nada foi movido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen eller en av dess bakgrundsprocesser körs fortfarande. Inget flyttades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用或其某个后台进程仍在运行。没有移动任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App或其中一個背景程序仍在執行中。未搬移任何項目。"
          }
        }
      }
    },
    "The app restarted or its protections changed. Nothing was moved. If its background agents were stopped, reopening the app restores them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wurde neu gestartet oder ihre Schutzregeln haben sich geändert. Nichts wurde bewegt. Wurden ihre Hintergrund-Agents gestoppt, stellt ein erneutes Öffnen der App sie wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se reinició o sus protecciones cambiaron. No se movió nada. Si se detuvieron sus agentes en segundo plano, volver a abrir la app los restaura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a redémarré ou ses protections ont changé. Rien n’a été déplacé. Si ses agents d’arrière-plan ont été arrêtés, rouvrir l’app les rétablit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप फिर से शुरू हुआ या इसकी सुरक्षाएँ बदल गईं। कुछ नहीं ले जाया गया। अगर इसके बैकग्राउंड एजेंट रोके गए थे, तो ऐप फिर से खोलने पर वे बहाल हो जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app si è riavviata o le sue protezioni sono cambiate. Non è stato spostato nulla. Se i suoi agenti in background sono stati interrotti, riaprendo l’app vengono ripristinati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが再起動したか、保護の状態が変わりました。何も移動されていません。バックグラウンドエージェントが停止された場合は、アプリを再度開くと元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 다시 시작되었거나 보호 규칙이 변경되었습니다. 아무것도 이동되지 않았습니다. 백그라운드 에이전트가 중지되었다면 앱을 다시 열면 복원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app is opnieuw gestart of de bescherming is gewijzigd. Er is niets verplaatst. Als de achtergrondagents zijn gestopt, komen ze terug wanneer je de app opnieuw opent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app foi reaberto ou suas proteções mudaram. Nada foi movido. Se os agentes em segundo plano dele foram parados, reabrir o app os restaura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen startade om eller så ändrades dess skydd. Inget flyttades. Om dess bakgrundsagenter stoppades återställs de när appen öppnas igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用已重新启动，或其保护规则发生了变化。没有移动任何内容。如果它的自启动项已被停止，重新打开该应用即可恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App已重新啟動，或其保護已更改。未搬移任何項目。若其背景代理程式已停止，重新打開App即可恢復。"
          }
        }
      }
    },
    "The app restore could not be verified." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wiederherstellen der App konnte nicht geprüft werden."

    "System-wide cache. Rebuilt by the service that made it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemweiter Cache. Wird von dem Dienst neu erstellt, der ihn angelegt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché de todo el sistema. La reconstruye el servicio que la creó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache à l’échelle du système. Reconstruit par le service qui l’a créé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम-व्यापी कैश। इसे बनाने वाली सेवा इसे फिर से बनाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache a livello di sistema. Ricreata dal servizio che l’ha creata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム全体のキャッシュです。作成元のサービスが再生成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 전체 캐시입니다. 이를 만든 서비스가 다시 만듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeembrede cache. Wordt opnieuw opgebouwd door de voorziening die deze heeft gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache de todo o sistema. Recriado pelo serviço que o criou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemgemensam cache. Återskapas av tjänsten som skapade den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统级缓存。由生成它的服务重新生成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統層級的快取。由產生它的服務重建。"
          }
        }
      }
    },

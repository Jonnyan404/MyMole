    "Cache inside the app's sandbox. Rebuilt the next time the app needs it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache in der Sandbox der App. Wird neu erstellt, wenn die App ihn das nächste Mal braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché dentro del entorno aislado de la app. Se reconstruye la próxima vez que la app la necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache dans le bac à sable de l’app. Reconstruit la prochaine fois que l’app en a besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के सैंडबॉक्स के अंदर का कैश। अगली बार ऐप को ज़रूरत होने पर फिर से बनता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 샌드박스 안의 캐시입니다. 앱이 다음에 필요할 때 다시 만들어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用沙盒内的缓存。应用下次需要时会重新生成。"
          }
        }
      }
    },
    "Cache kept in the app's own data folder. The app rebuilds it; quit the app first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache im eigenen Datenordner der App. Die App erstellt ihn neu; beende die App zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché guardada en la carpeta de datos de la app. La app la reconstruye; ciérrala primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache gardé dans le dossier de données de l’app. L’app le reconstruit ; quittez-la d’abord."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के अपने डेटा फ़ोल्डर में रखा कैश। ऐप इसे फिर से बनाता है; पहले ऐप बंद करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 자체 데이터 폴더에 있는 캐시입니다. 앱이 다시 만들므로 먼저 앱을 종료하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存在应用自身数据文件夹中的缓存。应用会重新生成；请先退出该应用。"
          }
        }
      }
    },

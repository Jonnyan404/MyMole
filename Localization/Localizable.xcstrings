                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Minute"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Minuten"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "It has used a whole core for %arg minute or more, and may be stuck. Look at it in Live Status, or quit it if you don't need it."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "It has used a whole core for %arg minutes or more, and may be stuck. Look at it in Live Status, or quit it if you don't need it."
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha usado un núcleo entero durante %#@arg1@ o más, y puede que esté bloqueado. Míralo en Estado en vivo, o ciérralo si no lo necesitas."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg minuto"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg minutos"
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a occupé un cœur entier pendant %#@arg1@ ou plus, et est peut-être bloqué. Regardez-le dans État en direct, ou quittez-le si vous n’en avez pas besoin."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg minute"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg minutes"
                    }
                  }
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसने %lld मिनट या उससे अधिक एक पूरा कोर उपयोग किया है, और यह अटका हो सकता है। इसे लाइव स्थिति में देखें, या ज़रूरत न हो तो बंद करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld분 이상 코어 하나 전체를 사용했으며 멈춰 있을 수 있습니다. 실시간 상태에서 확인하거나 필요 없으면 종료하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已占满一个核心 %1$lld 分钟以上，可能卡住了。请在“实时状态”中查看，如果不需要就退出它。"
          }
        }
      }
    },
    "It isn't a scan saved from MyMole." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist kein mit MyMole gesicherter Scan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es un análisis guardado por MyMole."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas une analyse enregistrée par MyMole."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह MyMole से सहेजा गया स्कैन नहीं है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole에서 저장한 스캔이 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是 MyMole 保存的扫描。"
          }
        }
      }
    },
    "It left %@ of settings, caches and data in your Library. Click to look at them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hat %@ an Einstellungen, Caches und Daten in deiner Library hinterlassen. Klicke, um sie dir anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejó %@ de ajustes, cachés y datos en tu Biblioteca. Haz clic para verlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a laissé %@ de réglages, caches et données dans votre Bibliothèque. Cliquez pour les voir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसने आपकी लाइब्रेरी में %@ सेटिंग्ज़, कैश और डेटा छोड़ा है। देखने के लिए क्लिक करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리에 설정, 캐시 및 데이터 %@을(를) 남겼습니다. 클릭하여 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在你的“资源库”中留下了 %1$@ 的设置、缓存和数据。点按可查看。"
          }
        }
      }
    },
    "It printed more than %lld MB, so it was stopped and its output wasn't used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hat mehr als %lld MB ausgegeben, daher wurde es gestoppt und seine Ausgabe nicht verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprimió más de %lld MB, así que se detuvo y no se usó su salida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a affiché plus de %lld Mo, il a donc été arrêté et sa sortie n’a pas été utilisée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसने %lld MB से ज़्यादा प्रिंट किया, इसलिए इसे रोका गया और इसका आउटपुट उपयोग नहीं हुआ।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lldMB 넘게 출력하여 중지되었으며 출력은 사용되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输出超过 %lld MB，因此已停止，其输出未被采用。"
          }
        }
      }
    },
    "It starts in the menu bar, without a window, and scans when the Mac has time to spare." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es startet in der Menüleiste ohne Fenster und scannt, wenn der Mac Zeit hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inicia en la barra de menús, sin ventana, y analiza cuando el Mac tiene tiempo libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle démarre dans la barre des menus, sans fenêtre, et analyse quand le Mac a du temps libre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह बिना विंडो के मेनू बार में शुरू होता है, और Mac के खाली होने पर स्कैन करता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 없이 메뉴 막대에서 시작하며 Mac에 여유가 있을 때 스캔합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它从菜单栏启动，不打开窗口，并在 Mac 空闲时扫描。"
          }
        }
      }
    },
    "It stopped part-way, and what it had moved aside is still in %@, with a note of where each item came from. MyMole never deletes it by itself, and a new removal only deletes what it moves itself. Look at it in Finder; it needs an administrator to open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde unterwegs gestoppt, und was es beiseitegelegt hatte, liegt noch in %@, mit einem Vermerk, woher jedes Objekt kam. MyMole löscht es nie von selbst, und ein neues Entfernen löscht nur, was es selbst bewegt. Sieh es dir im Finder an; zum Öffnen ist ein Administrator nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo a mitad de camino, y lo que había apartado sigue en %@, con una nota de dónde venía cada elemento. MyMole nunca lo elimina por su cuenta, y una nueva eliminación solo borra lo que ella misma mueve. Míralo en el Finder; hace falta un administrador para abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s’est arrêtée en cours de route, et ce qu’elle avait mis de côté est toujours dans %@, avec une note indiquant d’où venait chaque élément. MyMole ne le supprime jamais de lui-même, et une nouvelle suppression n’efface que ce qu’elle déplace elle-même. Regardez-le dans le Finder ; il faut un administrateur pour l’ouvrir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह बीच में रुक गया, और जो इसने अलग रखा था वह अभी भी %@ में है, हर आइटम कहाँ से आया इसके नोट के साथ। MyMole इसे खुद कभी नहीं हटाता, और नया हटाना केवल वही हटाता है जिसे वह खुद ले जाता है। इसे Finder में देखें; खोलने के लिए एडमिनिस्ट्रेटर चाहिए।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중간에 중지되었으며 따로 옮겨 둔 항목은 각 항목의 원래 위치 기록과 함께 아직 %@에 있습니다. MyMole은 이를 스스로 삭제하지 않으며, 새 제거 작업은 자신이 이동한 것만 삭제합니다. Finder에서 확인하세요. 열려면 관리자가 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它中途停止，之前移到一旁的内容仍在 %1$@ 中，并附有每项的来源记录。MyMole 从不自行删除它，新的移除也只会删除自己移动的内容。请在访达中查看；打开它需要管理员权限。"
          }
        }
      }
    },
    "It was saved by a newer MyMole." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wurde mit einem neueren MyMole gesichert."

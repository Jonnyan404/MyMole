    "Tree opens several folder levels together. List shows one folder at a time. Filters show matching results as a list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Baum“ öffnet mehrere Ordnerebenen gemeinsam. „Liste“ zeigt einen Ordner nach dem anderen. Filter zeigen passende Ergebnisse als Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árbol abre varios niveles de carpetas a la vez. Lista muestra una carpeta cada vez. Los filtros muestran los resultados que coinciden como lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arborescence ouvre plusieurs niveaux de dossiers ensemble. Liste montre un dossier à la fois. Les filtres affichent les résultats correspondants sous forme de liste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्री कई फ़ोल्डर स्तर एक साथ खोलता है। सूची एक बार में एक फ़ोल्डर दिखाती है। फ़िल्टर मेल खाते परिणाम सूची के रूप में दिखाते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리는 여러 폴더 단계를 함께 엽니다. 목록은 한 번에 폴더 하나를 보여 줍니다. 필터는 일치하는 결과를 목록으로 보여 줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“树形”会同时展开多层文件夹。“列表”一次显示一个文件夹。使用筛选条件时以列表显示匹配结果。"
          }
        }
      }
    },
    "Treemap, two levels" : {

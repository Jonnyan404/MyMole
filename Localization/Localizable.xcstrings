    },
    "A virtual device with its apps and data. Android Studio can make a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein virtuelles Gerät mit seinen Apps und Daten. Android Studio kann ein neues erstellen."
          }
        },

    },
    "Tick every item listed here for the Trash. Nothing moves until you review and confirm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere jedes hier aufgeführte Objekt für den Papierkorb. Nichts wird bewegt, bis du prüfst und bestätigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca para la Papelera cada elemento de esta lista. No se mueve nada hasta que revises y confirmes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cochez chaque élément listé ici pour la Corbeille. Rien n’est déplacé tant que vous n’avez pas vérifié et confirmé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ सूचीबद्ध हर आइटम रद्दी के लिए चिह्नित करें। समीक्षा और पुष्टि तक कुछ नहीं ले जाया जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spunta ogni elemento elencato qui per il Cestino. Nulla viene spostato finché non rivedi e confermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに表示されているすべての項目にチェックを付けて、ゴミ箱の対象にします。確認して確定するまで何も移動されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 나열된 모든 항목을 휴지통용으로 체크합니다. 검토하고 확인하기 전에는 아무것도 이동되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vink elk onderdeel in deze lijst aan voor de prullenmand. Er wordt niets verplaatst totdat je dit bekijkt en bevestigt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca todos os itens listados aqui para o Lixo. Nada é movido até você revisar e confirmar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryssa för alla objekt i listan för papperskorgen. Inget flyttas förrän du granskar och bekräftar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选此处列出的所有项目以移到废纸篓。在你检查并确认之前不会移动任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾選這裡列出的每個項目，以便丟到垃圾桶。在你檢視並確認之前，不會搬移任何項目。"
          }
        }
      }
    },
    "Tick the highlighted rows for the Trash (⌘⌫). Select rows with a click, ⇧ or ⌘, or ⌘A for all." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere die hervorgehobenen Zeilen für den Papierkorb (⌘⌫). Wähle Zeilen mit einem Klick, ⇧ oder ⌘ aus, oder ⌘A für alle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca para la Papelera las filas resaltadas (⌘⌫). Selecciona filas con un clic, ⇧ o ⌘, o ⌘A para todas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cochez les lignes en surbrillance pour la Corbeille (⌘⌫). Sélectionnez des lignes avec un clic, ⇧ ou ⌘, ou ⌘A pour tout."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाइलाइट की गई पंक्तियाँ रद्दी के लिए चिह्नित करें (⌘⌫)। क्लिक, ⇧ या ⌘ से पंक्तियाँ चुनें, या सभी के लिए ⌘A।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spunta le righe evidenziate per il Cestino (⌘⌫). Seleziona le righe con un clic, ⇧ o ⌘, oppure tutte con ⌘A."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強調表示されている行にチェックを付けて、ゴミ箱の対象にします（⌘⌫）。行を選択するには、クリック、⇧、⌘を使います。⌘Aですべて選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강조된 행을 휴지통용으로 체크합니다(⌘⌫). 클릭, ⇧ 또는 ⌘로 행을 선택하고 ⌘A로 모두 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vink de gemarkeerde rijen aan voor de prullenmand (⌘⌫). Selecteer rijen met een klik, ⇧ of ⌘, of ⌘A voor alles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca as linhas destacadas para o Lixo (⌘⌫). Selecione linhas com um clique, ⇧ ou ⌘, ou ⌘A para todas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryssa för de markerade raderna för papperskorgen (⌘⌫). Markera rader genom att klicka, med ⇧ eller ⌘, eller med ⌘A för alla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选高亮行以移到废纸篓（⌘⌫）。点按、⇧ 或 ⌘ 可选择行，⌘A 全选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

    "Names can differ; the full contents must match. Select a group to compare its copies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen können sich unterscheiden; der gesamte Inhalt muss übereinstimmen. Wähle eine Gruppe aus, um ihre Kopien zu vergleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres pueden ser distintos; el contenido completo debe coincidir. Selecciona un grupo para comparar sus copias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms peuvent différer ; le contenu entier doit correspondre. Sélectionnez un groupe pour comparer ses copies."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाम अलग हो सकते हैं; पूरी सामग्री मेल खानी चाहिए। किसी समूह की कॉपियाँ तुलना करने के लिए उसे चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi possono essere diversi; l’intero contenuto deve coincidere. Seleziona un gruppo per confrontarne le copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前は異なってもかまいませんが、内容は完全に一致している必要があります。グループを選択すると、コピーを比較できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름은 다를 수 있지만 전체 내용은 같아야 합니다. 그룹을 선택해 사본을 비교하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen kunnen verschillen; de volledige inhoud moet overeenkomen. Selecteer een groep om de exemplaren te vergelijken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes podem diferir; todo o conteúdo deve coincidir. Selecione um grupo para comparar suas cópias."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namnen kan skilja sig åt, men hela innehållet måste stämma överens. Markera en grupp för att jämföra kopiorna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "No Quick Look, Spotlight, audio or other plug-ins are in your Library or the one for every user." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deiner Library und der für alle Benutzer sind keine Quick Look-, Spotlight-, Audio- oder anderen Plug-ins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay complementos de Vista Rápida, Spotlight, audio ni de otro tipo en tu Biblioteca ni en la de todos los usuarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun module Coup d’œil, Spotlight, audio ou autre n’est dans votre Bibliothèque ni dans celle de tous les utilisateurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी लाइब्रेरी या सभी उपयोगकर्ताओं वाली लाइब्रेरी में कोई Quick Look, Spotlight, ऑडियो या अन्य प्लग-इन नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella tua Libreria e in quella di tutti gli utenti non ci sono plugin di Visualizzazione rapida, Spotlight, audio o di altro tipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のライブラリと全ユーザ共通のライブラリに、クイックルック、Spotlight、オーディオなどのプラグインはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 라이브러리와 모든 사용자용 라이브러리에 훑어보기, Spotlight, 오디오 또는 기타 플러그인이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staan geen plug-ins voor Snelle weergave, Spotlight, audio of iets anders in je Bibliotheek of die voor alle gebruikers."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há plug-ins de Visualização Rápida, do Spotlight, de áudio ou outros na sua Biblioteca nem na de todos os usuários."

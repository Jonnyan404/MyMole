    "Instead of removing the chosen copies, each one becomes a clone of the copy that stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statt die ausgewählten Kopien zu entfernen, wird jede zu einem Klon der Kopie, die bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lugar de eliminar las copias elegidas, cada una pasa a ser un clon de la copia que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au lieu de supprimer les copies choisies, chacune devient un clone de la copie qui reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई प्रतियों को हटाने के बजाय, हर एक बनी रहने वाली प्रति का क्लोन बन जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invece di essere rimossa, ogni copia scelta diventa un clone della copia che resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象のコピーを削除する代わりに、それぞれを、残るコピーのクローンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 사본을 제거하는 대신 각각을 남는 사본의 클론으로 바꿉니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In plaats van dat de gekozen exemplaren worden verwijderd, wordt elk exemplaar een kloon van het exemplaar dat blijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em vez de remover as cópias escolhidas, cada uma se torna um clone da cópia que fica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I stället för att de valda kopiorna tas bort blir var och en en klon av kopian som blir kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不移除所选副本，而是让每个副本成为保留副本的克隆。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會移除選擇的副本，而是讓每個副本成為所留下副本的APFS複製檔。"
          }
        }
      }
    },

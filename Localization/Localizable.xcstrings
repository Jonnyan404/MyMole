    "Search by app name, ID, version or path. Choose a build folder to include apps missing from the system index." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach App-Name, ID, Version oder Pfad. Wähle einen Build-Ordner, um Apps einzuschließen, die im Systemindex fehlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca por nombre de app, ID, versión o ruta. Elige una carpeta de compilación para incluir apps que faltan en el índice del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez par nom d’app, identifiant, version ou chemin. Choisissez un dossier de compilation pour inclure les apps absentes de l’index du système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप नाम, ID, संस्करण या पथ से खोजें। सिस्टम इंडेक्स में न मौजूद ऐप शामिल करने के लिए बिल्ड फ़ोल्डर चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca per nome dell’app, ID, versione o percorso. Scegli una cartella di build per includere le app che mancano nell’indice di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ名、ID、バージョン、パスで検索します。システムの索引にないアプリを含めるには、ビルドフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 이름, ID, 버전 또는 경로로 검색하세요. 시스템 색인에 없는 앱을 포함하려면 빌드 폴더를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek op appnaam, ID, versie of pad. Kies een buildmap om apps mee te nemen die in de systeemindex ontbreken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque por nome, ID, versão ou caminho do app. Escolha uma pasta de compilações para incluir apps ausentes do índice do sistema."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sök på appnamn, ID, version eller sökväg. Välj en byggmapp för att ta med appar som saknas i systemets index."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按应用名称、ID、版本或路径搜索。可选择构建文件夹，以包含系统索引中缺失的应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依App名稱、識別碼、版本或路徑搜尋。選擇建置檔案夾來納入系統索引中沒有的App。"
          }
        }

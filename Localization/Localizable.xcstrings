          "stringUnit" : {
            "state" : "translated",
            "value" : "其Git設定可能會執行程式，因此未檢查。"
          }
        }
      }
    },
    "Its disk can't make clones. Only APFS disks can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Laufwerk kann keine Klone anlegen. Nur APFS-Laufwerke können das."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su disco no puede crear clones. Solo los discos APFS pueden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son disque ne peut pas créer de clones. Seuls les disques APFS le peuvent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी डिस्क क्लोन नहीं बना सकती। केवल APFS डिस्क बना सकती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo disco non può creare cloni. Possono farlo solo i dischi APFS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスクではクローンを作成できません。作成できるのはAPFSディスクだけです。"

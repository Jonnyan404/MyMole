    "One copy always stays. Unchoose another copy first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie bleibt immer. Hebe zuerst die Auswahl einer anderen Kopie auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre se queda una copia. Quita primero otra copia de la elección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie reste toujours. Retirez d’abord une autre copie du choix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक कॉपी हमेशा रहती है। पहले कोई दूसरी कॉपी का चयन हटाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {

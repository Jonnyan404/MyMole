      }
    },
    "Uses the newest change found in each project, not the last time you opened its app." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用每个项目中查到的最新变更时间，而不是你上次打开其应用的时间。"

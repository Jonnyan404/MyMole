    "Pinned for quick access. Pinning doesn't protect files or choose them for cleanup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für schnellen Zugriff angeheftet. Anheften schützt keine Dateien und wählt sie nicht zur Bereinigung aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijado para acceso rápido. Fijar no protege archivos ni los elige para limpiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épinglé pour un accès rapide. L’épinglage ne protège pas les fichiers et ne les choisit pas pour le nettoyage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जल्दी पहुँच के लिए पिन किया गया। पिन करना फ़ाइलों को सुरक्षित नहीं करता और सफ़ाई के लिए नहीं चुनता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissato per un accesso rapido. Fissare non protegge i file né li sceglie per la pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すばやくアクセスできるようにピン留めされています。ピン留めしても、ファイルが保護されたり、クリーンアップの対象になったりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 접근을 위해 고정됨. 고정은 파일을 보호하거나 정리 대상으로 선택하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgemaakt voor snelle toegang. Vastmaken beschermt geen bestanden en kiest ze niet voor opruiming."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixado para acesso rápido. Fixar não protege arquivos nem os escolhe para limpeza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fäst för snabb åtkomst. Det skyddar inte filer och väljer dem inte för rensning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已固定以便快速访问。固定既不会保护文件，也不会把它们选作清理对象。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釘選以便快速取用。釘選不會保護檔案，也不會選擇檔案來清理。"
          }
        }

    "Choose %@ to allow moving this app to the Trash. This file access is separate from App Management and Full Disk Access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle %@, um das Bewegen dieser App in den Papierkorb zu erlauben. Dieser Dateizugriff ist getrennt von App-Verwaltung und Festplattenvollzugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige %@ para permitir trasladar esta app a la Papelera. Este acceso a archivos es distinto de Gestión de las apps y del acceso total al disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez %@ pour autoriser le placement de cette app dans la Corbeille. Cet accès aux fichiers est distinct de Gestion des apps et de l’accès complet au disque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऐप को रद्दी में ले जाने की अनुमति के लिए %@ चुनें। यह फ़ाइल ऐक्सेस ऐप प्रबंधन और पूर्ण डिस्क ऐक्सेस से अलग है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli %@ per consentire di spostare questa app nel Cestino. Questo accesso ai file è separato da “Gestione app” e “Accesso completo al disco”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を選択して、このアプリをゴミ箱に入れることを許可してください。このファイルアクセスは、アプリ管理やフルディスクアクセスとは別のものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱을 휴지통으로 이동하도록 허용하려면 %@을(를) 선택하세요. 이 파일 접근 권한은 앱 관리 및 전체 디스크 접근 권한과 별개입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies %@ om toe te staan dat deze app naar de prullenmand wordt verplaatst. Deze bestandstoegang staat los van Appbeheer en Volledige schijftoegang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha %@ para permitir mover este app para o Lixo. Esse acesso ao arquivo é separado do Gerenciamento de Apps e do Acesso Total ao Disco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj %@ för att tillåta att appen flyttas till papperskorgen. Den här filåtkomsten är skild från Apphantering och Full skivtillgång."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 %1$@ 以允许将此应用移到废纸篓。此文件访问权限与“App管理”和“完全磁盘访问权限”分开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇%@，以允許將此App丟到垃圾桶。此檔案取用權限與「App管理」和「完全取用磁碟」是分開的。"
          }
        }
      }
    },

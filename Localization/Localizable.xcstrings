    "Map a folder you choose now. Folders macOS protects inside it stay closed and are listed as skipped; nothing else scans." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartiert jetzt einen Ordner deiner Wahl. Ordner darin, die macOS schützt, bleiben verschlossen und werden als übersprungen aufgeführt; sonst wird nichts gescannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapea ahora una carpeta que elijas. Las carpetas que macOS protege dentro de ella siguen cerradas y se listan como omitidas; no se analiza nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartographie maintenant un dossier de votre choix. Les dossiers que macOS protège à l’intérieur restent fermés et sont listés comme ignorés ; rien d’autre n’est analysé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी अपनी पसंद का एक फ़ोल्डर मैप करें। उसके अंदर macOS द्वारा सुरक्षित फ़ोल्डर बंद रहते हैं और छोड़े गए के रूप में सूचीबद्ध होते हैं; और कुछ स्कैन नहीं होता।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 선택한 폴더의 맵을 만듭니다. 그 안에서 macOS가 보호하는 폴더는 닫힌 채 건너뜀으로 표시되며, 다른 것은 스캔하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在为你选择的文件夹绘制磁盘图。其中受 macOS 保护的文件夹保持关闭并列为已跳过；不会扫描其他内容。"
          }
        }
      }
    },
    "Map another folder or disk (⌘O)" : {

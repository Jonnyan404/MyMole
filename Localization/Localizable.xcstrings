    },
    "%@ item%@. You can undo right after, and the space is freed when you empty the Trash." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ item%2$@. You can undo right after, and the space is freed when you empty the Trash."
          }
        }
      }
    },
    "%@ macOS lets App Store apps into the folders you choose, so choose %@ in the next window. MyMole remembers it; you can take it back in Settings.%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ macOS lets App Store apps into the folders you choose, so choose %2$@ in the next window. MyMole remembers it; you can take it back in Settings.%3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ macOS 只允许应用商店版访问你选择的文件夹，请在下一个窗口中选择 %2$@。MyMole 会记住这次选择，你可以随时在设置中收回。%3$@"
          }
        }
      }
    },
    "%@ not in the map" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不在磁盘图中"
          }
        }
      }

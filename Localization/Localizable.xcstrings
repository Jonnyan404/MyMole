    "Sizes come from the last scan. Running status updates live; Reload measures sizes again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größen stammen aus dem letzten Scan. Der Laufstatus wird live aktualisiert; „Neu laden“ misst die Größen erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tamaños vienen del último análisis. El estado de ejecución se actualiza en vivo; Volver a cargar mide de nuevo los tamaños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tailles viennent de la dernière analyse. L’état d’exécution se met à jour en direct ; Recharger mesure à nouveau les tailles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार पिछले स्कैन से हैं। चलने की स्थिति लाइव अपडेट होती है; फिर से लोड करें आकार दोबारा मापता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dimensioni provengono dall’ultima scansione. Lo stato di esecuzione si aggiorna in tempo reale; Ricarica misura di nuovo le dimensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズは前回のスキャンの値です。実行状況はリアルタイムに更新されます。“再読み込み”でサイズを計測し直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기는 마지막 스캔 기준입니다. 실행 상태는 실시간으로 업데이트되며, 다시 불러오기로 크기를 다시 측정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grootten komen uit de laatste scan. Of een app actief is, wordt live bijgewerkt; 'Laad opnieuw' meet de grootten opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tamanhos vêm da última análise. O status de execução é atualizado ao vivo; Recarregar mede os tamanhos novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storlekarna kommer från den senaste skanningen. Körstatusen uppdateras löpande. Uppdatera mäter storlekarna igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大小来自上次扫描。运行状态会实时更新；重新载入会重新测量大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大小來自上次掃描。執行狀態會即時更新；「重新載入」會再次測量大小。"
          }
        }
      }
    },

        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conteneur l’utilise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक कंटेनर इसका उपयोग करता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨테이너가 사용 중입니다."
          }

    "Part of a cache couldn't be read. The result isn't saved as complete; give MyMole Full Disk Access or scan again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil eines Caches konnte nicht gelesen werden. Das Ergebnis wird nicht als vollständig gesichert; gewähre MyMole Festplattenvollzugriff oder scanne erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer parte de una caché. El resultado no se guarda como completo; da a MyMole acceso total al disco o vuelve a analizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie d’un cache n’a pas pu être lue. Le résultat n’est pas enregistré comme complet ; donnez à MyMole l’accès complet au disque ou relancez l’analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैश का एक हिस्सा पढ़ा नहीं जा सका। परिणाम पूरा मानकर सहेजा नहीं गया; MyMole को पूर्ण डिस्क ऐक्सेस दें या फिर से स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere parte di una cache. Il risultato non viene salvato come completo; dai a MyMole “Accesso completo al disco” o ripeti la scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュの一部を読み取れませんでした。結果は完全なものとしては保存されません。MyMoleにフルディスクアクセスを許可するか、もう一度スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시 일부를 읽을 수 없었습니다. 결과가 완전한 것으로 저장되지 않으니 MyMole에 전체 디스크 접근 권한을 부여하거나 다시 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een deel van een cache kon niet worden gelezen. Het resultaat is niet als volledig bewaard; geef MyMole volledige schijftoegang of scan opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler parte de um cache. O resultado não é salvo como completo; dê ao MyMole o Acesso Total ao Disco ou analise novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En del av en cache kunde inte läsas. Resultatet sparas inte som fullständigt. Ge MyMole Full skivtillgång eller skanna igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分缓存无法读取。该结果不会保存为完整结果；请授予 MyMole“完全磁盘访问权限”或重新扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取部分快取。結果不會儲存為完整結果；請授予MyMole「完全取用磁碟」權限，或再次掃描。"
          }
        }
      }
    },

        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer algunas carpetas; los tamaños son como mínimo estos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains dossiers n’ont pas pu être lus ; les tailles sont au moins celles-ci"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ फ़ोल्डर पढ़े नहीं जा सके; आकार कम से कम इतने हैं"
          }
        },
        "ko" : {
          "stringUnit" : {

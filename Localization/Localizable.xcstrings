    "%@ runs from a disk image mounted at %@, and MyMole couldn't find the image file. Eject it in Finder, then move the image file to the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft von einem Image, das unter %@ aktiviert ist, und MyMole konnte die Image-Datei nicht finden. Wirf es im Finder aus und lege dann die Image-Datei in den Papierkorb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ runs from a disk image mounted at %2$@, and MyMole couldn't find the image file. Eject it in Finder, then move the image file to the Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ejecuta desde una imagen de disco montada en %@ y MyMole no encontró el archivo de la imagen. Expúlsala en el Finder y luego traslada el archivo de la imagen a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’exécute depuis une image disque montée sur %@, et MyMole n’a pas trouvé le fichier de l’image. Éjectez-la dans le Finder, puis placez le fichier de l’image dans la Corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ पर माउंट की गई डिस्क इमेज से चलता है, और MyMole इमेज फ़ाइल नहीं ढूँढ सका। इसे Finder में इजेक्ट करें, फिर इमेज फ़ाइल को रद्दी में ले जाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione da un’immagine disco montata in %@ e MyMole non è riuscito a trovare il file dell’immagine. Espellila nel Finder, poi sposta il file dell’immagine nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は%@にマウントされたディスクイメージから実行されていますが、MyMoleはイメージファイルを見つけられませんでした。Finderで取り出してから、イメージファイルをゴミ箱に入れてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) %2$@에 마운트된 디스크 이미지에서 실행되며 MyMole이 이미지 파일을 찾을 수 없었습니다. Finder에서 추출한 다음 이미지 파일을 휴지통으로 이동하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt uitgevoerd vanaf een schijfkopie die in %@ is geactiveerd, en MyMole kon het schijfkopiebestand niet vinden. Werp de schijfkopie in Finder uit en verplaats het bestand daarna naar de prullenmand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é executado a partir de uma imagem de disco montada em %@, e o MyMole não encontrou o arquivo da imagem. Ejete-a no Finder e depois mova o arquivo da imagem para o Lixo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ körs från en skivavbild som är monterad på %@, och MyMole kunde inte hitta avbildsfilen. Mata ut den i Finder och flytta sedan avbildsfilen till papperskorgen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 从挂载在 %2$@ 的磁盘映像运行，MyMole 找不到该映像文件。请在访达中推出它，再把映像文件移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」從裝載於%@的磁碟映像檔執行，而MyMole找不到映像檔的檔案。請在Finder中將其退出，然後將映像檔的檔案丟到垃圾桶。"
          }
        }
      }
    },
    "%@ runs from the disk image %@. An app can't be removed from a disk image: the image is ejected and its file moved to the Trash. A copy in Applications is uninstalled from the list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft vom Image %@. Eine App kann nicht aus einem Image entfernt werden: Das Image wird ausgeworfen und seine Datei in den Papierkorb gelegt. Eine Kopie in „Programme“ wird über die Liste deinstalliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ runs from the disk image %2$@. An app can't be removed from a disk image: the image is ejected and its file moved to the Trash. A copy in Applications is uninstalled from the list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ejecuta desde la imagen de disco %@. Una app no se puede eliminar de una imagen de disco: la imagen se expulsa y su archivo se traslada a la Papelera. Una copia en Aplicaciones se desinstala desde la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’exécute depuis l’image disque %@. Une app ne peut pas être supprimée d’une image disque : l’image est éjectée et son fichier placé dans la Corbeille. Une copie dans Applications se désinstalle depuis la liste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ डिस्क इमेज %2$@ से चलता है। डिस्क इमेज से ऐप नहीं हटाया जा सकता: इमेज इजेक्ट होती है और उसकी फ़ाइल रद्दी में जाती है। ऐप्लिकेशन में मौजूद कॉपी सूची से अनइंस्टॉल होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione dall’immagine disco %@. Un’app non può essere rimossa da un’immagine disco: l’immagine viene espulsa e il suo file spostato nel Cestino. Una copia in Applicazioni si disinstalla dall’elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はディスクイメージ%@から実行されています。ディスクイメージからアプリを削除することはできません。イメージを取り出し、そのファイルをゴミ箱に入れます。“アプリケーション”にあるコピーは、リストからアンインストールできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 디스크 이미지 %2$@에서 실행됩니다. 디스크 이미지에서는 앱을 제거할 수 없으므로 이미지를 추출하고 그 파일을 휴지통으로 이동합니다. 응용 프로그램에 있는 사본은 목록에서 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt uitgevoerd vanaf de schijfkopie %@. Een app kan niet van een schijfkopie worden verwijderd: de schijfkopie wordt uitgeworpen en het bestand ervan wordt naar de prullenmand verplaatst. Een exemplaar in Apps deïnstalleer je vanuit de lijst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é executado a partir da imagem de disco %@. Um app não pode ser removido de uma imagem de disco: a imagem é ejetada e o arquivo dela é movido para o Lixo. Uma cópia em Aplicativos é desinstalada pela lista."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ körs från skivavbilden %@. En app kan inte tas bort från en skivavbild: avbilden matas ut och dess fil flyttas till papperskorgen. En kopia i Appar avinstalleras från listan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 从磁盘映像 %2$@ 运行。应用无法从磁盘映像中移除：会推出该映像，并把映像文件移到废纸篓。若“应用程序”中有副本，则从列表中卸载该副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」從磁碟映像檔「%@」執行。無法從磁碟映像檔中移除App：會退出映像檔，並將其檔案丟到垃圾桶。「應用程式」中的副本請從列表解除安裝。"
          }
        }
      }
    },

    "Finds bursts, resized and re-saved copies of the same picture in Pictures, Desktop, Documents and Downloads. Pictures are only read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Serien, verkleinerte und erneut gesicherte Kopien desselben Bildes in „Bilder“, „Schreibtisch“, „Dokumente“ und „Downloads“. Bilder werden nur gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca ráfagas y copias redimensionadas o vueltas a guardar de la misma imagen en Imágenes, Escritorio, Documentos y Descargas. Las imágenes solo se leen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les rafales et les copies redimensionnées ou réenregistrées d’une même image dans Images, Bureau, Documents et Téléchargements. Les images sont seulement lues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तस्वीरें, डेस्कटॉप, दस्तावेज़ और डाउनलोड में एक ही तस्वीर के बर्स्ट, छोटे किए और दोबारा सहेजे संस्करण खोजता है। तस्वीरें केवल पढ़ी जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova raffiche e copie ridimensionate o salvate di nuovo della stessa immagine in Immagini, Scrivania, Documenti e Download. Le immagini vengono solo lette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピクチャ、デスクトップ、書類、ダウンロードの中から、連写した画像や、サイズを変更したり保存し直したりした同じ画像のコピーを見つけます。画像は読み取るだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그림, 데스크탑, 문서 및 다운로드에서 같은 사진의 연속 촬영, 크기 조절 및 다시 저장된 사본을 찾습니다. 사진은 읽기만 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vindt burst-opnamen en geschaalde of opnieuw bewaarde kopieën van dezelfde afbeelding in Afbeeldingen, Bureaublad, Documenten en Downloads. Afbeeldingen worden alleen gelezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra sequências e cópias redimensionadas ou salvas novamente da mesma imagem em Imagens, Mesa, Documentos e Downloads. As imagens são apenas lidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hittar bildserier samt storleksändrade och omsparade kopior av samma bild i mapparna Bilder, Skrivbord, Dokument och Hämtade filer. Bilderna läses bara."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“图片”“桌面”“文稿”和“下载”中查找同一张照片的连拍、缩放和另存副本。照片只被读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「圖片」、「桌面」、「文件」和「下載項目」中尋找連拍，以及同一張圖片調整大小或重新儲存的副本。圖片只會被讀取。"
          }
        }
      }
    },
    "Finds caches, logs and tool downloads that apps rebuild by themselves." : {

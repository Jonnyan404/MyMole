    "Everything the Mac has for scans you wait on, and many disk walks at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was der Mac hat, für Scans, auf die du wartest, und viele Festplattendurchläufe gleichzeitig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que tiene el Mac para los análisis que esperas, y muchos recorridos de disco a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que le Mac a pour les analyses que vous attendez, et de nombreux parcours de disque à la fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन स्कैन की आप प्रतीक्षा करते हैं उनके लिए Mac का सब कुछ, और एक साथ कई डिस्क वॉक।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che il Mac ha per le scansioni che attendi e molte esplorazioni del disco alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果待ちのスキャンにはMacの能力をすべて使い、多数のディスク走査を同時に行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기다리는 스캔에 Mac의 모든 자원을 사용하고 디스크 탐색을 여러 개 동시에 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt alles wat de Mac heeft voor scans waarop je wacht en doorloopt de schijf op veel plekken tegelijk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que o Mac tem para as análises que você aguarda e muitas varreduras do disco ao mesmo tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt datorn har för skanningar du väntar på, och många skivgenomgångar samtidigt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 的全部资源都用于你等待的扫描，同时进行多次磁盘遍历。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你等待中的掃描使用Mac的全部資源，並同時進行多項磁碟走訪。"
          }
        }
      }
    },

    "Package managers' download caches and simulator caches. The next install is slower once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download-Caches von Paketmanagern und Simulator-Caches. Die nächste Installation ist einmal langsamer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachés de descarga de los gestores de paquetes y cachés de simuladores. La próxima instalación es más lenta una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

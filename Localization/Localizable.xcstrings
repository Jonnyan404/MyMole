    "In the project folder" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在项目文件夹中"
          }
        }
      }
    },
    "In the selected files, or in all when none is selected" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所选文件中；未选择时为全部"
          }
        }
      }
    },
    "In the selected visible groups, or all visible groups when none is selected: every picture but the one with the most pixels" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已选的可见组中；未选择时为所有可见组：除像素最多的那张之外的所有照片"
          }
        }
      }
    },
    "In this map" : {

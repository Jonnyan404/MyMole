    "Changes the surfaces and the accent. Text and warning colours stay the system's." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Flächen und den Akzent. Text- und Warnfarben bleiben die des Systems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia las superficies y el color de acento. El texto y los colores de aviso siguen siendo los del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change les surfaces et la couleur d’accentuation. Le texte et les couleurs d’avertissement restent ceux du système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सतहों और एक्सेंट को बदलता है। टेक्स्ट और चेतावनी के रंग सिस्टम वाले ही रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia le superfici e il colore dei dettagli. I colori del testo e degli avvisi restano quelli del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景とアクセントを変更します。文字と警告の色はシステムのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표면과 강조 색상을 변경합니다. 텍스트와 경고 색상은 시스템 설정을 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigt de vlakken en het accent. Tekst en waarschuwingskleuren blijven die van het systeem."

    "Every copy in its group is chosen, so none is left to share with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Kopie ihrer Gruppe ist ausgewählt, also bleibt keine zum Teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las copias de su grupo están elegidas, así que no queda ninguna con la que compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les copies de son groupe sont choisies : il n’en reste aucune avec qui partager."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके समूह की हर प्रति चुनी गई है, इसलिए साझा करने के लिए कोई नहीं बची।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹의 모든 사본이 선택되어 공유할 사본이 남아 있지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其所在组的所有副本都已选中，没有可共享的副本。"
          }
        }
      }
    },
    "Every core for scans you wait on, and half of them for scans started ahead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Kerne für Scans, auf die du wartest, und die Hälfte davon für vorab gestartete Scans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los núcleos para los análisis que esperas, y la mitad para los iniciados por adelantado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les cœurs pour les analyses que vous attendez, et la moitié pour celles lancées à l’avance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",

    "Switch on the tasks you want. Check Tasks previews their effects; Optimize Now runs them after confirmation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die gewünschten Aufgaben. „Aufgaben prüfen“ zeigt ihre Auswirkungen vorab; „Jetzt optimieren“ führt sie nach Bestätigung aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa las tareas que quieras. Comprobar tareas muestra una vista previa de sus efectos; Optimizar ahora las ejecuta tras confirmarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les tâches voulues. Vérifier les tâches prévisualise leurs effets ; Optimiser maintenant les exécute après confirmation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो कार्य चाहिए उन्हें चालू करें। कार्य जाँचें उनके प्रभाव का पूर्वावलोकन दिखाता है; अभी ऑप्टिमाइज़ करें पुष्टि के बाद उन्हें चलाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva le attività che vuoi. “Verifica attività” mostra in anteprima i loro effetti; “Ottimizza ora” le esegue dopo una conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なタスクをオンにします。“タスクを確認”で結果をプレビューし、“今すぐ最適化”で確認のあと実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 작업을 켜세요. 작업 확인으로 효과를 미리 보고, 지금 최적화로 확인 후 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel de taken in die je wilt. 'Controleer taken' geeft een voorvertoning van hun effect; 'Optimaliseer nu' voert ze na bevestiging uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative as tarefas que desejar. Verificar Tarefas mostra uma prévia dos efeitos; Otimizar Agora as executa após confirmação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på de åtgärder du vill ha. Kontrollera åtgärder visar vad de skulle göra. Optimera nu kör dem efter bekräftelse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开你需要的任务。“检查任务”可预览它们的效果；“立即优化”会在确认后运行它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟你要的作業。「檢查作業」會預覽其效果；「立即最佳化」會在確認後執行。"
          }
        }
      }
    },
    "Synced with a cloud service. Removing it here removes it in the cloud and on your other devices too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Cloud-Dienst synchronisiert. Hier entfernen entfernt es auch in der Cloud und auf deinen anderen Geräten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizado con un servicio en la nube. Eliminarlo aquí lo elimina también en la nube y en tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisé avec un service cloud. Le supprimer ici le supprime aussi dans le cloud et sur vos autres appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक क्लाउड सेवा के साथ सिंक। इसे यहाँ हटाने से यह क्लाउड और आपके अन्य डिवाइस से भी हट जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizzato con un servizio cloud. Rimuovendolo qui si rimuove anche dal cloud e dagli altri tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドサービスと同期されています。ここで削除すると、クラウドとほかのデバイスからも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드 서비스와 동기화됩니다. 여기서 제거하면 클라우드와 다른 기기에서도 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesynchroniseerd met een cloudvoorziening. Als je dit hier verwijdert, wordt het ook in de cloud en van je andere apparaten verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizado com um serviço na nuvem. Removê-lo aqui também o remove da nuvem e dos seus outros dispositivos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseras med en molntjänst. Tas det bort här tas det även bort i molnet och på dina andra enheter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已与云服务同步。在这里移除也会从云端和你的其他设备上移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與雲端服務同步。在這裡移除也會從雲端和你的其他裝置移除。"
          }
        }
      }
    },

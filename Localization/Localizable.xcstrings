            "value" : "La caché de una herramienta. Algunas guardan descargas grandes, como modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache d’un outil. Certains contiennent de gros téléchargements, comme des modèles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी टूल का कैश। कुछ में मॉडल जैसे बड़े डाउनलोड होते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구의 캐시입니다. 일부는 모델 같은 큰 다운로드를 포함합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个工具的缓存。有些会存放大体积下载内容，例如模型。"
          }
        }
      }
    },
    "A virtual device uses it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein virtuelles Gerät verwendet es."

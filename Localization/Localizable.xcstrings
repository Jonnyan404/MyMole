    "Caches inside sandboxed apps' containers. Rebuilt the same way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches in den Containern von Sandbox-Apps. Werden genauso neu erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachés dentro de los contenedores de apps aisladas. Se reconstruyen igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches dans les conteneurs des apps en bac à sable. Reconstruits de la même façon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सैंडबॉक्स ऐप्स के कंटेनरों के अंदर कैश। उसी तरह फिर से बनते हैं।"
          }
        },
        "it" : {

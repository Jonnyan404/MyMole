    "Extra checkouts made by coding agents. Push anything you need, then run git worktree prune." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzliche Checkouts von Coding-Agents. Pushe, was du brauchst, und führe dann git worktree prune aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias de trabajo adicionales creadas por agentes de programación. Sube lo que necesites y luego ejecuta git worktree prune."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies de travail supplémentaires créées par des agents de code. Poussez ce dont vous avez besoin, puis lancez git worktree prune."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोडिंग एजेंट द्वारा बनाए अतिरिक्त चेकआउट। जो चाहिए उसे पुश करें, फिर git worktree prune चलाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkout aggiuntivi creati da agenti di programmazione. Esegui il push di ciò che ti serve, poi esegui git worktree prune."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーディングエージェントが作成した追加のチェックアウトです。必要なものをプッシュしてから、git worktree pruneを実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코딩 에이전트가 만든 추가 체크아웃입니다. 필요한 것을 푸시한 다음 git worktree prune을 실행하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra checkouts die door programmeeragents zijn gemaakt. Push alles wat je nodig hebt en voer daarna git worktree prune uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

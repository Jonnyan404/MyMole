    "Narrow the leftovers listed below by category. This does not run another search or change your removal choices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grenze die unten aufgeführten Reste nach Kategorie ein. Das startet keine weitere Suche und ändert deine Auswahl zum Entfernen nicht."

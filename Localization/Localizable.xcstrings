    "%@ isn't a disk image MyMole can move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein Image, das MyMole bewegen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una imagen de disco que MyMole pueda mover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas une image disque que MyMole peut déplacer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ऐसी डिस्क इमेज नहीं है जिसे MyMole ले जा सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un’immagine disco che MyMole può spostare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はMyMoleが移動できるディスクイメージではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) MyMole이 이동할 수 있는 디스크 이미지가 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen schijfkopie die MyMole kan verplaatsen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é uma imagem de disco que o MyMole possa mover."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är ingen skivavbild som MyMole kan flytta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

    "Moves settings files that can no longer be read to the Trash, so their apps start from defaults." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt Einstellungsdateien, die nicht mehr lesbar sind, in den Papierkorb, sodass ihre Apps mit Standardwerten starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada a la Papelera los archivos de ajustes que ya no se pueden leer, para que sus apps empiecen con los valores predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place dans la Corbeille les fichiers de réglages devenus illisibles, pour que leurs apps repartent des valeurs par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो सेटिंग्ज़ फ़ाइलें अब पढ़ी नहीं जा सकतीं उन्हें रद्दी में ले जाता है, ताकि उनके ऐप डिफ़ॉल्ट से शुरू हों।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta nel Cestino i file di impostazioni che non si possono più leggere, così le loro app ripartono dai valori di default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取れなくなった設定ファイルをゴミ箱に入れ、アプリをデフォルトの状態から始められるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 읽을 수 없는 설정 파일을 휴지통으로 이동하여 해당 앱이 기본값으로 시작하게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst instellingenbestanden die niet meer kunnen worden gelezen naar de prullenmand, zodat hun apps met de standaardinstellingen beginnen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move para o Lixo os arquivos de ajustes que não podem mais ser lidos, para que os apps deles comecem com os padrões."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningsfiler som inte längre går att läsa flyttas till papperskorgen, så att deras appar börjar från förvalen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把无法读取的设置文件移到废纸篓，让相应应用以默认设置启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將無法再讀取的設定檔丟到垃圾桶，讓其App從預設值開始。"
          }
        }
      }
    },
    "Moves window states apps saved over 30 days ago to the Trash. Those apps open with fresh windows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt Fensterzustände, die Apps vor über 30 Tagen gesichert haben, in den Papierkorb. Diese Apps öffnen sich mit neuen Fenstern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada a la Papelera los estados de ventana que las apps guardaron hace más de 30 días. Esas apps se abren con ventanas nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place dans la Corbeille les états de fenêtres que les apps ont enregistrés il y a plus de 30 jours. Ces apps s’ouvrent avec de nouvelles fenêtres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 दिन से पहले ऐप्स द्वारा सहेजी विंडो स्थितियाँ रद्दी में ले जाता है। वे ऐप नई विंडो के साथ खुलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta nel Cestino gli stati delle finestre salvati dalle app più di 30 giorni fa. Quelle app si aprono con finestre nuove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが30日以上前に保存したウインドウの状態をゴミ箱に入れます。それらのアプリは新しいウインドウで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 30일보다 오래전에 저장한 윈도우 상태를 휴지통으로 이동합니다. 해당 앱은 새 윈도우로 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst vensterstatussen die apps meer dan 30 dagen geleden hebben bewaard naar de prullenmand. Die apps openen met nieuwe vensters."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move para o Lixo os estados de janelas que os apps salvaram há mais de 30 dias. Esses apps abrem com janelas novas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fönsterlägen som appar sparade för mer än 30 dagar sedan flyttas till papperskorgen. De apparna öppnas med nya fönster."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把应用在 30 天前保存的窗口状态移到废纸篓。这些应用会以全新窗口打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將App在超過30天前儲存的視窗狀態丟到垃圾桶。這些App會以全新的視窗打開。"
          }
        }
      }
    },

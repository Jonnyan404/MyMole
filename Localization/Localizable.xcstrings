        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "docker 命令自身的设置、上下文和登录信息。以其他方式安装的 Docker 也会使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

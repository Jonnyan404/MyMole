    "In the folder every user of this Mac shares. Other users' copies of the app may still use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Ordner, den alle Benutzer dieses Mac teilen. Kopien der App anderer Benutzer verwenden ihn eventuell noch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la carpeta que comparten todos los usuarios de este Mac. Las copias de la app de otros usuarios aún pueden usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le dossier que partagent tous les utilisateurs de ce Mac. Les copies de l’app d’autres utilisateurs peuvent encore l’utiliser."
          }
        },
        "hi" : {
          "stringUnit" : {

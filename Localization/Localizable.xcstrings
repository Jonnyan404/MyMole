        }
      }
    },
    "Ownership of %@'s leftovers couldn't be verified. Untick them to move only the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zugehörigkeit der Reste von %@ konnte nicht geprüft werden. Entferne ihre Markierung, um nur die App zu bewegen."

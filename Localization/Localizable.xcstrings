          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade %@ arrastrándola, o haz clic en el + debajo de la lista de apps y selecciona esta copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

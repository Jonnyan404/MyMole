    "Stopped. What it changed inside itself goes with it; its volumes stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt. Was er in sich selbst geändert hat, geht mit ihm; seine Volumes bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido. Lo que cambió dentro de sí mismo se va con él; sus volúmenes se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté. Ce qu’il a modifié en lui-même part avec lui ; ses volumes restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोका गया। इसने अपने अंदर जो बदला वह इसके साथ जाता है; इसके वॉल्यूम बने रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrotto. Ciò che ha modificato al suo interno se ne va con lui; i suoi volumi restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止しています。中で変更した内容は一緒になくなります。ボリュームは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중지됨. 내부에서 변경한 내용은 함께 제거되며 볼륨은 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestopt. Wat in de container zelf is gewijzigd, gaat mee; de volumes ervan blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parado. O que ele mudou dentro de si vai junto com ele; os volumes dele ficam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppad. Det den har ändrat inuti sig själv följer med. Dess volymer blir kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停止。它在自身内部所做的改动会随之删除；它的卷会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停止。它在內部更改的內容會隨之移除；其卷宗會留下。"
          }
        }
      }
    },

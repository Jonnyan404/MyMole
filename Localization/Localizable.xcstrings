    "Tree opens several folder levels together. List shows one folder at a time. Filters show matching results as a list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Baum“ öffnet mehrere Ordnerebenen gemeinsam. „Liste“ zeigt einen Ordner nach dem anderen. Filter zeigen passende Ergebnisse als Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árbol abre varios niveles de carpetas a la vez. Lista muestra una carpeta cada vez. Los filtros muestran los resultados que coinciden como lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arborescence ouvre plusieurs niveaux de dossiers ensemble. Liste montre un dossier à la fois. Les filtres affichent les résultats correspondants sous forme de liste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्री कई फ़ोल्डर स्तर एक साथ खोलता है। सूची एक बार में एक फ़ोल्डर दिखाती है। फ़िल्टर मेल खाते परिणाम सूची के रूप में दिखाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albero apre insieme più livelli di cartelle. Elenco mostra una cartella alla volta. I filtri mostrano i risultati corrispondenti come elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ツリー”は複数の階層をまとめて開きます。“リスト”はフォルダを1つずつ表示します。フィルタすると、一致した結果がリストで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리는 여러 폴더 단계를 함께 엽니다. 목록은 한 번에 폴더 하나를 보여 줍니다. 필터는 일치하는 결과를 목록으로 보여 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Boom' opent meerdere mapniveaus tegelijk. 'Lijst' toont één map tegelijk. Filters tonen overeenkomende resultaten als lijst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árvore abre vários níveis de pastas ao mesmo tempo. Lista mostra uma pasta por vez. Os filtros mostram os resultados correspondentes em uma lista."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Träd öppnar flera mappnivåer samtidigt. Lista visar en mapp i taget. Filter visar matchande resultat som en lista."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“树形”会同时展开多层文件夹。“列表”一次显示一个文件夹。使用筛选条件时以列表显示匹配结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「樹狀結構」可同時打開多層檔案夾。「列表」一次顯示一個檔案夾。過濾後會以列表顯示相符的結果。"
          }
        }
      }
    },

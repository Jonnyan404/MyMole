    },
    "Avast's support says to use it: in Avast Security's menu choose Uninstall Avast Security. It also removes its protection, which runs as a system extension." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Avast-Support empfiehlt es: Wähle im Menü von Avast Security „Uninstall Avast Security“. Es entfernt auch den Schutz, der als Systemerweiterung läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El soporte de Avast recomienda usarlo: en el menú de Avast Security, elige Uninstall Avast Security. También elimina su protección, que funciona como extensión del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistance d'Avast recommande de l'utiliser : dans le menu d'Avast Security, choisissez Uninstall Avast Security. Il supprime aussi sa protection, qui fonctionne comme extension système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avast सपोर्ट इसे इस्तेमाल करने को कहता है: Avast Security के मेनू में Uninstall Avast Security चुनें। यह इसकी सुरक्षा भी हटाता है, जो सिस्टम एक्सटेंशन के रूप में चलती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistenza di Avast dice di usarlo: nel menu di Avast Security scegli Uninstall Avast Security. Rimuove anche la sua protezione, che funziona come estensione di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avastのサポートで案内されている方法です。Avast Securityのメニューで“Uninstall Avast Security”を選びます。システム機能拡張として動作する保護機能も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avast 지원팀은 이 방법을 권장합니다. Avast Security 메뉴에서 Uninstall Avast Security를 선택하세요. 시스템 확장 프로그램으로 실행되는 보호 기능도 함께 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgens support van Avast gebruik je dit: kies in het menu van Avast Security 'Uninstall Avast Security'. Hiermee wordt ook de beveiliging verwijderd, die als systeemextensie actief is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O suporte da Avast diz para usá-lo: no menu do Avast Security, escolha Uninstall Avast Security. Ele também remove a proteção, que é executada como extensão do sistema."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avasts support säger att du ska använda det: välj Uninstall Avast Security i menyn för Avast Security. Det tar även bort dess skydd, som körs som ett systemtillägg."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avast 支持建议使用它：在 Avast Security 的菜单中选择 Uninstall Avast Security。它还会移除以系统扩展运行的防护功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avast支援部門建議使用它：在Avast Security的選單中選擇Uninstall Avast Security。它也會移除其以系統延伸功能執行的防護。"
          }
        }
      }
    },

    "Battle.net's shared agent and setup files, which Blizzard's support says to remove after quitting Battle.net." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsame Agent- und Setup-Dateien von Battle.net, die laut Blizzard-Support nach dem Beenden von Battle.net entfernt werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos compartidos del agente y de instalación de Battle.net, que el soporte de Blizzard indica eliminar tras cerrar Battle.net."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers partagés de l’agent et d’installation de Battle.net, que l’assistance de Blizzard conseille de supprimer après avoir quitté Battle.net."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battle.net की साझा एजेंट और सेटअप फ़ाइलें, जिन्हें Blizzard सहायता Battle.net बंद करने के बाद हटाने को कहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agente condiviso e i file di installazione di Battle.net, che l’assistenza di Blizzard dice di rimuovere dopo essere usciti da Battle.net."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

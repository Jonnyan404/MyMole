    "Try All discovered apps or choose a folder containing your test builds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuche „Alle gefundenen Apps“ oder wähle einen Ordner mit deinen Test-Builds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba Todas las apps encontradas o elige una carpeta que contenga tus compilaciones de prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez Toutes les apps trouvées ou choisissez un dossier contenant vos versions de test."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी खोजे गए ऐप आज़माएँ या अपने टेस्ट बिल्ड वाला फ़ोल्डर चुनें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발견된 모든 앱을 시도하거나 테스트 빌드가 있는 폴더를 선택하세요."
          }
        },
        "zh-Hans" : {

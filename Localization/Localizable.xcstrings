    "%@ point into the app and stop working once it's gone. They take no space. The app's own settings may remove them; otherwise an administrator can, in Terminal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zeigen in die App und funktionieren nicht mehr, sobald sie weg ist. Sie belegen keinen Platz. Die Einstellungen der App können sie entfernen, sonst kann es ein Administrator im Terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ apuntan dentro de la app y dejan de funcionar cuando ya no está. No ocupan espacio. Los ajustes de la propia app pueden quitarlos; si no, puede hacerlo un administrador en Terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pointent dans l'app et cessent de fonctionner une fois qu'elle n'est plus là. Ils n'occupent pas d'espace. Les réglages de l'app peuvent les supprimer ; sinon, un administrateur peut le faire dans Terminal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ऐप के अंदर की ओर इशारा करते हैं और ऐप हटने पर काम करना बंद कर देते हैं। ये जगह नहीं लेते। ऐप की अपनी सेटिंग्स इन्हें हटा सकती हैं; नहीं तो कोई एडमिनिस्ट्रेटर Terminal में हटा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: puntano all’interno dell’app e smettono di funzionare quando non c’è più. Non occupano spazio. Le impostazioni dell’app stessa potrebbero rimuoverli; altrimenti può farlo un amministratore in Terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はアプリの中を指しており、アプリがなくなると動作しなくなります。領域は使いません。アプリ自身の設定で削除できることがあります。できない場合は、管理者がターミナルで削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 앱 안을 가리키며 앱이 없어지면 작동하지 않습니다. 공간을 차지하지 않습니다. 앱 자체 설정에서 제거할 수 있고, 그렇지 않으면 관리자가 터미널에서 제거할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwijzen naar de app en werken niet meer zodra die weg is. Ze nemen geen ruimte in. Mogelijk verwijderen de eigen instellingen van de app ze; anders kan een beheerder dat doen in Terminal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os links de comandos (%@) apontam para dentro do app e deixam de funcionar quando ele não existir mais. Não ocupam espaço. Os ajustes do próprio app podem removê-los; caso contrário, um administrador pode, no Terminal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pekar in i appen och slutar fungera när den är borta. De tar ingen plats. Appens egna inställningar kan ta bort dem. Annars kan en administratör göra det i Terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 指向应用内部，应用移除后便无法使用。它们不占空间。应用自身的设置可以移除它们；否则管理员可以在“终端”中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@指向App內部，App移除後就無法運作。它們不佔用空間。App自己的設定可能可以移除；否則管理者可在「終端機」中移除。"
          }
        }
      }
    },
    "%@ report %@" : {

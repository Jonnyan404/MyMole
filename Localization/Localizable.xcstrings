        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最小的文件"
          }
        }
      }
    },
    "Smart Scan" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能扫描"
          }
        }
      }
    },
    "Some app-data locations couldn't be inspected or the search reached its limit. Only completely measured candidates are offered; additional data may remain." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分应用数据位置无法检查，或搜索达到了上限。只提供已完整测量的候选项；可能仍有其他数据。"
          }
        }
      }
    },
    "Some files couldn't be compared, so this search can't confirm that there are no duplicates." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分文件无法比对，因此本次搜索无法确认没有重复项。"
          }
        }
      }
    },
    "Some folders couldn't be read; sizes are at least this" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分文件夹无法读取；实际大小至少如此"
          }
        }
      }
    },
    "Some integration metadata couldn't be read or exceeded the inspection limit. This isn't a complete list." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分集成元数据无法读取或超出检查上限。这不是完整列表。"
          }
        }
      }
    },
    "Some known shared-component locations couldn't be inspected. This isn't a complete installation manifest." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分已知的共享组件位置无法检查。这不是完整的安装清单。"
          }
        }
      }
    },
    "Some macOS discovery sources were unavailable. Choose a folder to search build outputs directly; the results don't cover every app on the Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分 macOS 发现来源不可用。可选择文件夹直接搜索构建产物；结果不覆盖这台 Mac 上的所有应用。"
          }
        }
      }
    },

    "Nothing was moved: Deep Clean's keep list couldn't be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wurde bewegt: Die Behalten-Liste der Tiefenreinigung konnte nicht gelesen werden."
          }
        },
        "es" : {

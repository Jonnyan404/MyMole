        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप गायब है, पढ़ा नहीं जा सकता या बदल दिया गया है। यह समीक्षा बंद करें और ऐप सूची फिर से लोड करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 없거나 읽을 수 없거나 교체되었습니다. 이 검토를 닫고 앱 목록을 다시 불러오세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

    "NuGet's package cache. Fetched again on the next restore, which needs the network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket-Cache von NuGet. Wird bei der nächsten Wiederherstellung erneut geladen; dafür ist das Netzwerk nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché de paquetes de NuGet. Se vuelve a descargar en la próxima restauración, lo que necesita la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache de paquets de NuGet. Récupéré à nouveau à la prochaine restauration, ce qui nécessite le réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NuGet का पैकेज कैश। अगली रीस्टोर पर फिर से लाया जाता है, जिसके लिए नेटवर्क चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache dei pacchetti di NuGet. Viene recuperata di nuovo al prossimo ripristino, che richiede la rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NuGetのパッケージキャッシュです。次回の復元時に再び取得され、ネットワークが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NuGet의 패키지 캐시입니다. 다음 복원 시 다시 받으며 네트워크가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De pakketcache van NuGet. Wordt bij de volgende restore opnieuw opgehaald, waarvoor het netwerk nodig is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache de pacotes do NuGet. Buscado novamente na próxima restauração, o que requer a rede."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NuGets paketcache. Hämtas igen vid nästa återställning, vilket kräver nätverk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

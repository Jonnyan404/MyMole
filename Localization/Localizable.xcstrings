    "Every file stays where it is, with its own name, contents, dates and tags. Nothing changes in the apps that use them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Datei bleibt, wo sie ist, mit eigenem Namen, Inhalt, Datum und Tags. In den Apps, die sie nutzen, ändert sich nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada archivo se queda donde está, con su propio nombre, contenido, fechas y etiquetas. Nada cambia en las apps que los usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fichier reste à sa place, avec son nom, son contenu, ses dates et ses tags. Rien ne change dans les apps qui les utilisent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर फ़ाइल अपनी जगह रहती है, अपने नाम, सामग्री, तिथियों और टैग के साथ। उन्हें उपयोग करने वाले ऐप्स में कुछ नहीं बदलता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni file resta dov’è, con il suo nome, il suo contenuto, le sue date e i suoi tag. Per le app che li usano non cambia nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのファイルは、名前、内容、日付、タグもそのままで元の場所に残ります。それらを使うアプリには何の変化もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 파일은 이름, 내용, 날짜, 태그를 그대로 유지한 채 제자리에 남습니다. 파일을 쓰는 앱에서도 달라지는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk bestand blijft op zijn plaats, met zijn eigen naam, inhoud, datums en tags. Er verandert niets in de apps die ze gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada arquivo continua onde está, com seu próprio nome, conteúdo, datas e etiquetas. Nada muda nos apps que os usam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla filer finns kvar där de är, med eget namn, innehåll, datum och taggar. Inget ändras i apparna som använder dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个文件都留在原处，名称、内容、日期和标签不变。使用它们的应用不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個檔案都留在原處，並保有自己的名稱、內容、日期和標籤。使用這些檔案的App不會有任何改變。"
          }
        }
      }
    },
    "Every folder is scanned. To leave one out, choose Don't Scan This Folder from its menu in Browse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Ordner wird gescannt. Um einen auszulassen, wähle in „Durchsuchen“ in seinem Menü „Diesen Ordner nicht scannen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se analizan todas las carpetas. Para excluir una, elige No analizar esta carpeta en su menú de Explorar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

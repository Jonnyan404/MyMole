    "That app changed or already quit. Refresh the reading before trying again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App hat sich geändert oder wurde bereits beendet. Aktualisiere den Messwert, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa app cambió o ya se cerró. Actualiza la lectura antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app a changé ou a déjà quitté. Actualisez la mesure avant de réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह ऐप बदल गया या पहले ही बंद हो गया। फिर से कोशिश करने से पहले रीडिंग रीफ़्रेश करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 앱이 변경되었거나 이미 종료되었습니다. 다시 시도하기 전에 측정을 새로 고치세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该应用已更改或已退出。请刷新读取结果后再试。"
          }
        }
      }
    },
    "That was %@, not %@. Choose %@ itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war %@, nicht %@. Wähle %@ selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That was %1$@, not %2$@. Choose %3$@ itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era %@, no %@. Elige %@ en sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’était %@, pas %@. Choisissez %@ lui-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह %@ था, %@ नहीं। स्वयं %@ चुनें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@였습니다(%2$@ 아님). %3$@ 자체를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那是 %1$@，不是 %2$@。请选择 %3$@ 本身。"
          }
        }
      }
    },
    "The %lld chosen leftovers (%@) go to the Trash. The app already there stays untouched. Ownership and keep rules are checked again. You can undo right after." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Der ausgewählte Rest (%2$@) kommt in den Papierkorb. Die App, die schon dort ist, bleibt unangetastet. Zugehörigkeit und Behalten-Regeln werden erneut geprüft. Du kannst direkt danach widerrufen."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Die %arg ausgewählten Reste (%2$@) kommen in den Papierkorb. Die App, die schon dort ist, bleibt unangetastet. Zugehörigkeit und Behalten-Regeln werden erneut geprüft. Du kannst direkt danach widerrufen."
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "The %arg chosen leftover (%2$@) goes to the Trash. The app already there stays untouched. Ownership and keep rules are checked again. You can undo right after."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "The %arg chosen leftovers (%2$@) go to the Trash. The app already there stays untouched. Ownership and keep rules are checked again. You can undo right after."
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "El resto elegido (%2$@) va a la Papelera. La app que ya está ahí no se toca. Se vuelven a comprobar la pertenencia y las reglas de conservación. Puedes deshacer justo después."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Los %arg restos elegidos (%2$@) van a la Papelera. La app que ya está ahí no se toca. Se vuelven a comprobar la pertenencia y las reglas de conservación. Puedes deshacer justo después."
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Le reste choisi (%2$@) va dans la Corbeille. L’app qui s’y trouve déjà n’est pas touchée. L’appartenance et les règles de conservation sont vérifiées à nouveau. Vous pouvez annuler juste après."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Les %arg restes choisis (%2$@) vont dans la Corbeille. L’app qui s’y trouve déjà n’est pas touchée. L’appartenance et les règles de conservation sont vérifiées à nouveau. Vous pouvez annuler juste après."
                    }
                  }
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "चुना गया %arg बचा हुआ आइटम (%2$@) ट्रैश में जाता है। वहाँ पहले से मौजूद ऐप को छुआ नहीं जाता। स्वामित्व और रखें नियम फिर से जाँचे जाते हैं। आप तुरंत बाद पहले जैसा कर सकते हैं।"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "चुने गए %arg बचे हुए आइटम (%2$@) ट्रैश में जाते हैं। वहाँ पहले से मौजूद ऐप को छुआ नहीं जाता। स्वामित्व और रखें नियम फिर से जाँचे जाते हैं। आप तुरंत बाद पहले जैसा कर सकते हैं।"
                    }
                  }
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "선택한 잔여 항목 %arg개(%2$@)가 휴지통으로 이동합니다. 이미 휴지통에 있는 앱은 건드리지 않습니다. 소유권과 보관 규칙을 다시 확인합니다. 바로 실행 취소할 수 있습니다."
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "已选的 %arg 项残留（%2$@）移到废纸篓。已在原处的应用不会被动到。归属与保留规则会再次检查。你可以随后立即撤销。"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "The App Store edition works only in the folders you choose here. Full Disk Access in System Settings also lets it into the folders macOS protects inside them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App Store-Edition arbeitet nur in den Ordnern, die du hier auswählst. Festplattenvollzugriff in den Systemeinstellungen lässt sie auch in die Ordner, die macOS darin schützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La edición App Store solo funciona en las carpetas que elijas aquí. El acceso total al disco en Ajustes del Sistema también le deja entrar en las carpetas que macOS protege dentro de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’édition App Store ne fonctionne que dans les dossiers que vous choisissez ici. L’accès complet au disque dans Réglages Système lui ouvre aussi les dossiers que macOS protège à l’intérieur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store संस्करण केवल यहाँ चुने फ़ोल्डरों में काम करता है। सिस्टम सेटिंग्ज़ में पूर्ण डिस्क ऐक्सेस इसे उनके अंदर macOS द्वारा सुरक्षित फ़ोल्डरों में भी जाने देता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 에디션은 여기서 선택한 폴더에서만 작동합니다. 시스템 설정의 전체 디스크 접근 권한을 주면 그 안에서 macOS가 보호하는 폴더에도 접근할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用商店版只能在你于此选择的文件夹中工作。在“系统设置”中授予“完全磁盘访问”，还能让它进入这些文件夹内受 macOS 保护的位置。"
          }
        }
      }
    },
    "The Applications folder changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner „Programme“ hat sich geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta Aplicaciones cambió."
          }
        },
        "fr" : {

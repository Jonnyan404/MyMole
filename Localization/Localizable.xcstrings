      }
    },
    "System-wide settings or data are chosen. They're deleted for good, not moved to the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemweite Einstellungen oder Daten sind ausgewählt. Sie werden endgültig gelöscht, nicht in den Papierkorb gelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay ajustes o datos de todo el sistema elegidos. Se eliminan definitivamente, no se trasladan a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des réglages ou données à l’échelle du système sont choisis. Ils sont supprimés définitivement, pas placés dans la Corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम-व्यापी सेटिंग्ज़ या डेटा चुना गया है। ये स्थायी रूप से हटाए जाते हैं, रद्दी में नहीं जाते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai scelto impostazioni o dati a livello di sistema. Vengono eliminati definitivamente, non spostati nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム全体の設定またはデータが対象に含まれています。これらはゴミ箱に入らず、完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 전체 설정 또는 데이터가 선택되었습니다. 휴지통으로 이동하지 않고 영구적으로 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn systeembrede instellingen of gegevens gekozen. Die worden definitief verwijderd, niet naar de prullenmand verplaatst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foram escolhidos ajustes ou dados no nível do sistema. Eles são apagados definitivamente, não movidos para o Lixo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemgemensamma inställningar eller data är valda. De raderas permanent och flyttas inte till papperskorgen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已选择系统级的设置或数据。它们会被彻底删除，而不是移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已選擇系統層級的設定或資料。這些項目會永久刪除，不會丟到垃圾桶。"
          }
        }
      }
    },

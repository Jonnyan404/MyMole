        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ बना रहता है। चुना गया %arg बचा हुआ आइटम (%3$@) ट्रैश में जाता है, ताकि यह पहली बार की तरह फिर से शुरू हो। आप तुरंत बाद पहले जैसा कर सकते हैं।"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ बना रहता है। चुने गए %arg बचे हुए आइटम (%3$@) ट्रैश में जाते हैं, ताकि यह पहली बार की तरह फिर से शुरू हो। आप तुरंत बाद पहले जैसा कर सकते हैं।"
                    }

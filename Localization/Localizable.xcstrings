    "Not alike the best picture itself, only alike another picture of the group. Look at it closely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht dem besten Bild selbst ähnlich, nur einem anderen Bild der Gruppe. Sieh es dir genau an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se parece a la mejor imagen en sí, solo a otra imagen del grupo. Mírala con atención."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ressemble pas à la meilleure image elle-même, seulement à une autre image du groupe. Regardez-la de près."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे अच्छी तस्वीर से नहीं, केवल समूह की किसी दूसरी तस्वीर से मिलती है। इसे ध्यान से देखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non simile alla migliore, ma solo a un’altra immagine del gruppo. Guardala con attenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最良の画像とは似ておらず、グループの別の画像にだけ似ています。よく確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 좋은 사진 자체와는 비슷하지 않고 그룹의 다른 사진과만 비슷합니다. 자세히 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lijkt niet op de beste afbeelding zelf, alleen op een andere afbeelding in de groep. Bekijk deze goed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é parecida com a melhor imagem, apenas com outra imagem do grupo. Veja-a com atenção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liknar inte själva den bästa bilden, bara en annan bild i gruppen. Titta noga på den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

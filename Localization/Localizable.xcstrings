    "%@ is in the Trash. Disk use goes down once it's emptied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ im Papierkorb. Die Festplattennutzung sinkt, sobald er entleert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en la Papelera. El uso del disco baja cuando se vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dans la Corbeille. L’espace utilisé baisse une fois qu’elle est vidée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ट्रैश में। इसे खाली करने पर डिस्क उपयोग घटता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통에 %@. 휴지통을 비우면 디스크 사용량이 줄어듭니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已在废纸篓中。清空废纸篓后磁盘占用才会下降。"
          }
        }
      }
    },
    "%@ is locked, and MyMole couldn't unlock it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist geschützt, und MyMole konnte den Schutz nicht aufheben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está bloqueado y MyMole no pudo desbloquearlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est verrouillé et MyMole n’a pas pu le déverrouiller."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ लॉक है, और MyMole इसे अनलॉक नहीं कर सका।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 잠겨 있으며 MyMole이 잠금을 해제할 수 없었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已锁定，MyMole 无法解锁。"
          }
        }
      }
    },
    "%@ is on one of your keep lists, or holds something that is, so it stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ steht auf einer deiner Behalten-Listen oder enthält etwas, das darauf steht, daher bleibt es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en una de tus listas de conservación, o contiene algo que lo está, así que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ figure dans l’une de vos listes de conservation, ou contient un élément qui y figure : il reste donc en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आपकी किसी रखें-सूची में है, या उसमें ऐसा कुछ है जो सूची में है, इसलिए यह बना रहता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 보관 목록 중 하나에 있거나 목록에 있는 항목을 포함하므로 그대로 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 在你的某个保留清单上，或其中包含这类项目，因此保留。"
          }
        }
      }
    },
    "%@ is on one of your keep lists, so it stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ steht auf einer deiner Behalten-Listen, daher bleibt es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en una de tus listas de conservación, así que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ figure dans l’une de vos listes de conservation : il reste donc en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आपकी किसी रखें-सूची में है, इसलिए यह बना रहता है।"
          }
        },
        "ko" : {
          "stringUnit" : {

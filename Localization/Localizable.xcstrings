    "Stops before the next item. Anything already moved can be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt vor dem nächsten Objekt. Bereits Bewegtes kann widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene antes del siguiente elemento. Lo que ya se movió se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’arrête avant l’élément suivant. Ce qui a déjà été déplacé peut être annulé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगले आइटम से पहले रुकता है। जो पहले ही ले जाया गया उसे पहले जैसा किया जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si interrompe prima dell’elemento successivo. Tutto ciò che è già stato spostato si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の項目の前に停止します。すでに移動したものは取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 항목 전에 중지합니다. 이미 이동한 항목은 실행 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopt vóór het volgende onderdeel. Wat al is verplaatst, kan ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe antes do próximo item. Tudo o que já foi movido pode ser desfeito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppar före nästa objekt. Allt som redan har flyttats kan ångras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会在下一个项目前停止。已经移动的内容可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會在下一個項目之前停止。已搬移的項目可以還原。"
          }
        }
      }
    },

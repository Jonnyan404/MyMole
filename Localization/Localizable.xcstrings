    },
    "Whitelist, blacklist and pins" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留、排除与固定"
          }
        }
      }
    },
    "Whitelist: %@" : {

        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스크는 클론을 만들 수 없습니다. APFS 디스크만 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schijf kan geen klonen maken. Dat kunnen alleen APFS-schijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O disco dele não pode criar clones. Só discos APFS podem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess skiva kan inte skapa kloner. Det kan bara APFS-skivor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

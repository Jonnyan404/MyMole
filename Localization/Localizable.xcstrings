        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグシンボルを含む、アーカイブされたビルドです。リリースしたすべてのバージョンについて残しておいてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버그 기호가 포함된 아카이브된 빌드입니다. 출시한 모든 버전에 대해 보관하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gearchiveerde build met debugsymbolen. Bewaar die voor elke versie die je hebt uitgebracht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma compilação arquivada com seus símbolos de depuração. Guarde-a para cada versão que você lançou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett arkiverat bygge med sina felsökningssymboler. Spara det för alla versioner du har släppt."

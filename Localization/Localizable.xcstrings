    "What's in %@ isn't listed. The result isn't saved as complete; give MyMole Full Disk Access or scan again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt von %@ wird nicht aufgeführt. Das Ergebnis wird nicht als vollständig gesichert; gewähre MyMole Festplattenvollzugriff oder scanne erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido de %@ no aparece en la lista. El resultado no se guarda como completo; da a MyMole acceso total al disco o vuelve a analizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu de %@ n’est pas listé. Le résultat n’est pas enregistré comme complet ; donnez à MyMole l’accès complet au disque ou relancez l’analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ की सामग्री सूचीबद्ध नहीं है। परिणाम पूरा मानकर सहेजा नहीं गया; MyMole को पूर्ण डिस्क ऐक्सेस दें या फिर से स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto di %@ non è elencato. Il risultato non viene salvato come completo; dai a MyMole “Accesso completo al disco” o ripeti la scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の中身は表示されていません。結果は完全なものとしては保存されません。MyMoleにフルディスクアクセスを許可するか、もう一度スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 내용은 표시되지 않습니다. 결과가 완전한 것으로 저장되지 않으니 MyMole에 전체 디스크 접근 권한을 부여하거나 다시 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat in %@ staat, wordt niet vermeld. Het resultaat is niet als volledig bewaard; geef MyMole volledige schijftoegang of scan opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo de %@ não está listado. O resultado não é salvo como completo; dê ao MyMole o Acesso Total ao Disco ou analise novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som finns i %@ visas inte. Resultatet sparas inte som fullständigt. Ge MyMole Full skivtillgång eller skanna igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中的内容不会列出。该结果不会保存为完整结果；请授予 MyMole“完全磁盘访问权限”或重新扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

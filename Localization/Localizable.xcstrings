        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene listos el mapa del disco y los gráficos recientes, y redibuja los análisis en curso cinco veces por segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la carte du disque et les graphiques récents prêts, et rafraîchit les analyses en cours cinq fois par seconde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क मैप और हाल के चार्ट तैयार रखता है, और चल रहे स्कैन पाँच बार प्रति सेकंड बनाता है।"

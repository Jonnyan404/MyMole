      }
    },
    "It has used a whole core for %lld minutes or more, and may be stuck. Look at it in Live Status, or quit it if you don't need it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hat einen ganzen Kern %#@arg1@ oder länger genutzt und hängt eventuell. Sieh es dir im Live-Status an oder beende es, wenn du es nicht brauchst."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {

    "Search misses files until the rebuild ends, which can take hours and keeps the disk busy. Can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche verpasst Dateien, bis der Neuaufbau fertig ist; das kann Stunden dauern und die Festplatte beschäftigen. Kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda no encuentra archivos hasta que termine la reconstrucción, que puede tardar horas y mantener ocupado el disco. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche manque des fichiers jusqu’à la fin de la reconstruction, ce qui peut prendre des heures et occuper le disque. Irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोबारा बनने तक खोज में फ़ाइलें छूटती हैं, जिसमें घंटों लग सकते हैं और डिस्क व्यस्त रहती है। पहले जैसा नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca non trova alcuni file fino al termine della ricostruzione, che può richiedere ore e tiene occupato il disco. L’azione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再構築が終わるまで、検索で見つからないファイルがあります。数時間かかることがあり、その間ディスクの負荷が高くなります。取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재구축이 끝날 때까지 검색에서 파일이 누락되며, 몇 시간이 걸리고 디스크가 바빠질 수 있습니다. 실행 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoeken mist bestanden totdat het opnieuw opbouwen klaar is, wat uren kan duren en de schijf bezighoudt. Kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca deixa de encontrar arquivos até o fim da recriação, que pode levar horas e mantém o disco ocupado. Não pode ser desfeito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökningen missar filer tills indexet är ombyggt, vilket kan ta timmar och håller skivan upptagen. Kan inte ångras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重建结束前搜索会遗漏文件，可能耗时数小时并让磁盘持续繁忙。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重建完成前，搜尋會遺漏檔案；這可能需要數小時，並讓磁碟持續忙碌。無法還原。"
          }
        }
      }
    },

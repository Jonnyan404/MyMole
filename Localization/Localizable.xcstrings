    "Drag %@ to App Management" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in die App-Verwaltung ziehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra %@ a Gestión de las apps"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser %@ dans Gestion des apps"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को ऐप प्रबंधन में खींचें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina %@ in “Gestione app”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を“アプリ管理”にドラッグ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 앱 관리로 드래그"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep %@ naar 'Appbeheer'"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste %@ para o Gerenciamento de Apps"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra %@ till Apphantering"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 %1$@ 拖到“App管理”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將%@拖到「App管理」"
          }
        }
      }
    },
    "Drag a handle to move a card. Drag its corner sideways to resize. Cards fill each row and share its height." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe einen Griff, um eine Karte zu bewegen. Ziehe ihre Ecke seitwärts, um die Größe zu ändern. Karten füllen jede Zeile und teilen ihre Höhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un tirador para mover una tarjeta. Arrastra su esquina hacia los lados para cambiar su tamaño. Las tarjetas llenan cada fila y comparten su altura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une poignée pour déplacer une carte. Faites glisser son coin latéralement pour la redimensionner. Les cartes remplissent chaque ligne et en partagent la hauteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड ले जाने के लिए हैंडल खींचें। आकार बदलने के लिए उसका कोना बगल में खींचें। कार्ड हर पंक्ति भरते हैं और उसकी ऊँचाई साझा करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una maniglia per spostare una scheda. Trascina il suo angolo di lato per ridimensionarla. Le schede riempiono ogni riga e ne condividono l’altezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハンドルをドラッグしてカードを移動します。角を横にドラッグするとサイズを変更できます。カードは各行を埋め、同じ高さになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핸들을 드래그해 카드를 이동하세요. 모서리를 옆으로 드래그하면 크기가 바뀝니다. 카드는 각 행을 채우고 높이를 공유합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een greep om een kaart te verplaatsen. Sleep de hoek zijwaarts om de grootte te wijzigen. Kaarten vullen elke rij en hebben dezelfde hoogte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste uma alça para mover um cartão. Arraste o canto para os lados para redimensionar. Os cartões preenchem cada linha e têm a altura dela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra i ett handtag för att flytta ett kort. Dra dess hörn i sidled för att ändra storlek. Korten fyller varje rad och delar dess höjd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动控制柄可移动卡片。横拖卡片角可调整大小。卡片铺满每行并共用行高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移控點來移動卡片。左右拖移卡片角落來調整大小。卡片會填滿每一列，且高度相同。"
          }
        }
      }
    },
    "Drag column dividers to resize. Double-click a divider to fit visible contents. Right-click a heading to show or hide columns. Scroll sideways or hover to read full text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe Spaltentrenner, um die Größe zu ändern. Doppelklicke auf einen Trenner, um ihn an den sichtbaren Inhalt anzupassen. Klicke mit der rechten Maustaste auf eine Überschrift, um Spalten ein- oder auszublenden. Scrolle seitwärts oder bewege den Zeiger darüber, um den vollständigen Text zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los divisores de columna para cambiar su tamaño. Haz doble clic en un divisor para ajustarlo al contenido visible. Haz clic con el botón derecho en un encabezado para mostrar u ocultar columnas. Desplázate hacia los lados o pasa el puntero para leer el texto completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les séparateurs de colonnes pour les redimensionner. Double-cliquez sur un séparateur pour ajuster au contenu visible. Cliquez avec le bouton droit sur un en-tête pour afficher ou masquer des colonnes. Faites défiler latéralement ou survolez pour lire le texte entier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार बदलने के लिए कॉलम विभाजक खींचें। दिखने वाली सामग्री के अनुसार फ़िट करने के लिए विभाजक पर डबल-क्लिक करें। कॉलम दिखाने या छिपाने के लिए शीर्षक पर राइट-क्लिक करें। पूरा टेक्स्ट पढ़ने के लिए बगल में स्क्रॉल करें या पॉइंटर ले जाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i divisori delle colonne per ridimensionarle. Fai doppio clic su un divisore per adattarlo ai contenuti visibili. Fai clic con il tasto destro su un’intestazione per mostrare o nascondere le colonne. Scorri di lato o passa con il puntatore per leggere il testo completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列の境界線をドラッグするとサイズを変更できます。境界線をダブルクリックすると、表示中の内容に合わせます。列見出しを右クリックすると、列の表示/非表示を切り替えられます。全文を読むには、横にスクロールするかポインタを重ねます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 구분선을 드래그해 크기를 조절하세요. 구분선을 이중 클릭하면 보이는 내용에 맞춥니다. 머리글을 마우스 오른쪽 버튼으로 클릭해 열을 표시하거나 가립니다. 옆으로 스크롤하거나 포인터를 올려 전체 텍스트를 읽으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep kolomscheidingen om de breedte te wijzigen. Klik dubbel op een scheiding om de breedte aan te passen aan de zichtbare inhoud. Klik met de rechtermuisknop op een kop om kolommen te tonen of te verbergen. Scrol zijwaarts of houd de aanwijzer stil om de volledige tekst te lezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste os divisores para redimensionar as colunas. Clique duas vezes em um divisor para ajustar ao conteúdo visível. Clique com o botão direito em um título para mostrar ou ocultar colunas. Role para os lados ou passe o cursor para ler o texto completo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra i kolumnavdelarna för att ändra bredd. Dubbelklicka på en avdelare för att anpassa till synligt innehåll. Högerklicka på en rubrik för att visa eller gömma kolumner. Rulla i sidled eller håll pekaren över för att läsa hela texten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动列分隔线可调整宽度。双击分隔线可贴合可见内容。右键点击标题可显示或隐藏列。横向滚动或悬停可查看完整文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移欄位分隔線來調整大小。按兩下分隔線來符合可見內容。在標題上按右鍵來顯示或隱藏欄位。左右捲動或停留在上方來閱讀完整文字。"
          }
        }
      }
    },
    "Drag sideways to resize, or click to toggle width. Cards in a row share a height." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitwärts ziehen, um die Größe zu ändern, oder klicken, um die Breite umzuschalten. Karten in einer Zeile teilen eine Höhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra hacia los lados para cambiar el tamaño, o haz clic para alternar el ancho. Las tarjetas de una fila comparten altura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser latéralement pour redimensionner, ou cliquez pour changer la largeur. Les cartes d’une même ligne partagent une hauteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार बदलने के लिए बगल में खींचें, या चौड़ाई बदलने के लिए क्लिक करें। एक पंक्ति के कार्ड ऊँचाई साझा करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina di lato per ridimensionare, o fai clic per alternare la larghezza. Le schede di una riga hanno la stessa altezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横にドラッグしてサイズを変更、またはクリックして幅を切り替えます。同じ行のカードは同じ高さになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "옆으로 드래그해 크기를 조절하거나 클릭해 너비를 전환하세요. 한 행의 카드는 높이를 공유합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep zijwaarts om de grootte te wijzigen of klik om van breedte te wisselen. Kaarten in een rij hebben dezelfde hoogte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para os lados para redimensionar ou clique para alternar a largura. Os cartões de uma linha têm a mesma altura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra i sidled för att ändra storlek eller klicka för att växla bredd. Kort på samma rad har samma höjd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横向拖动可调整大小，点按可切换宽度。同一行的卡片共用高度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右拖移來調整大小，或按一下來切換寬度。同一列的卡片高度相同。"
          }
        }
      }
    },
    "Drag this app into the App Management list." : {

        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定が対象に含まれています。再インストールすると、デフォルトの状態から始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정이 선택되었습니다. 다시 설치하면 기본값으로 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn instellingen gekozen. Na opnieuw installeren begint de app met de standaardinstellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há ajustes escolhidos. Uma reinstalação começaria com os padrões."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar är valda. En ominstallation skulle börja från förvalen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已选择设置。重新安装会从默认值开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已選擇設定。重新安裝時會從預設值開始。"
          }
        }
      }
    },
    "Settings files and window states go to the Trash; the rest refreshes in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungsdateien und Fensterzustände kommen in den Papierkorb; der Rest wird an Ort und Stelle aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de ajustes y los estados de ventana van a la Papelera; el resto se actualiza en su sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de réglages et états de fenêtres vont dans la Corbeille ; le reste s’actualise sur place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज़ फ़ाइलें और विंडो स्थितियाँ रद्दी में जाती हैं; बाकी अपनी जगह रीफ़्रेश होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file di impostazioni e gli stati delle finestre vanno nel Cestino; il resto viene aggiornato sul posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定ファイルとウインドウの状態はゴミ箱に入ります。それ以外はその場で更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 파일과 윈도우 상태는 휴지통으로 이동하고 나머지는 그 자리에서 새로 고쳐집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingenbestanden en vensterstatussen gaan naar de prullenmand; de rest wordt ter plekke vernieuwd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos de ajustes e estados de janelas vão para o Lixo; o resto é atualizado no próprio lugar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningsfiler och fönsterlägen hamnar i papperskorgen. Resten uppdateras på plats."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置文件和窗口状态会移到废纸篓；其余内容就地刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定檔和視窗狀態會丟到垃圾桶；其餘項目會就地重新整理。"
          }
        }
      }
    },

    "Changed within the last %@, or a running program is at work there. It's offered here once it has been left alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als %@ unverändert, oder ein laufendes Programm arbeitet dort. Es wird hier angeboten, sobald es in Ruhe gelassen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambió en los últimos %@, o un programa en ejecución trabaja ahí. Se ofrecerá aquí cuando lleve un tiempo sin tocarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifié au cours des derniers %@, ou un programme en cours d’exécution y travaille. Il sera proposé ici une fois laissé de côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले %@ में बदला गया, या कोई चल रहा प्रोग्राम वहाँ काम कर रहा है। जब इसे छोड़ दिया जाएगा तब यह यहाँ पेश किया जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificato meno di %@ fa, oppure un programma in esecuzione ci sta lavorando. Verrà proposto qui quando non sarà più toccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以内に変更されたか、実行中のプログラムが使用しています。しばらく使われなくなったら、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 %@ 이내에 변경되었거나 실행 중인 프로그램이 그곳에서 작업 중입니다. 건드리지 않게 되면 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewijzigd in de laatste %@, of er is een actief programma bezig. Het wordt hier aangeboden zodra het met rust is gelaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterado há menos de %@, ou um programa em execução está trabalhando ali. O item é oferecido aqui depois que nada mais mexer nele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändrades för högst %@ sedan, eller så arbetar ett program som körs där. Det erbjuds här när det har fått vara ifred."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近 %@内有改动，或有正在运行的程序在那里工作。等它不再被使用后，会在这里列出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在過去%@內有更改，或有執行中的程式正在那裡運作。不再被使用之後，就會在這裡列出。"
          }
        }
      }
    },

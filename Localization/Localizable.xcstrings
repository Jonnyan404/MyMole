          }
        }
      }
    },
    "Homebrew wasn't found, or this edition may not look where it installs: the App Sandbox keeps App Store apps out of /opt/homebrew and /usr/local." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew wurde nicht gefunden, oder diese Edition darf nicht dort suchen, wo es installiert ist: Die App-Sandbox hält App Store-Apps aus /opt/homebrew und /usr/local heraus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró Homebrew, o esta edición no puede mirar donde se instala: el aislamiento de apps mantiene las apps del App Store fuera de /opt/homebrew y /usr/local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew est introuvable, ou cette édition ne peut pas regarder là où il s’installe : la sandbox des apps garde les apps de l’App Store hors de /opt/homebrew et /usr/local."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew नहीं मिला, या यह संस्करण वहाँ नहीं देख सकता जहाँ यह इंस्टॉल होता है: ऐप सैंडबॉक्स App Store ऐप्स को /opt/homebrew और /usr/local से बाहर रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew non è stato trovato, oppure questa edizione non può guardare dove installa: la App Sandbox tiene le app di App Store fuori da /opt/homebrew e /usr/local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrewが見つからないか、この版ではそのインストール先を調べることができません。App Storeのアプリは、App Sandboxにより/opt/homebrewと/usr/localにアクセスできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew를 찾을 수 없거나 이 에디션이 설치 위치를 볼 수 없습니다. 앱 샌드박스는 App Store 앱이 /opt/homebrew 및 /usr/local에 접근하지 못하게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew is niet gevonden, of deze editie mag niet kijken waar het wordt geïnstalleerd: de App Sandbox houdt apps uit de App Store buiten /opt/homebrew en /usr/local."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Homebrew não foi encontrado, ou esta edição não pode ver onde ele é instalado: a App Sandbox mantém os apps da App Store fora de /opt/homebrew e /usr/local."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew hittades inte, eller så får den här utgåvan inte titta där det installeras: App Sandbox håller App Store-appar utanför /opt/homebrew och /usr/local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 Homebrew，或此版本无法查看它的安装位置：应用沙箱不允许应用商店版访问 /opt/homebrew 和 /usr/local。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到Homebrew，或此版本不得查看其安裝位置：App沙箱不允許App Store的App取用 /opt/homebrew和 /usr/local。"
          }
        }
      }
    },

    "Files under 1 MB are counted in their folder, not listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien unter 1 MB werden in ihrem Ordner mitgezählt, aber nicht aufgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de menos de 1 MB se cuentan en su carpeta, no se listan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de moins de 1 Mo sont comptés dans leur dossier, sans être listés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 MB से छोटी फ़ाइलें अपने फ़ोल्डर में गिनी जाती हैं, सूची में नहीं आतीं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1MB 미만 파일은 폴더에 합산되며 목록에는 나오지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

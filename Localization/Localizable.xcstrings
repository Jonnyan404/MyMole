    "Rebuilds the list of which app opens what. Fixes duplicate apps in “Open With”. Takes a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt die Liste neu, welche App was öffnet. Behebt doppelte Apps in „Öffnen mit“. Dauert eine Minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruye la lista de qué app abre cada cosa. Corrige apps duplicadas en “Abrir con”. Tarda un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruit la liste des apps qui ouvrent chaque type de fichier. Corrige les apps en double dans « Ouvrir avec ». Prend une minute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कौन-सा ऐप क्या खोलता है इसकी सूची फिर से बनाता है। इसके साथ खोलें में डुप्लिकेट ऐप ठीक करता है। एक मिनट लगता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruisce l’elenco di quale app apre cosa. Corregge le app duplicate in “Apri con”. Richiede un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリで何を開くかのリストを再構築します。“このアプリケーションで開く”のアプリの重複を解消します。1分ほどかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 앱이 무엇을 여는지 목록을 다시 만듭니다. 다음으로 열기의 중복 앱을 고칩니다. 1분 정도 걸립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouwt de lijst opnieuw op waarin staat welke app wat opent. Verhelpt dubbele apps in 'Open met'. Duurt een minuut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

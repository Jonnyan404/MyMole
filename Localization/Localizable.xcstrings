            "value" : "Le dossier Applications a changé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप्लिकेशन फ़ोल्डर बदल गया।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

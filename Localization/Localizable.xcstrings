    "Included" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已包含"
          }
        }
      }
    },
    "Included with %@. Unchoose the containing folder before choosing individual items." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已随 %1$@ 一起包含。请先取消选择所属文件夹，再单独选择项目。"
          }
        }
      }
    },
    "Included with a chosen folder. Unchoose the containing folder before changing these items." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已随所选文件夹一起包含。请先取消选择所属文件夹，再更改这些项目。"

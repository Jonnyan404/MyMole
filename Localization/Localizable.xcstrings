          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "यह ऐप और चुना गया %arg डेटा आइटम ट्रैश में जाते हैं। लॉगिन पर खोलें बंद होता है। फिर MyMole बंद हो जाता है। आप इन्हें Finder के ट्रैश में वापस रखें से पुनर्स्थापित कर सकते हैं; बंद होने के बाद ऐप के अंदर पहले जैसा करें उपलब्ध नहीं है।"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "यह ऐप और चुने गए %arg डेटा आइटम ट्रैश में जाते हैं। लॉगिन पर खोलें बंद होता है। फिर MyMole बंद हो जाता है। आप इन्हें Finder के ट्रैश में वापस रखें से पुनर्स्थापित कर सकते हैं; बंद होने के बाद ऐप के अंदर पहले जैसा करें उपलब्ध नहीं है।"
                    }

    "Spacious" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Großzügig"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aérée"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुला"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazioso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆったり"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여유"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruim"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaçoso"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luftig"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宽松"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寬鬆"
          }
        }
      }
    },
    "Spacious gives margins, rows and the gaps between columns more room. Compact fits the most on screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Großzügig“ gibt Rändern, Zeilen und Spaltenabständen mehr Platz. „Kompakt“ zeigt am meisten auf dem Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplio da más espacio a los márgenes, las filas y los huecos entre columnas. Compacto muestra lo máximo en pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aérée donne plus de place aux marges, aux lignes et aux espaces entre colonnes. Compacte affiche le plus de contenu à l’écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुला हाशियों, पंक्तियों और कॉलमों के बीच ज़्यादा जगह देता है। कॉम्पैक्ट स्क्रीन पर सबसे ज़्यादा दिखाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazioso dà più respiro ai margini, alle righe e agli spazi tra le colonne. Compatto fa entrare il massimo sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ゆったり”では、余白、行、列の間隔が広くなります。“コンパクト”では、画面に最も多く表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여유는 여백, 행 및 열 간격을 넓힙니다. 간결은 화면에 가장 많이 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Ruim' geeft marges, rijen en de ruimte tussen kolommen meer plaats. Met 'Compact' past het meeste op het scherm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaçoso dá mais espaço às margens, às linhas e aos intervalos entre colunas. Compacto mostra o máximo na tela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luftig ger marginaler, rader och mellanrum mellan kolumner mer plats. Kompakt får in mest på skärmen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“宽松”会加大边距、行距和列间距。“紧凑”能在屏幕上显示最多内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「寬鬆」會讓邊界、列和欄位間距有更多空間。「緊湊」可在螢幕上容納最多內容。"
          }
        }
      }
    },

    "Pieces of a download that stopped. The next download of the same files starts over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile eines abgebrochenen Downloads. Der nächste Download derselben Dateien beginnt von vorn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partes de una descarga que se detuvo. La próxima descarga de los mismos archivos empieza de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morceaux d’un téléchargement arrêté. Le prochain téléchargement des mêmes fichiers repart de zéro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रुके हुए डाउनलोड के हिस्से। उन्हीं फ़ाइलों का अगला डाउनलोड शुरू से होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti di un download interrotto. Il prossimo download degli stessi file ricomincia da capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止したダウンロードの断片です。同じファイルを次にダウンロードするときは、最初からになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈춘 다운로드의 조각입니다. 같은 파일을 다음에 다운로드하면 처음부터 시작합니다."

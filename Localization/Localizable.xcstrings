    "Helper disabled — macOS asks for administrator approval per task." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helfer deaktiviert – macOS fragt bei jeder Aufgabe nach der Genehmigung eines Administrators."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistente desactivado: macOS pide la aprobación de un administrador para cada tarea."

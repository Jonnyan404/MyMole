    "Filtered results use a list. Clear the filters and choose This Folder to return to the tree." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefilterte Ergebnisse verwenden eine Liste. Setze die Filter zurück und wähle „Dieser Ordner“, um zum Baum zurückzukehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados filtrados usan una lista. Borra los filtros y elige Esta carpeta para volver al árbol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats filtrés utilisent une liste. Effacez les filtres et choisissez Ce dossier pour revenir à l’arborescence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िल्टर किए परिणाम सूची का उपयोग करते हैं। ट्री पर लौटने के लिए फ़िल्टर हटाएँ और यह फ़ोल्डर चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I risultati filtrati usano un elenco. Cancella i filtri e scegli “Questa cartella” per tornare all’albero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィルタした結果はリストで表示されます。ツリーに戻るには、フィルタをクリアして“このフォルダ”を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필터링된 결과는 목록을 사용합니다. 트리로 돌아가려면 필터를 지우고 이 폴더를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefilterde resultaten gebruiken een lijst. Wis de filters en kies 'Deze map' om terug te gaan naar de boom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados filtrados usam uma lista. Limpe os filtros e escolha Esta Pasta para voltar à árvore."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrerade resultat visas i en lista. Rensa filtren och välj Den här mappen för att gå tillbaka till trädet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "筛选后的结果以列表显示。清除筛选条件并选择“此文件夹”即可回到树形视图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過濾後的結果會使用列表。清除過濾條件並選擇「此檔案夾」來返回樹狀結構。"
          }
        }
      }
    },
    "Filtering only changes this list. Choose Items works across all scan results. Review ticked items before pressing Move to Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtern ändert nur diese Liste. „Objekte auswählen“ wirkt auf alle Scanergebnisse. Prüfe markierte Objekte, bevor du „In den Papierkorb legen“ drückst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrar solo cambia esta lista. Elegir elementos actúa sobre todos los resultados del análisis. Revisa los elementos marcados antes de pulsar Trasladar a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filtrage ne modifie que cette liste. Choisir des éléments agit sur tous les résultats d’analyse. Vérifiez les éléments cochés avant d’appuyer sur Placer dans la Corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िल्टर करना केवल यह सूची बदलता है। आइटम चुनें सभी स्कैन परिणामों पर काम करता है। रद्दी में ले जाएँ दबाने से पहले चिह्नित आइटम की समीक्षा करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I filtri cambiano solo questo elenco. “Scegli elementi” vale per tutti i risultati della scansione. Rivedi gli elementi spuntati prima di premere “Sposta nel Cestino”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィルタはこのリストの表示だけを変えます。“対象を追加”はスキャン結果全体に適用されます。“ゴミ箱に入れる”を押す前に、チェックした項目を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필터링은 이 목록만 변경합니다. 항목 선택은 모든 스캔 결과에 적용됩니다. 휴지통으로 이동을 누르기 전에 체크한 항목을 검토하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filteren wijzigt alleen deze lijst. 'Kies onderdelen' werkt voor alle scanresultaten. Bekijk de aangevinkte onderdelen voordat je op 'Verplaats naar prullenmand' klikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrar altera apenas esta lista. Escolher Itens vale para todos os resultados da análise. Revise os itens marcados antes de pressionar Mover para o Lixo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtreringen ändrar bara den här listan. Välj objekt gäller alla skanningsresultat. Granska de ikryssade objekten innan du klickar på Flytta till papperskorgen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "筛选只改变此列表。“选择项目”作用于所有扫描结果。按下“移到废纸篓”前请先检查已勾选的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過濾只會改變此列表。「選擇項目」會套用到所有掃描結果。按下「丟到垃圾桶」前，請先檢視勾選的項目。"
          }
        }
      }
    },

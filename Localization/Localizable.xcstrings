          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível selecionar o conteúdo completo da pasta. Nada foi adicionado. Verifique o acesso ou escolha grupos menores."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappens fullständiga innehåll kunde inte väljas. Inget lades till. Kontrollera åtkomsten eller välj mindre grupper."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

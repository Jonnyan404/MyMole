    "Finds .dmg, .iso, .pkg, .xip and .ipsw files, and macOS installers, left after installing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet .dmg-, .iso-, .pkg-, .xip- und .ipsw-Dateien sowie macOS-Installationsprogramme, die nach der Installation übrig sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca archivos .dmg, .iso, .pkg, .xip e .ipsw, e instaladores de macOS, que quedan tras instalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les fichiers .dmg, .iso, .pkg, .xip et .ipsw, et les installeurs de macOS, laissés après une installation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंस्टॉल के बाद बची .dmg, .iso, .pkg, .xip और .ipsw फ़ाइलें, और macOS इंस्टॉलर खोजता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치 후 남은 .dmg, .iso, .pkg, .xip, .ipsw 파일 및 macOS 설치 프로그램을 찾습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找安装后遗留的 .dmg、.iso、.pkg、.xip、.ipsw 文件和 macOS 安装器。"
          }
        }
      }
    },
    "Finds bursts, resized and re-saved copies of the same picture in Pictures, Desktop, Documents and Downloads. Pictures are only read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Serien, verkleinerte und erneut gesicherte Kopien desselben Bildes in „Bilder“, „Schreibtisch“, „Dokumente“ und „Downloads“. Bilder werden nur gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca ráfagas y copias redimensionadas o vueltas a guardar de la misma imagen en Imágenes, Escritorio, Documentos y Descargas. Las imágenes solo se leen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les rafales et les copies redimensionnées ou réenregistrées d’une même image dans Images, Bureau, Documents et Téléchargements. Les images sont seulement lues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures, डेस्कटॉप, दस्तावेज़ और डाउनलोड में एक ही तस्वीर के बर्स्ट, छोटे किए और दोबारा सहेजे संस्करण खोजता है। तस्वीरें केवल पढ़ी जाती हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진, 데스크탑, 문서 및 다운로드에서 같은 사진의 연속 촬영, 크기 조절 및 다시 저장된 사본을 찾습니다. 사진은 읽기만 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“图片”“桌面”“文档”和“下载”中查找同一张照片的连拍、缩放和另存副本。照片只被读取。"
          }
        }
      }
    },
    "Finds caches, logs and tool downloads that apps rebuild by themselves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Caches, Protokolle und Tool-Downloads, die Apps selbst neu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca cachés, registros y descargas de herramientas que las apps reconstruyen por sí solas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les caches, journaux et téléchargements d’outils que les apps reconstruisent d’elles-mêmes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैश, लॉग और टूल डाउनलोड खोजता है जिन्हें ऐप खुद फिर से बनाते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 스스로 다시 만드는 캐시, 로그 및 도구 다운로드를 찾습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找应用能自行重建的缓存、日志和工具下载。"
          }
        }
      }
    },
    "Finds files with the same content in Desktop, Documents, Downloads, Movies, Music and Pictures. Files are only read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Dateien mit gleichem Inhalt in „Schreibtisch“, „Dokumente“, „Downloads“, „Filme“, „Musik“ und „Bilder“. Dateien werden nur gelesen."
          }
        },
        "es" : {
          "stringUnit" : {

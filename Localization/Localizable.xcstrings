    "Cache inside the app's sandbox. Rebuilt the next time the app needs it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache in der Sandbox der App. Wird neu erstellt, wenn die App ihn das nächste Mal braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché dentro del entorno aislado de la app. Se reconstruye la próxima vez que la app la necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache dans le bac à sable de l’app. Reconstruit la prochaine fois que l’app en a besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के सैंडबॉक्स के अंदर का कैश। अगली बार ऐप को ज़रूरत होने पर फिर से बनता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache all’interno della sandbox dell’app. Si ricrea la prossima volta che l’app ne ha bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのサンドボックス内のキャッシュです。アプリが次に必要としたときに再生成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 샌드박스 안의 캐시입니다. 앱이 다음에 필요할 때 다시 만들어집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache in de sandbox van de app. Wordt opnieuw opgebouwd wanneer de app die weer nodig heeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache dentro da sandbox do app. Recriado na próxima vez que o app precisar dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache i appens sandlåda. Återskapas nästa gång appen behöver den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用沙盒内的缓存。应用下次需要时会重新生成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App沙箱內的快取。App下次需要時會重建。"
          }
        }
      }
    },
    "Cache kept in the app's own data folder. The app rebuilds it; quit the app first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache im eigenen Datenordner der App. Die App erstellt ihn neu; beende die App zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché guardada en la carpeta de datos de la app. La app la reconstruye; ciérrala primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache gardé dans le dossier de données de l’app. L’app le reconstruit ; quittez-la d’abord."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के अपने डेटा फ़ोल्डर में रखा कैश। ऐप इसे फिर से बनाता है; पहले ऐप बंद करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache conservata nella cartella dati dell’app stessa. L’app la ricrea; esci prima dall’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ自身のデータフォルダ内のキャッシュです。アプリが再生成します。先にアプリを終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 자체 데이터 폴더에 있는 캐시입니다. 앱이 다시 만들므로 먼저 앱을 종료하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache in de eigen gegevensmap van de app. De app bouwt die opnieuw op; stop de app eerst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache guardado na pasta de dados do próprio app. O app o recria; encerre o app antes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache som ligger i appens egen datamapp. Appen återskapar den. Avsluta appen först."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存在应用自身数据文件夹中的缓存。应用会重新生成；请先退出该应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存在App自己資料檔案夾中的快取。App會重建；請先結束App。"
          }
        }
      }
    },
    "Cache of one of Apple's apps. Rebuilt, though some resync first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache einer Apple-App. Wird neu erstellt, manche synchronisieren zuerst erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché de una app de Apple. Se reconstruye, aunque algunas se resincronizan primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache d’une app d’Apple. Reconstruit, mais certaines se resynchronisent d’abord."

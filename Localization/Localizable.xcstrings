        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有容器正在使用它。"
          }
        }
      }
    },
    "A container uses it. Remove the container first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Container verwendet es. Entferne zuerst den Container."

          "stringUnit" : {
            "state" : "translated",
            "value" : "필터링된 결과는 목록을 사용합니다. 트리로 돌아가려면 필터를 지우고 이 폴더를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "筛选后的结果以列表显示。清除筛选条件并选择“此文件夹”即可回到树形视图。"
          }
        }
      }
    },
    "Filtering only changes this list. Choose Items works across all scan results. Review ticked items before pressing Move to Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtern ändert nur diese Liste. „Objekte auswählen“ wirkt auf alle Scanergebnisse. Prüfe markierte Objekte, bevor du „In den Papierkorb legen“ drückst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrar solo cambia esta lista. Elegir elementos actúa sobre todos los resultados del análisis. Revisa los elementos marcados antes de pulsar Trasladar a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filtrage ne modifie que cette liste. Choisir des éléments agit sur tous les résultats d’analyse. Vérifiez les éléments cochés avant d’appuyer sur Placer dans la Corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िल्टर करना केवल यह सूची बदलता है। आइटम चुनें सभी स्कैन परिणामों पर काम करता है। ट्रैश में ले जाएँ दबाने से पहले चिह्नित आइटम की समीक्षा करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필터링은 이 목록만 변경합니다. 항목 선택은 모든 스캔 결과에 적용됩니다. 휴지통으로 이동을 누르기 전에 체크한 항목을 검토하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "筛选只改变此列表。“选择项目”作用于所有扫描结果。按下“移到废纸篓”前请先检查已勾选的项目。"
          }
        }
      }
    },

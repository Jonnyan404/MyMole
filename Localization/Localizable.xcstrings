    "%@ stays. The %lld chosen leftovers (%@) go to the Trash, so it starts over as on its first launch. You can undo right after." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ bleibt. Der ausgewählte Rest (%3$@) kommt in den Papierkorb, sodass es wie beim ersten Start neu beginnt. Du kannst direkt danach widerrufen."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ bleibt. Die %arg ausgewählten Reste (%3$@) kommen in den Papierkorb, sodass es wie beim ersten Start neu beginnt. Du kannst direkt danach widerrufen."
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ stays. The %arg chosen leftover (%3$@) goes to the Trash, so it starts over as on its first launch. You can undo right after."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ stays. The %arg chosen leftovers (%3$@) go to the Trash, so it starts over as on its first launch. You can undo right after."
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ se queda. El resto elegido (%3$@) va a la Papelera, para que empiece de nuevo como la primera vez que se abrió. Puedes deshacer justo después."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ se queda. Los %arg restos elegidos (%3$@) van a la Papelera, para que empiece de nuevo como la primera vez que se abrió. Puedes deshacer justo después."
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ reste. Le reste choisi (%3$@) va dans la Corbeille, pour qu’elle reparte comme à son premier lancement. Vous pouvez annuler juste après."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ reste. Les %arg restes choisis (%3$@) vont dans la Corbeille, pour qu’elle reparte comme à son premier lancement. Vous pouvez annuler juste après."
                    }
                  }
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ बना रहता है। चुना गया %arg बचा हुआ आइटम (%3$@) रद्दी में जाता है, ताकि यह पहली बार की तरह फिर से शुरू हो। आप तुरंत बाद पहले जैसा कर सकते हैं।"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ बना रहता है। चुने गए %arg बचे हुए आइटम (%3$@) रद्दी में जाते हैं, ताकि यह पहली बार की तरह फिर से शुरू हो। आप तुरंत बाद पहले जैसा कर सकते हैं।"
                    }
                  }
                }
              }
            }
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n1@"
          },
          "substitutions" : {
            "n1" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ resta. %arg residuo scelto (%3$@) va nel Cestino, così l’app ricomincia come al primo avvio. Puoi annullare subito dopo."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ resta. %arg residui scelti (%3$@) vanno nel Cestino, così l’app ricomincia come al primo avvio. Puoi annullare subito dopo."
                    }
                  }
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は残ります。対象の残存ファイル%2$lld個（%3$@）がゴミ箱に入り、初回起動時の状態に戻ります。直後に取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@은(는) 남습니다. 선택한 잔여 항목 %arg개(%3$@)가 휴지통으로 이동하여 처음 실행했을 때처럼 다시 시작합니다. 바로 실행 취소할 수 있습니다."
                    }
                  }
                }
              }
            }
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ blijft staan. Het gekozen restant (%3$@) gaat naar de prullenmand, zodat de app opnieuw begint zoals bij de eerste keer openen. Je kunt dit direct daarna ongedaan maken."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ blijft staan. De %arg gekozen restanten (%3$@) gaan naar de prullenmand, zodat de app opnieuw begint zoals bij de eerste keer openen. Je kunt dit direct daarna ongedaan maken."
                    }
                  }
                }
              }
            }
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fica. %#@n2@, para que ele recomece como na primeira abertura. Você pode desfazer logo em seguida."
          },
          "substitutions" : {
            "n2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {

      }
    },
    "Already shares its storage with the copy that stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt sich den Speicher bereits mit der Kopie, die bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya comparte su almacenamiento con la copia que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage déjà son stockage avec la copie qui reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले से बनी रहने वाली प्रति के साथ स्टोरेज साझा करती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condivide già lo spazio con la copia che resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残るコピーとすでにストレージを共有しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 남는 사본과 저장 공간을 공유합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deelt zijn opslag al met het exemplaar dat blijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

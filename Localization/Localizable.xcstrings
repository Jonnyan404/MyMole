    "Restored %lld; %lld couldn't be put back. Undo tries those again, or use Put Back in the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld wiederhergestellt; %#@arg2@. „Widerrufen“ versucht diese erneut, oder verwende „Zurücklegen“ im Papierkorb."
          },
          "substitutions" : {
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg konnte nicht zurückgelegt werden"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg konnten nicht zurückgelegt werden"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Restored %1$lld; %2$lld couldn't be put back. Undo tries those again, or use Put Back in the Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg1@; %#@arg2@. Deshacer vuelve a intentarlo, o usa Devolver en la Papelera."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg restaurado"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg restaurados"
                    }
                  }
                }
              }
            },
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg no se pudo devolver"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg no se pudieron devolver"
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg1@ ; %#@arg2@. Annuler les réessaie, ou utilisez Remettre dans la Corbeille."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg restauré"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg restaurés"
                    }
                  }
                }
              }
            },
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg n’a pas pu être remis"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg n’ont pas pu être remis"
                    }
                  }
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld पुनर्स्थापित; %lld वापस नहीं रखे जा सके। पहले जैसा करें उन्हें फिर से आज़माता है, या ट्रैश में वापस रखें का उपयोग करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개 복원함. %lld개는 되돌려 놓을 수 없음. 실행 취소로 다시 시도하거나 휴지통에서 되돌려 놓기를 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢复 %1$lld 项；%2$lld 项无法放回。撤销会再次尝试，也可以使用废纸篓中的“放回原处”。"
          }
        }
      }
    },
    "Restored %lld; %lld couldn't be put back. Undo tries those again." : {
      "localizations" : {
        "de" : {

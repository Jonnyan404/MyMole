    "Use Integrations to inspect this copy's menu providers, Services and file handlers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende „Integrationen“, um die Menüanbieter, Dienste und Dateihandler dieser Kopie zu untersuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Integraciones para inspeccionar los proveedores de menús, los Servicios y los gestores de archivos de esta copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Intégrations pour examiner les fournisseurs de menus, Services et gestionnaires de fichiers de cette copie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस कॉपी के मेनू प्रदाता, सर्विसेज़ और फ़ाइल हैंडलर देखने के लिए इंटीग्रेशन का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Integrazioni per esaminare i fornitori di menu, i servizi e i gestori di file di questa copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“連携機能”で、このコピーのメニューの提供元、サービス、ファイルの処理方法を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통합을 사용해 이 사본의 메뉴 제공자, 서비스 및 파일 처리기를 검사하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik 'Integraties' om de menu-aanbieders, voorzieningen en bestandsafhandelaars van dit exemplaar te bekijken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Integrações para inspecionar os provedores de menu, os Serviços e os associações de arquivos desta cópia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd Integrationer för att granska den här kopians menyleverantörer, tjänster och filhanterare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“集成”检查此副本的菜单提供方、“服务”和文件处理程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「整合功能」來檢查此副本的選單提供者、「服務」和檔案處理程式。"
          }
        }
      }
    },
    "Use MyMole's main Uninstall pane to remove a copy of MyMole." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende den Hauptbereich „Deinstallieren“ von MyMole, um eine Kopie von MyMole zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el panel Desinstalar principal de MyMole para eliminar una copia de MyMole."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la sous-fenêtre Désinstaller principale de MyMole pour supprimer une copie de MyMole."

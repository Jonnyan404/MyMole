    "Large lists set aside on disk are removed when they close and at the next launch. Timings stay in memory until you quit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Listen, die auf die Festplatte ausgelagert werden, werden beim Schließen und beim nächsten Start entfernt. Zeiten bleiben bis zum Beenden im Arbeitsspeicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas grandes apartadas en el disco se eliminan al cerrarse y en el siguiente inicio. Los tiempos permanecen en memoria hasta que sales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les grandes listes mises de côté sur le disque sont supprimées à leur fermeture et au lancement suivant. Les temps restent en mémoire jusqu’à ce que vous quittiez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क पर अलग रखी गई बड़ी सूचियाँ बंद होने पर और अगली बार खोलने पर हटा दी जाती हैं। समय तब तक मेमोरी में रहते हैं जब तक आप ऐप बंद नहीं करते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elenchi grandi messi da parte sul disco vengono rimossi quando si chiudono e all’avvio successivo. I tempi restano in memoria finché non esci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクに一時的に置かれた大きなリストは、閉じたときと次回の起動時に削除されます。計測した時間は終了するまでメモリーに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크에 따로 보관한 큰 목록은 닫을 때와 다음 실행 시 제거됩니다. 시간 측정은 종료할 때까지 메모리에만 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grote lijsten die op schijf zijn gezet, worden verwijderd wanneer ze worden gesloten en wanneer je de app weer opent. Tijdmetingen blijven in het geheugen totdat je MyMole stopt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas grandes postas de lado no disco são removidas quando são fechadas e na próxima abertura. Os tempos ficam na memória até você encerrar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stora listor som lagts undan på skivan tas bort när de stängs och vid nästa start. Tidsmätningar finns i minnet tills du avslutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂存到磁盘上的大型列表会在关闭时和下次启动时移除。耗时数据只保存在内存中，直到你退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫存到磁碟的大型列表會在關閉時和下次啟動時移除。計時資料會留在記憶體中，直到你結束MyMole。"
          }
        }
      }
    },

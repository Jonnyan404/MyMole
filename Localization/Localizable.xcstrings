    "On another disk than the copy that stays; clones share only on one disk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem anderen Laufwerk als die Kopie, die bleibt; Klone teilen nur auf einem Laufwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En otro disco que la copia que se queda; los clones solo comparten en un mismo disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un autre disque que la copie qui reste ; les clones ne partagent que sur un même disque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बनी रहने वाली प्रति से अलग डिस्क पर; क्लोन केवल एक ही डिस्क पर साझा करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un disco diverso da quello della copia che resta; i cloni condividono lo spazio solo su uno stesso disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残るコピーとは別のディスクにあります。クローンは同じディスク上でだけ共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남는 사본과 다른 디스크에 있습니다. 클론은 같은 디스크에서만 공유됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staat op een andere schijf dan het exemplaar dat blijft; klonen kunnen alleen op dezelfde schijf delen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em um disco diferente do da cópia que fica; os clones só compartilham em um mesmo disco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

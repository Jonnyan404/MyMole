          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppen i %@ – avsluta den först, annars fortsätter den skriva till filen i papperskorgen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 %1$@ 打开 —— 请先退出它，否则它会继续写入废纸篓中的文件"

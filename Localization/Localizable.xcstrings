    "Show MyMole in the menu bar Show free space beside the icon Open MyMole at login Open Login Items launch startup close window quit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole in der Menüleiste anzeigen Freien Speicher neben dem Symbol anzeigen MyMole bei der Anmeldung öffnen Anmeldeobjekte öffnen Start Starten Fenster schließen Beenden menu bar login launch quit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar MyMole en la barra de menús Mostrar el espacio libre junto al icono Abrir MyMole al iniciar sesión Abrir Ítems de inicio arranque inicio cerrar ventana salir menu bar login launch quit"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher MyMole dans la barre des menus Afficher l’espace libre à côté de l’icône Ouvrir MyMole à la connexion Ouvrir Ouverture lancement démarrage fermer la fenêtre quitter menu bar login launch quit"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेनू बार में MyMole दिखाएँ आइकन के पास खाली जगह दिखाएँ लॉगइन पर MyMole खोलें लॉगइन आइटम खोलें लॉन्च स्टार्टअप विंडो बंद करें बंद करें menu bar login launch quit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra MyMole nella barra dei menu Mostra lo spazio libero accanto all’icona Apri MyMole al login Apri Elementi login avvio chiudi finestra esci"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーにMyMoleを表示 アイコンの横に空き容量を表示 ログイン時にMyMoleを開く ログイン項目を開く 起動 スタートアップ 閉じる ウインドウ 終了"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대에 MyMole 표시 아이콘 옆에 사용 가능 공간 표시 로그인 시 MyMole 열기 로그인 항목 열기 실행 시동 윈도우 닫기 종료 menu bar login launch quit"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon MyMole in de menubalk Toon vrije ruimte naast het symbool Open MyMole bij inloggen Open Inlogonderdelen starten opstarten venster sluiten stoppen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o MyMole na barra de menus Mostrar espaço livre ao lado do ícone Abrir o MyMole ao iniciar a sessão Abrir Itens de Início de Sessão inicialização login fechar janela encerrar"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa MyMole i menyraden Visa ledigt utrymme bredvid symbolen Öppna MyMole vid inloggning Öppna Startobjekt start autostart stäng fönster avsluta"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏中显示 MyMole 在图标旁显示可用空间 登录时打开 MyMole 打开登录项 登录 启动 关闭窗口 退出"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列中顯示MyMole 在圖像旁顯示可用空間 在登入時打開MyMole 打開登入項目 啟動 開機 關閉視窗 結束"
          }
        }
      }
    },
    "Show MyMole's folder in Finder. Clear Saved Results in Loading and Memory removes the saved scans." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Ordner von MyMole im Finder. „Gesicherte Ergebnisse löschen“ unter „Laden und Arbeitsspeicher“ entfernt die gesicherten Scans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la carpeta de MyMole en el Finder. «Borrar resultados guardados», en Carga y memoria, elimina los escaneos guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le dossier de MyMole dans le Finder. « Effacer les résultats enregistrés », dans Chargement et mémoire, supprime les analyses enregistrées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole का फ़ोल्डर Finder में दिखाता है। लोडिंग और मेमोरी में “सहेजे गए परिणाम हटाएँ” सहेजे गए स्कैन हटाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la cartella di MyMole nel Finder. “Cancella risultati salvati” in “Caricamento e memoria” rimuove le scansioni salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMoleのフォルダをFinderに表示します。“読み込みとメモリー”の“保存された結果を消去”で、保存されたスキャンを削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder에서 MyMole 폴더를 보여 줍니다. 로딩 및 메모리의 ‘저장된 결과 지우기’는 저장된 스캔을 제거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon de map van MyMole in Finder. 'Wis bewaarde resultaten' in 'Laden en geheugen' verwijdert de bewaarde scans."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre a pasta do MyMole no Finder. Limpar Resultados Salvos em Carregamento e Memória remove as análises salvas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa MyMoles mapp i Finder. Rensa sparade resultat i Inläsning och minne tar bort de sparade skanningarna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在访达中显示 MyMole 的文件夹。“加载与内存”中的“清除已保存的结果”会移除已保存的扫描。"
          }
        },
        "zh-Hant" : {

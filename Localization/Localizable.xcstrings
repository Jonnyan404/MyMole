    "Printer drivers are shared by every printer of this maker. Remove a printer in System Settings > Printers & Scanners." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druckertreiber werden von allen Druckern dieses Herstellers geteilt. Entferne einen Drucker unter „Systemeinstellungen“ > „Drucker & Scanner“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los controladores de impresora los comparten todas las impresoras de ese fabricante. Elimina una impresora en Ajustes del Sistema > Impresoras y escáneres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pilotes d’imprimante sont partagés par toutes les imprimantes de ce fabricant. Supprimez une imprimante dans Réglages Système > Imprimantes et scanners."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रिंटर ड्राइवर इस निर्माता के हर प्रिंटर द्वारा साझा होते हैं। सिस्टम सेटिंग > प्रिंटर और स्कैनर में प्रिंटर हटाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I driver di stampa sono condivisi da tutte le stampanti di questo produttore. Rimuovi una stampante in Impostazioni di Sistema > Stampanti e scanner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリンタドライバは、同じメーカーのすべてのプリンタで共有されます。プリンタは、“システム設定”>“プリンタとスキャナ”で削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프린터 드라이버는 해당 제조사의 모든 프린터가 공유합니다. 시스템 설정 > 프린터 및 스캐너에서 프린터를 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Printerdrivers worden gedeeld door elke printer van deze maker. Verwijder een printer in Systeeminstellingen > Printers en scanners."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os drivers de impressora são compartilhados por todas as impressoras deste fabricante. Remova uma impressora em Ajustes do Sistema > Impressoras e Scanners."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivardrivrutiner delas av alla skrivare från tillverkaren. Ta bort en skrivare i Systeminställningar > Skrivare och skannrar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此厂商的所有打印机共用这些驱动。请在“系统设置”>“打印机与扫描仪”中移除打印机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "印表機驅動程式由此廠商的所有印表機共用。請在「系統設定」>「印表機與掃描器」中移除印表機。"
          }
        }
      }
    },

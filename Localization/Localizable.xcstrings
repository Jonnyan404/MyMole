              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "आपकी लाइब्रेरी के बाहर का %arg आइटम, जैसे लॉन्च जॉब या विशेषाधिकार वाला हेल्पर, हटाने के लिए एडमिनिस्ट्रेटर अधिकार चाहता है, जो App Store ऐप माँग नहीं सकते। MyMole का डायरेक्ट संस्करण इसे हटाता है, या आप इसे खुद हटा सकते हैं।"

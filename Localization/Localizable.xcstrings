                      "value" : "%arg sobra escolhida (%3$@) vai para o Lixo"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "As %arg sobras escolhidas (%3$@) vão para o Lixo"
                    }
                  }
                }
              }
            }
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n2@"
          },
          "substitutions" : {
            "n2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ blir kvar. Den %arg valda resten (%3$@) hamnar i papperskorgen, så att appen börjar om som vid första starten. Du kan ångra direkt efteråt."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ blir kvar. De %arg valda resterna (%3$@) hamnar i papperskorgen, så att appen börjar om som vid första starten. Du kan ångra direkt efteråt."
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ 保留。已选的 %arg 项残留（%3$@）移到废纸篓，因此它会像首次启动那样重新开始。你可以随后立即撤销。"
                    }

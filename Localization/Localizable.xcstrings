    "Deep Clean Keep List" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten-Liste der Tiefenreinigung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

          }
        }
      }
    },
    "The app's background agent couldn't be stopped (launchctl %d). The app stayed in place. Reopen the app if an earlier agent was stopped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrund-Agent der App konnte nicht gestoppt werden (launchctl %d). Die App ist geblieben. Öffne die App erneut, wenn ein früherer Agent gestoppt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo detener el agente en segundo plano de la app (launchctl %d). La app se quedó donde estaba. Vuelve a abrir la app si se detuvo un agente anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent d’arrière-plan de l’app n’a pas pu être arrêté (launchctl %d). L’app est restée en place. Rouvrez l’app si un agent précédent a été arrêté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का बैकग्राउंड एजेंट रोका नहीं जा सका (launchctl %d)। ऐप अपनी जगह रहा। अगर कोई पिछला एजेंट रोका गया था तो ऐप फिर से खोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile interrompere l’agente in background dell’app (launchctl %d). L’app è rimasta al suo posto. Riapri l’app se un agente precedente è stato interrotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのバックグラウンドエージェントを停止できませんでした（launchctl %d）。アプリは元の場所に残りました。先にエージェントが停止された場合は、アプリを再度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 백그라운드 에이전트를 중지할 수 없었습니다(launchctl %d). 앱은 그대로 남았습니다. 이전 에이전트가 중지되었다면 앱을 다시 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De achtergrondagent van de app kon niet worden gestopt (launchctl %d). De app is op zijn plaats gebleven. Open de app opnieuw als er eerder een agent is gestopt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível parar o agente em segundo plano do app (launchctl %d). O app continua no lugar. Reabra o app se um agente anterior tiver sido parado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens bakgrundsagent kunde inte stoppas (launchctl %d). Appen blev kvar på sin plats. Öppna appen igen om en tidigare agent stoppades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法停止该应用的自启动项（launchctl %d）。应用保持原位。如果之前的自启动项已被停止，请重新打开该应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法停止App的背景代理程式（launchctl %d）。App留在原處。若先前的代理程式已停止，請重新打開App。"
          }
        }
      }
    },
    "The app's bundled agents couldn't be read." : {
      "localizations" : {
        "de" : {

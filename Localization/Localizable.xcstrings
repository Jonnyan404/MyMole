    },
    "Keeps the disk map and recent charts ready, and repaints running scans five times a second." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die Festplattenkarte und aktuelle Diagramme bereit und zeichnet laufende Scans fünfmal pro Sekunde neu."

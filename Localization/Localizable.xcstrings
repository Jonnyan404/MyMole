    },
    "Uses the cores without crowding the apps you work in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt die Kerne, ohne die Apps zu bedrängen, mit denen du arbeitest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los núcleos sin estorbar a las apps con las que trabajas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise les cœurs sans gêner les apps avec lesquelles vous travaillez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन ऐप्स में आप काम करते हैं उन्हें परेशान किए बिना कोर उपयोग करता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 중인 앱을 방해하지 않고 코어를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用所有核心，但不会挤占你在用的应用。"
          }
        }
      }
    },
    "Uses the newest change found in each project, not the last time you opened its app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet die neueste Änderung in jedem Projekt, nicht das letzte Öffnen seiner App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el cambio más reciente encontrado en cada proyecto, no la última vez que abriste su app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la modification la plus récente trouvée dans chaque projet, pas la dernière ouverture de son app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर प्रोजेक्ट में मिला सबसे नया बदलाव उपयोग करता है, न कि उसका ऐप पिछली बार कब खोला।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 마지막으로 연 시점이 아니라 각 프로젝트에서 찾은 가장 최근 변경을 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用每个项目中查到的最新变更时间，而不是你上次打开其应用的时间。"
          }
        }
      }
    },

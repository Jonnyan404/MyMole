    "Saved disk map scans take %@ on disk; large lists kept on disk now take %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesicherte Scans der Festplattenkarte belegen %@ auf der Festplatte; auf der Festplatte gehaltene große Listen belegen jetzt %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved disk map scans take %1$@ on disk; large lists kept on disk now take %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los análisis guardados del mapa del disco ocupan %@ en el disco; las listas grandes guardadas en el disco ocupan ahora %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les analyses enregistrées de la carte du disque occupent %@ sur le disque ; les grosses listes gardées sur le disque occupent maintenant %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क मैप के सहेजे स्कैन डिस्क पर %@ लेते हैं; डिस्क पर रखी बड़ी सूचियाँ अभी %@ लेती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scansioni salvate della mappa del disco occupano %@ sul disco; gli elenchi grandi tenuti sul disco ora occupano %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたディスクマップのスキャンはディスクで%@、ディスクに置かれている大きなリストは現在%@を使用しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 맵의 저장된 스캔이 디스크에서 %@을(를) 차지하며, 디스크에 보관된 큰 목록이 현재 %@을(를) 차지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaarde scans van de schijfkaart nemen %@ op de schijf in; grote lijsten op de schijf nemen nu %@ in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As análises salvas do mapa do disco ocupam %@ no disco; as listas grandes guardadas em disco agora ocupam %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparade skanningar av lagringskartan tar %@ på skivan. Stora listor på skivan tar nu %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的磁盘图扫描占用 %1$@ 磁盘空间；目前保存在磁盘上的大列表占用 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的磁碟地圖掃描佔用磁碟上的%@；目前保存在磁碟上的大型列表佔用%@。"
          }
        }
      }
    },
    "Saved filters remember these criteria and the name filter for reuse. They don't save, move or delete files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesicherte Filter merken sich diese Kriterien und den Namensfilter zur Wiederverwendung. Sie sichern, bewegen oder löschen keine Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los filtros guardados recuerdan estos criterios y el filtro de nombre para reutilizarlos. No guardan, mueven ni eliminan archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les filtres enregistrés mémorisent ces critères et le filtre de nom pour les réutiliser. Ils n’enregistrent, ne déplacent ni ne suppriment de fichiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजे फ़िल्टर फिर से उपयोग के लिए ये मानदंड और नाम फ़िल्टर याद रखते हैं। वे फ़ाइलें सहेजते, ले जाते या हटाते नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I filtri salvati ricordano questi criteri e il filtro per nome per riutilizzarli. Non salvano, non spostano e non eliminano file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたフィルタは、これらの条件と名前のフィルタを記憶し、再利用できます。ファイルの保存、移動、削除は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 필터는 재사용을 위해 이 기준과 이름 필터를 기억합니다. 파일을 저장, 이동 또는 삭제하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaarde filters onthouden deze criteria en het naamfilter voor hergebruik. Ze bewaren, verplaatsen of verwijderen geen bestanden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os filtros salvos guardam estes critérios e o filtro de nome para reutilização. Eles não salvam, movem nem apagam arquivos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparade filter minns de här villkoren och namnfiltret så att de kan användas igen. De sparar, flyttar eller raderar inga filer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的筛选条件会记住这些条件与名称筛选，便于重复使用。它们不会保存、移动或删除文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的過濾條件會記住這些條件和名稱過濾條件，以供重複使用。不會儲存、搬移或刪除檔案。"
          }
        }
      }
    },

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッケージマネージャのダウンロードキャッシュとシミュレータのキャッシュです。次回のインストールに一度だけ時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패키지 관리자의 다운로드 캐시와 시뮬레이터 캐시입니다. 다음 설치가 한 번 더 느려집니다."

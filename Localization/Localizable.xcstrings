    "The app is kept, or its protection rules couldn't be read. Nothing was moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wird behalten, oder ihre Schutzregeln konnten nicht gelesen werden. Nichts wurde bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se conserva, o no se pudieron leer sus reglas de protección. No se movió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app est conservée, ou ses règles de protection n’ont pas pu être lues. Rien n’a été déplacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप रखा गया है, या इसके सुरक्षा नियम पढ़े नहीं जा सके। कुछ नहीं ले जाया गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app è conservata, oppure non è stato possibile leggerne le regole di protezione. Non è stato spostato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが保持されているか、保護のルールを読み取れませんでした。何も移動されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 보관되어 있거나 보호 규칙을 읽을 수 없었습니다. 아무것도 이동되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app wordt behouden of de beschermingsregels konden niet worden gelezen. Er is niets verplaatst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

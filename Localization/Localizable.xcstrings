    "Locked in Finder: unlocked right before it moves, and locked again if it stays" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Finder geschützt: direkt vor dem Bewegen entsperrt und wieder geschützt, falls es bleibt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado en el Finder: se desbloquea justo antes de moverse y se vuelve a bloquear si se queda"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

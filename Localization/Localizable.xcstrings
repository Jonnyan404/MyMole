    "On one of your keep lists, or holds something that is — will be skipped" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einer deiner Behalten-Listen oder enthält etwas, das darauf steht – wird übersprungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una de tus listas de conservación, o contiene algo que lo está; se omitirá"

    "System-wide caches need administrator rights; System Clean handles them" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemweite Caches brauchen Administratorrechte; die Systemreinigung kümmert sich darum"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cachés del sistema necesitan derechos de administrador; Limpieza del sistema se encarga de ellas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les caches système nécessitent les droits d’administrateur ; le nettoyage système s’en charge"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम-व्यापी कैश के लिए एडमिनिस्ट्रेटर अधिकार चाहिए; सिस्टम सफ़ाई इन्हें संभालती है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache a livello di sistema richiedono i diritti di amministratore; se ne occupa “Pulizia di sistema”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム全体のキャッシュには管理者権限が必要です。システムクリーンで処理します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 전체 캐시에는 관리자 권한이 필요하며 시스템 정리에서 처리합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor systeembrede caches zijn beheerdersrechten nodig; 'Systeemschoonmaak' handelt die af"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os caches de todo o sistema exigem direitos de administrador; a Limpeza do Sistema cuida deles"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemgemensamma cachar kräver administratörsrättigheter. Systemrensning tar hand om dem"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统级缓存需要管理员权限；“系统清理”会处理它们"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統層級的快取需要管理者權限；請使用「系統清理」處理"
          }
        }
      }
    },
    "System-wide deletion cannot be combined with unverified manual matches." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemweites Löschen kann nicht mit ungeprüften manuellen Übereinstimmungen kombiniert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación en todo el sistema no se puede combinar con coincidencias manuales sin verificar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression à l’échelle du système ne peut pas être combinée avec des correspondances manuelles non vérifiées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम-व्यापी हटाना असत्यापित मैनुअल मिलानों के साथ नहीं जोड़ा जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eliminazione a livello di sistema non può essere combinata con corrispondenze manuali non verificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム全体の削除は、手動で加えた未確認の一致と同時には行えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 전체 삭제는 확인되지 않은 수동 일치 항목과 함께 할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeembreed verwijderen kan niet worden gecombineerd met handmatig gekozen niet-geverifieerde overeenkomsten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar itens no nível do sistema não pode ser combinado com correspondências manuais não verificadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radering av systemgemensamma objekt kan inte kombineras med overifierade träffar som valts manuellt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统级删除无法与未核实的手动匹配同时进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統層級的刪除無法與未驗證的手動相符項目合併進行。"
          }
        }
      }
    },
    "System-wide leftovers can't be removed in this edition. Untick them to go on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemweite Reste können in dieser Edition nicht entfernt werden. Entferne ihre Markierung, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los restos de todo el sistema no se pueden eliminar en esta edición. Desmárcalos para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les restes à l’échelle du système ne peuvent pas être supprimés dans cette édition. Décochez-les pour continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस संस्करण में सिस्टम-व्यापी बचे हुए आइटम हटाए नहीं जा सकते। आगे बढ़ने के लिए इनका चिह्न हटाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I residui a livello di sistema non possono essere rimossi in questa edizione. Togli loro la spunta per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この版では、システム全体の残存ファイルを削除できません。続けるには、それらのチェックを外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 에디션에서는 시스템 전체 잔여 항목을 제거할 수 없습니다. 계속하려면 체크를 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeembrede restanten kunnen in deze editie niet worden verwijderd. Vink ze uit om door te gaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sobras no nível do sistema não podem ser removidas nesta edição. Desmarque-as para continuar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemgemensamma rester kan inte tas bort i den här utgåvan. Kryssa ur dem för att fortsätta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本无法移除系统级残留项。请取消勾选后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本無法移除系統層級的殘留項目。請取消勾選這些項目來繼續。"
          }
        }
      }
    },

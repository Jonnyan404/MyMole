        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시동 디스크의 Spotlight 색인을 지우고 다시 만듭니다. 한동안 검색이 불완전합니다."
          }
        },
        "nl" : {

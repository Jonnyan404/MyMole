    "Allow this copy to uninstall apps. macOS keeps this permission separate from Full Disk Access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube dieser Kopie, Apps zu deinstallieren. macOS hält diese Berechtigung getrennt vom Festplattenvollzugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que esta copia desinstale apps. macOS mantiene este permiso separado del acceso total al disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez cette copie à désinstaller des apps. macOS garde cette autorisation séparée de l’accès complet au disque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस कॉपी को ऐप अनइंस्टॉल करने दें। macOS यह अनुमति पूर्ण डिस्क ऐक्सेस से अलग रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a questa copia di disinstallare le app. macOS tiene questo permesso separato da “Accesso completo al disco”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコピーにアプリのアンインストールを許可します。macOSでは、このアクセス権はフルディスクアクセスとは別に管理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사본이 앱을 제거하도록 허용하세요. macOS는 이 권한을 전체 디스크 접근 권한과 별도로 관리합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta toe dat dit exemplaar apps deïnstalleert. macOS houdt deze toestemming gescheiden van Volledige schijftoegang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que esta cópia desinstale apps. O macOS mantém essa permissão separada do Acesso Total ao Disco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt den här kopian avinstallera appar. macOS håller den behörigheten skild från Full skivtillgång."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许这份副本卸载应用。macOS 将此项权限与“完全磁盘访问权限”分开管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許這份副本解除安裝App。macOS將此權限與「完全取用磁碟」分開管理。"
          }
        }
      }
    },
    "Already in the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits im Papierkorb."
          }
        },
        "es" : {
          "stringUnit" : {

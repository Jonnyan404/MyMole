          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件还有其他名称（硬链接），之后它们将不再是同一个文件。"
          }
        }
      }
    },
    "The folder couldn't be read." : {

    "1 system-wide item is deleted for good and can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 systemweites Objekt wird endgültig gelöscht und kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 elemento de todo el sistema se elimina definitivamente y no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 élément à l’échelle du système est supprimé définitivement, sans annulation possible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 सिस्टम-व्यापी आइटम स्थायी रूप से हटाया जाता है और पहले जैसा नहीं किया जा सकता।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 전체 항목 1개가 영구적으로 삭제되며 실행 취소할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 个系统级项目会被彻底删除，无法撤销。"
          }
        }
      }
    },
    "1 thing you left out inside them stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Objekt, das du darin ausgelassen hast, bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 cosa que dejaste fuera dentro de ellos se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 élément que vous avez exclu à l’intérieur reste en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनके अंदर आपका छोड़ा 1 आइटम बना रहता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

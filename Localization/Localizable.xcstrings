    "Sort the results below. A folder's date is the latest change anywhere inside it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortiere die Ergebnisse unten. Das Datum eines Ordners ist die neueste Änderung irgendwo darin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordena los resultados de abajo. La fecha de una carpeta es el cambio más reciente en cualquier parte de su contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triez les résultats ci-dessous. La date d’un dossier est la modification la plus récente à n’importe quel endroit de son contenu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे के परिणाम क्रमबद्ध करें। किसी फ़ोल्डर की तिथि उसके अंदर कहीं भी हुआ सबसे नया बदलाव है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordina i risultati qui sotto. La data di una cartella è quella dell’ultima modifica al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下の結果を並べ替えます。フォルダの日付は、その中のどこかで最後に変更された日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 결과를 정렬하세요. 폴더의 날짜는 그 안 어딘가에서 일어난 가장 최근 변경입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorteer de resultaten hieronder. De datum van een map is de laatste wijziging ergens daarin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordena os resultados abaixo. A data de uma pasta é a da alteração mais recente em qualquer lugar dentro dela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortera resultaten nedan. En mapps datum är den senaste ändringen någonstans i den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

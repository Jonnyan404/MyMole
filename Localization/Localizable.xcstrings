          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのアプリのキャッシュです。再生成されますが、先に再同期するものもあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 앱의 캐시입니다. 다시 만들어지지만 일부는 먼저 재동기화합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache van een van Apples apps. Wordt opnieuw opgebouwd, al synchroniseren sommige eerst opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

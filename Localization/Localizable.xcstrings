          "stringUnit" : {
            "state" : "translated",
            "value" : "名称、应用 ID 或路径"
          }
        }
      }
    },
    "Named in your settings at %@%@. MyMole doesn't change these files; edit them yourself if needed." : {
      "localizations" : {

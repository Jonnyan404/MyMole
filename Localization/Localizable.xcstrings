          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas grandes apartadas en el disco se eliminan al cerrarse y en el siguiente inicio. Los tiempos permanecen en memoria hasta que sales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les grandes listes mises de côté sur le disque sont supprimées à leur fermeture et au lancement suivant. Les temps restent en mémoire jusqu’à ce que vous quittiez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क पर अलग रखी गई बड़ी सूचियाँ बंद होने पर और अगली बार खोलने पर हटा दी जाती हैं। समय तब तक मेमोरी में रहते हैं जब तक आप ऐप बंद नहीं करते।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크에 따로 보관한 큰 목록은 닫을 때와 다음 실행 시 제거됩니다. 시간 측정은 종료할 때까지 메모리에만 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂存到磁盘上的大型列表会在关闭时和下次启动时移除。耗时数据只保存在内存中，直到你退出。"
          }
        }
      }
    },

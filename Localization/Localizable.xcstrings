    },
    "Identical duplicates" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identische Duplikate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicados idénticos"
          }
        },
        "fr" : {
          "stringUnit" : {

    "Give MyMole Full Disk Access or access to those folders, then scan again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewähre MyMole Festplattenvollzugriff oder Zugriff auf diese Ordner und scanne dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a MyMole acceso total al disco o acceso a esas carpetas y vuelve a analizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez à MyMole l’accès complet au disque ou l’accès à ces dossiers, puis relancez l’analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole को पूर्ण डिस्क ऐक्सेस या उन फ़ोल्डरों का ऐक्सेस दें, फिर से स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai a MyMole “Accesso completo al disco” o l’accesso a quelle cartelle, poi ripeti la scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMoleにフルディスクアクセスまたはこれらのフォルダへのアクセスを許可してから、もう一度スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole에 전체 디스크 접근 권한 또는 해당 폴더 접근 권한을 부여한 다음 다시 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef MyMole volledige schijftoegang of toegang tot die mappen en scan opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê ao MyMole o Acesso Total ao Disco ou acesso a essas pastas e analise novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge MyMole Full skivtillgång eller åtkomst till de mapparna och skanna sedan igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请授予 MyMole“完全磁盘访问权限”或对这些文件夹的访问权限，然后重新扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請授予MyMole「完全取用磁碟」權限或這些檔案夾的取用權限，然後再次掃描。"
          }
        }
      }
    },

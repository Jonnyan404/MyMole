    },
    "Only reads; the disk is busier while it runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest nur; die Festplatte ist während der Ausführung stärker belastet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lee; el disco está más ocupado mientras se ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture seule ; le disque est plus occupé pendant l’opération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल पढ़ता है; चलते समय डिस्क ज़्यादा व्यस्त रहती है।"
          }
        },
        "ko" : {
          "stringUnit" : {

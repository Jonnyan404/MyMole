            "value" : "Un ordenador completo con todo lo que tiene instalado. Elimínalo en %@, que también gestiona sus instantáneas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ordinateur entier avec tout ce qui y est installé. Supprimez-le dans %@, qui gère aussi ses instantanés."

    },
    "Drag to reorder %@. The Actions menu also offers Move Earlier and Move Later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um %@ neu anzuordnen. Das Menü „Aktionen“ bietet auch „Nach vorne“ und „Nach hinten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar %@. El menú Acciones también ofrece Mover antes y Mover después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réordonner %@. Le menu Actions propose aussi Avancer et Reculer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ का क्रम बदलने के लिए खींचें। क्रियाएँ मेनू में पहले ले जाएँ और बाद में ले जाएँ भी हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare %@. Anche il menu Azioni offre “Sposta prima” e “Sposta dopo”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして%@を並べ替えます。“操作”メニューの“前に移動”と“後ろに移動”も使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 %@의 순서를 바꾸세요. 동작 메뉴에도 앞으로 이동 및 뒤로 이동이 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om %@ te verplaatsen. Het taakmenu biedt ook 'Verplaats naar voren' en 'Verplaats naar achteren'."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar %@. O menu Ações também oferece Mover para Antes e Mover para Depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att flytta %@. Menyn Åtgärder har också Flytta tidigare och Flytta senare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动可调整 %1$@ 的顺序。“操作”菜单也提供“前移”和“后移”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

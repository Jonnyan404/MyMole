    "Use Uninstall MyMole in Settings to remove this running copy." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中使用“卸载 MyMole”来移除这份正在运行的副本。"

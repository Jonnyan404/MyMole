          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole tittade bara på de första %@ bilderna"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只查看了前 %1$@ 张照片"

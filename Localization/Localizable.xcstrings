    "The messages keep their attachments; Mail fetches one again when it's opened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die E-Mails behalten ihre Anhänge; Mail lädt einen erneut, wenn er geöffnet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes conservan sus adjuntos; Mail vuelve a descargar uno cuando se abre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages gardent leurs pièces jointes ; Mail en récupère une à nouveau quand elle est ouverte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदेश अपने अटैचमेंट रखते हैं; खोले जाने पर Mail उसे फिर से लाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi conservano i loro allegati; Mail ne recupera uno di nuovo quando viene aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージの添付ファイルは残ります。開くと、メールが再び取得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지는 첨부 파일을 유지하며, Mail은 열 때 다시 다운로드합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De berichten behouden hun bijlagen; Mail haalt er een opnieuw op wanneer je die opent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens mantêm seus anexos; o Mail busca um deles novamente quando é aberto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelandena behåller sina bilagor. Mail hämtar en bilaga igen när den öppnas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件本身仍保留附件；“邮件”会在打开时重新获取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "郵件會保留其附件；打開時，「郵件」會再次取得附件。"
          }
        }
      }
    },
    "The move was stopped or the app started. Nothing was moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bewegen wurde gestoppt oder die App wurde gestartet. Nichts wurde bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo el traslado o la app se inició. No se movió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déplacement a été arrêté ou l’app a démarré. Rien n’a été déplacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ले जाना रोका गया या ऐप शुरू हो गया। कुछ नहीं ले जाया गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spostamento è stato interrotto o l’app si è avviata. Non è stato spostato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動が停止されたか、アプリが起動しました。何も移動されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동이 중지되었거나 앱이 시작되었습니다. 아무것도 이동되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verplaatsen is gestopt of de app is gestart. Er is niets verplaatst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A movimentação foi interrompida ou o app foi aberto. Nada foi movido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytten stoppades eller så startade appen. Inget flyttades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动已停止，或应用已启动。没有移动任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搬移已停止，或App已啟動。未搬移任何項目。"
          }
        }
      }
    },
    "The new Trash could not be assigned to its user." : {
      "localizations" : {

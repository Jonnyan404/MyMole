    "%@ from %lld project(s):\n%@\n\nAnything holding a Git repository, key files, files Git tracks or uncommitted work stays. You can undo right after, or put things back from the Trash later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ aus %#@arg2@:\n%3$@\n\nAlles, was ein Git-Repository, Schlüsseldateien, von Git verfolgte Dateien oder nicht festgeschriebene Arbeit enthält, bleibt. Du kannst direkt danach widerrufen oder Objekte später aus dem Papierkorb zurücklegen."
          },
          "substitutions" : {
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Projekt"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Projekten"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ from %2$lld project(s):\n%3$@\n\nAnything holding a Git repository, key files, files Git tracks or uncommitted work stays. You can undo right after, or put things back from the Trash later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %#@arg2@:\n%3$@\n\nTodo lo que contenga un repositorio Git, archivos clave, archivos que Git sigue o trabajo sin confirmar se queda. Puedes deshacer justo después o recuperar las cosas de la Papelera más tarde."
          },
          "substitutions" : {
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg proyecto"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg proyectos"
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %#@arg2@ :\n%3$@\n\nTout ce qui contient un dépôt Git, des fichiers clés, des fichiers suivis par Git ou du travail non validé reste en place. Vous pouvez annuler juste après, ou remettre les éléments depuis la Corbeille plus tard."
          },
          "substitutions" : {
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg projet"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg projets"
                    }
                  }
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld प्रोजेक्ट से %1$@:\n%3$@\n\nजिसमें भी Git रिपॉज़िटरी, कुंजी फ़ाइलें, Git द्वारा ट्रैक की गई फ़ाइलें या बिना कमिट किया काम है, वह बना रहता है। आप तुरंत बाद पहले जैसा कर सकते हैं, या बाद में ट्रैश से चीज़ें वापस रख सकते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 %2$lld개의 %1$@:\n%3$@\n\nGit 저장소, 키 파일, Git이 추적하는 파일 또는 커밋되지 않은 작업이 있는 항목은 그대로 남습니다. 바로 실행 취소하거나 나중에 휴지통에서 되돌려 놓을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，来自 %2$lld 个项目：\n%3$@\n\n含 Git 仓库、密钥文件、Git 跟踪的文件或未提交改动的项目会保留。你可以随后立即撤销，也可以稍后从废纸篓放回。"
          }
        }
      }
    },

              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg residuo scelto (%2$@) va nel Cestino. L’app che vi si trova già non viene toccata. L’appartenenza e le regole “Conserva” vengono ricontrollate. Puoi annullare subito dopo."
                    }

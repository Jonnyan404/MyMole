    "App libraries, dependency folders, hidden folders and Git repositories are excluded. Add a folder of personal files to search there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Bibliotheken, Abhängigkeitsordner, ausgeblendete Ordner und Git-Repositorys sind ausgeschlossen. Füge einen Ordner mit persönlichen Dateien hinzu, um dort zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se excluyen las bibliotecas de apps, las carpetas de dependencias, las carpetas ocultas y los repositorios Git. Añade una carpeta de archivos personales para buscar en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bibliothèques d’apps, dossiers de dépendances, dossiers masqués et dépôts Git sont exclus. Ajoutez un dossier de fichiers personnels pour y chercher."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप लाइब्रेरी, डिपेंडेंसी फ़ोल्डर, छिपे फ़ोल्डर और Git रिपॉज़िटरी बाहर रखे गए हैं। वहाँ खोजने के लिए निजी फ़ाइलों का फ़ोल्डर जोड़ें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 라이브러리, 종속성 폴더, 숨겨진 폴더 및 Git 저장소는 제외됩니다. 개인 파일이 있는 폴더를 추가하면 그곳을 검색합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用资源库、依赖文件夹、隐藏文件夹和 Git 仓库会被排除。可添加一个个人文件文件夹，在那里搜索。"
          }
        }
      }
    },
    "App metadata is read inside this folder, including build outputs. App bundles aren't searched for nested copies; dependency and version-control folders are skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Metadaten werden in diesem Ordner gelesen, auch in Build-Ausgaben. App-Bundles werden nicht nach verschachtelten Kopien durchsucht; Abhängigkeits- und Versionskontrollordner werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los metadatos de apps se leen dentro de esta carpeta, incluidos los resultados de compilación. No se buscan copias anidadas dentro de los paquetes de apps; se omiten las carpetas de dependencias y de control de versiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées d’app sont lues dans ce dossier, y compris les résultats de compilation. Les paquets d’apps ne sont pas fouillés à la recherche de copies imbriquées ; les dossiers de dépendances et de contrôle de version sont ignorés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ोल्डर के अंदर ऐप मेटाडेटा पढ़ा जाता है, बिल्ड आउटपुट समेत। ऐप बंडल में नेस्टेड कॉपियाँ नहीं खोजी जातीं; डिपेंडेंसी और वर्ज़न-कंट्रोल फ़ोल्डर छोड़ दिए जाते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌드 결과물을 포함해 이 폴더 안의 앱 메타데이터를 읽습니다. 앱 번들 안의 중첩된 사본은 검색하지 않으며, 종속성 및 버전 관리 폴더는 건너뜁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会在此文件夹内读取应用元数据，包括构建产物。不会在应用包内搜索嵌套副本；依赖与版本控制文件夹会被跳过。"
          }
        }
      }
    },
    "App metadata or protections are not a bounded regular file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Metadaten oder Schutzregeln sind keine reguläre Datei begrenzter Größe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los metadatos de la app o las protecciones no son un archivo normal de tamaño limitado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées de l’app ou les protections ne sont pas un fichier ordinaire de taille limitée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप मेटाडेटा या सुरक्षाएँ सीमित आकार की सामान्य फ़ाइल नहीं हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 메타데이터 또는 보호 규칙이 크기가 제한된 일반 파일이 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用元数据或保护规则不是大小受限的普通文件。"
          }
        }
      }
    },
    "App metadata or protections changed while being read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Metadaten oder Schutzregeln haben sich beim Lesen geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los metadatos de la app o las protecciones cambiaron mientras se leían."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées de l’app ou les protections ont changé pendant la lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पढ़ते समय ऐप मेटाडेटा या सुरक्षाएँ बदल गईं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽는 동안 앱 메타데이터 또는 보호 규칙이 변경되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取期间应用元数据或保护规则发生了变化。"
          }
        }
      }
    },
    "App metadata or protections could not be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Metadaten oder Schutzregeln konnten nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los metadatos de la app ni las protecciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées de l’app ou les protections n’ont pas pu être lues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप मेटाडेटा या सुरक्षाएँ पढ़ी नहीं जा सकीं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 메타데이터 또는 보호 규칙을 읽을 수 없었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取应用元数据或保护规则。"
          }
        }
      }
    },
    "App ownership could not be revalidated after the move. System files stayed in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zugehörigkeit zur App konnte nach dem Bewegen nicht erneut geprüft werden. Systemdateien sind geblieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo volver a validar a qué app pertenecen tras el traslado. Los archivos del sistema se quedaron donde estaban."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appartenance à l’app n’a pas pu être revérifiée après le déplacement. Les fichiers système sont restés en place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ले जाने के बाद ऐप स्वामित्व की फिर से पुष्टि नहीं हो सकी। सिस्टम फ़ाइलें अपनी जगह रहीं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동 후 앱 소유권을 다시 확인할 수 없었습니다. 시스템 파일은 그대로 남았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动后无法重新核实应用归属。系统文件保持在原位。"
          }
        }
      }
    },

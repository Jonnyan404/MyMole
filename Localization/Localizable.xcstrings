        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo tiene otros nombres (enlaces duros), que dejarían de ser el mismo archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier a d’autres noms (liens physiques), qui ne seraient plus le même fichier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल के दूसरे नाम (हार्ड लिंक) हैं, जो फिर वही फ़ाइल नहीं रहेंगे।"
          }
        },
        "ko" : {
          "stringUnit" : {

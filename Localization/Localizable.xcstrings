    "An earlier system task may still be running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine frühere Systemaufgabe läuft eventuell noch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que una tarea del sistema anterior siga en curso."
          }
        },

        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "चुना गया %arg बचा हुआ आइटम (%2$@) रद्दी में जाता है। वहाँ पहले से मौजूद ऐप को छुआ नहीं जाता। स्वामित्व और रखें नियम फिर से जाँचे जाते हैं। आप तुरंत बाद पहले जैसा कर सकते हैं।"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "चुने गए %arg बचे हुए आइटम (%2$@) रद्दी में जाते हैं। वहाँ पहले से मौजूद ऐप को छुआ नहीं जाता। स्वामित्व और रखें नियम फिर से जाँचे जाते हैं। आप तुरंत बाद पहले जैसा कर सकते हैं।"

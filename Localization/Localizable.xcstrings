    "Your caches and logs are already tidy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Caches und Protokolle sind bereits aufgeräumt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cachés y registros ya están en orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos caches et journaux sont déjà en ordre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके कैश और लॉग पहले से साफ़-सुथरे हैं।"
          }
        },
        "it" : {
          "stringUnit" : {

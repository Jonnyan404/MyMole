          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen behålls, eller så kunde dess skyddsregler inte läsas. Inget flyttades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

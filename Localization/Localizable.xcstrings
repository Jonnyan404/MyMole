    "Containers, caches and settings of builds of this app. Removing them resets that app's data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Container, Caches und Einstellungen von Builds dieser App. Das Entfernen setzt die Daten dieser App zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contenedores, cachés y ajustes de las compilaciones de esta app. Eliminarlos restablece los datos de esa app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteneurs, caches et réglages des compilations de cette app. Les supprimer réinitialise les données de cette app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऐप के बिल्ड के कंटेनर, कैश और सेटिंग्ज़। इन्हें हटाने से उस ऐप का डेटा रीसेट हो जाता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱 빌드의 컨테이너, 캐시 및 설정입니다. 제거하면 해당 앱의 데이터가 재설정됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用各构建的容器、缓存和设置。移除后该应用的数据会被重置。"
          }
        }
      }
    },

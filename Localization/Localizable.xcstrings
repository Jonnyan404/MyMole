    "AVG's own uninstaller, from the AVG AntiVirus menu. It also removes its protection, which runs as a system extension." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVGs eigenes Deinstallationsprogramm, im Menü von AVG AntiVirus. Es entfernt auch den Schutz, der als Systemerweiterung läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desinstalador propio de AVG, en el menú de AVG AntiVirus. También elimina su protección, que funciona como extensión del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme de désinstallation d'AVG, dans le menu d'AVG AntiVirus. Il supprime aussi sa protection, qui fonctionne comme extension système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVG का अपना अनइंस्टॉलर, AVG AntiVirus के मेनू से। यह इसकी सुरक्षा भी हटाता है, जो सिस्टम एक्सटेंशन के रूप में चलती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma di disinstallazione di AVG, dal menu di AVG AntiVirus. Rimuove anche la sua protezione, che funziona come estensione di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVG AntiVirusのメニューにある、AVG自身のアンインストーラです。システム機能拡張として動作する保護機能も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVG AntiVirus 메뉴에 있는 AVG 자체 제거 프로그램입니다. 시스템 확장 프로그램으로 실행되는 보호 기능도 함께 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het eigen deïnstallatieprogramma van AVG, in het menu van AVG AntiVirus. Hiermee wordt ook de beveiliging verwijderd, die als systeemextensie actief is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desinstalador da própria AVG, no menu do AVG AntiVirus. Ele também remove a proteção, que é executada como extensão do sistema."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVG:s eget avinstallationsprogram, från menyn AVG AntiVirus. Det tar även bort dess skydd, som körs som ett systemtillägg."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVG 自带的卸载程序，位于 AVG AntiVirus 的菜单中。它还会移除以系统扩展运行的防护功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVG自己的解除安裝程式，位於AVG AntiVirus選單中。它也會移除其以系統延伸功能執行的防護。"
          }
        }
      }
    },

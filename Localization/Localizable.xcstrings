    "Show MyMole's folder in Finder. Clear Saved Results in Loading and Memory removes the saved scans." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Ordner von MyMole im Finder. „Gesicherte Ergebnisse löschen“ unter „Laden und Arbeitsspeicher“ entfernt die gesicherten Scans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la carpeta de MyMole en el Finder. «Borrar resultados guardados», en Carga y memoria, elimina los escaneos guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le dossier de MyMole dans le Finder. « Effacer les résultats enregistrés », dans Chargement et mémoire, supprime les analyses enregistrées."

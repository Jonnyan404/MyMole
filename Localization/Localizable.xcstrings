          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क मैप और हाल के चार्ट तैयार रखता है, और चल रहे स्कैन पाँच बार प्रति सेकंड बनाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene pronti la mappa del disco e i grafici recenti e ridisegna le scansioni in corso cinque volte al secondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクマップと最近のチャートを用意しておき、実行中のスキャンを1秒に5回再描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 맵과 최근 차트를 준비해 두고 진행 중인 스캔을 초당 다섯 번 다시 그립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt de schijfkaart en recente diagrammen klaar en tekent actieve scans vijf keer per seconde opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

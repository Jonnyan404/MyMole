    "Your keep list couldn't be read (%@). Nothing is moved until it can be." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Behalten-Liste konnte nicht gelesen werden (%@). Nichts wird bewegt, bis sie gelesen werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer tu lista de conservación (%@). No se mueve nada hasta que se pueda leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre liste de conservation n’a pas pu être lue (%@). Rien n’est déplacé tant qu’elle ne peut pas l’être."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रखें-सूची पढ़ी नहीं जा सकी (%@)। जब तक पढ़ी न जा सके, कुछ नहीं ले जाया जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere l’elenco “Conserva” (%@). Finché non sarà possibile, non verrà spostato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持リストを読み取れませんでした（%@）。読み取れるようになるまで何も移動されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관 목록을 읽을 수 없습니다(%@). 읽을 수 있을 때까지 아무것도 이동되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je behoudlijst kon niet worden gelezen (%@). Er wordt niets verplaatst totdat dat wel kan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler sua lista de mantidos (%@). Nada é movido até que ela possa ser lida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Behåll-lista kunde inte läsas (%@). Inget flyttas förrän den kan läsas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取你的保留清单（%1$@）。在能读取之前，不会移动任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取你的保留列表（%@）。在可以讀取之前，不會搬移任何項目。"
          }
        }
      }
    },

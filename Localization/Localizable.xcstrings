      }
    },
    "An old modification date doesn't mean a file is safe to remove." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein altes Änderungsdatum bedeutet nicht, dass eine Datei gefahrlos entfernt werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fecha de modificación antigua no significa que sea seguro eliminar un archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une date de modification ancienne ne signifie pas qu’un fichier peut être supprimé sans risque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुरानी संशोधन तिथि का मतलब यह नहीं कि फ़ाइल हटाना सुरक्षित है।"

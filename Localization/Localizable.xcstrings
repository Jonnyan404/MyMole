    "Whitelist everything named “%@”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles namens „%@“ auf die weiße Liste setzen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir a la lista blanca todo lo que se llame “%@”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre en liste blanche tout ce qui s’appelle « %@ »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” नाम की हर चीज़ व्हाइटलिस्ट करें"
          }
        },
        "it" : {
          "stringUnit" : {

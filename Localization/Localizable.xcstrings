          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“システム設定”→“一般”→“ログイン項目”でMyMoleを許可してください。macOSが許可を待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 시스템 설정 → 일반 → 로그인 항목에서 MyMole 허용을 기다리고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wacht tot je MyMole toestaat in Systeeminstellingen → Algemeen → Inlogonderdelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

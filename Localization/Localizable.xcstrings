    "Shared by Creative Cloud and every Adobe app. Use Adobe's Creative Cloud uninstaller or Cleaner Tool." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsam genutzt von Creative Cloud und jeder Adobe-App. Verwende das Deinstallationsprogramm von Creative Cloud oder das Cleaner Tool von Adobe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartido por Creative Cloud y todas las apps de Adobe. Usa el desinstalador de Creative Cloud o el Cleaner Tool de Adobe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagé par Creative Cloud et toutes les apps Adobe. Utilisez le programme de désinstallation de Creative Cloud ou le Cleaner Tool d’Adobe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creative Cloud और हर Adobe ऐप द्वारा साझा। Adobe का Creative Cloud अनइंस्टॉलर या Cleaner Tool उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condiviso da Creative Cloud e da ogni app Adobe. Usa il programma di disinstallazione di Creative Cloud o Cleaner Tool di Adobe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creative CloudとすべてのAdobeアプリで共有されています。AdobeのCreative CloudアンインストーラまたはCleaner Toolを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creative Cloud와 모든 Adobe 앱이 공유합니다. Adobe의 Creative Cloud 제거 프로그램이나 Cleaner Tool을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedeeld door Creative Cloud en elke Adobe-app. Gebruik het deïnstallatieprogramma van Creative Cloud of Cleaner Tool van Adobe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhado pelo Creative Cloud e por todos os apps da Adobe. Use o desinstalador do Creative Cloud ou a Cleaner Tool da Adobe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delas av Creative Cloud och alla Adobe-appar. Använd Adobes avinstallationsprogram för Creative Cloud eller Cleaner Tool."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creative Cloud 与所有 Adobe 应用共用。请使用 Adobe 的 Creative Cloud 卸载程序或 Cleaner Tool。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由Creative Cloud和所有Adobe App共用。請使用Adobe的Creative Cloud解除安裝程式或Cleaner Tool。"
          }
        }
      }
    },
    "Shared data is chosen. The developer's other apps may use it too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsame Daten sind ausgewählt. Die anderen Apps des Entwicklers verwenden sie eventuell auch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay datos compartidos elegidos. Las otras apps del desarrollador también pueden usarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des données partagées sont choisies. Les autres apps du développeur peuvent aussi les utiliser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा डेटा चुना गया है। डेवलपर के अन्य ऐप भी इसका उपयोग कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono scelti dati condivisi. Potrebbero usarli anche le altre app dello sviluppatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有データが対象に含まれています。デベロッパのほかのアプリも使っている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 데이터가 선택되었습니다. 개발자의 다른 앱도 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn gedeelde gegevens gekozen. Andere apps van de ontwikkelaar gebruiken die mogelijk ook."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há dados compartilhados escolhidos. Os outros apps do desenvolvedor também podem usá-los."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delade data är valda. Utvecklarens andra appar kan också använda dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已选择共享数据。该开发者的其他应用可能也会使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已選擇共用資料。開發者的其他App可能也會使用。"
          }
        }
      }
    },

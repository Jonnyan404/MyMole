        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helfer aktiviert – genehmigte Aufgaben brauchen nicht jedes Mal ein Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistente activado: las tareas aprobadas no piden contraseña cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant activé — les tâches approuvées ne demandent pas de mot de passe à chaque fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हेल्पर चालू — स्वीकृत कार्यों को हर बार पासवर्ड की ज़रूरत नहीं होती।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도우미 켜짐 — 승인된 작업은 매번 암호가 필요하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助程序已启用 —— 已批准的任务无需每次输入密码。"
          }
        }
      }
    },
    "Here's how your Mac is doing" : {

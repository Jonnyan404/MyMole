        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía la caché DNS, para sitios web que no cargan o que aún apuntan a una dirección antigua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide le cache DNS, pour les sites web qui ne se chargent pas ou pointent encore vers une ancienne adresse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS कैश साफ़ करता है, उन वेबसाइटों के लिए जो लोड नहीं होतीं या अभी भी पुराने पते पर जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella la cache DNS, per i siti web che non si caricano o che puntano ancora a un vecchio indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込めないWebサイトや、古いアドレスのままのWebサイトのために、DNSキャッシュを消去します。"

        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली बार आने पर साइटें अपना पता फिर से खोजती हैं। पहले जैसा करने को कुछ नहीं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 방문 시 사이트 주소를 다시 조회합니다. 실행 취소할 것이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

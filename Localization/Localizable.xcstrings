    "Its Git folder couldn't be read, so it wasn't checked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Git-Ordner konnte nicht gelesen werden, daher wurde es nicht geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer su carpeta Git, así que no se comprobó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son dossier Git n’a pas pu être lu, il n’a donc pas été vérifié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका Git फ़ोल्डर पढ़ा नहीं जा सका, इसलिए इसकी जाँच नहीं हुई।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere la sua cartella Git, quindi non è stato controllato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitフォルダを読み取れなかったため、確認されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 폴더를 읽을 수 없어 확인하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Git-map kon niet worden gelezen, dus dit is niet gecontroleerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a pasta Git dele, por isso ele não foi verificado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess Git-mapp kunde inte läsas, så det kontrollerades inte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取它的 Git 文件夹，因此未检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取其Git檔案夾，因此未檢查。"
          }
        }
      }
    },
    "Its Git settings could run programs, so it wasn't checked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Git-Einstellungen könnten Programme ausführen, daher wurde es nicht geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus ajustes de Git podrían ejecutar programas, así que no se comprobó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses réglages Git pourraient exécuter des programmes, il n’a donc pas été vérifié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी Git सेटिंग्ज़ प्रोग्राम चला सकती थीं, इसलिए इसकी जाँच नहीं हुई।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

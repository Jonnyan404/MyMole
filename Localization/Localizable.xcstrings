    "Included with %@. Unchoose the containing folder before choosing individual items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ enthalten. Hebe die Auswahl des übergeordneten Ordners auf, bevor du einzelne Objekte auswählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluido con %@. Quita la carpeta contenedora de la elección antes de elegir elementos individuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclus avec %@. Retirez le dossier parent du choix avant de choisir des éléments individuels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के साथ शामिल। अलग आइटम चुनने से पहले उसके फ़ोल्डर का चयन हटाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso con %@. Togli dalla scelta la cartella che li contiene prima di scegliere singoli elementi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に含まれています。個別の項目を対象に追加するには、先に内包しているフォルダを対象から外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 포함됨. 개별 항목을 선택하기 전에 상위 폴더 선택을 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inbegrepen bij %@. Haal de bovenliggende map uit de keuze voordat je afzonderlijke onderdelen kiest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluído com %@. Cancele a escolha da pasta superior antes de escolher itens individuais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingår i %@. Välj bort den överordnade mappen innan du väljer enskilda objekt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已随 %1$@ 一起包含。请先取消选择所属文件夹，再单独选择项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已包含在「%@」中。選擇個別項目前，請先取消選擇上層檔案夾。"
          }
        }
      }
    },
    "Included with a chosen folder. Unchoose the containing folder before changing these items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einem ausgewählten Ordner enthalten. Hebe die Auswahl des übergeordneten Ordners auf, bevor du diese Objekte änderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluido con una carpeta elegida. Quita la carpeta contenedora de la elección antes de cambiar estos elementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclus avec un dossier choisi. Retirez le dossier parent du choix avant de modifier ces éléments."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुने गए फ़ोल्डर के साथ शामिल। इन आइटम को बदलने से पहले उसके फ़ोल्डर का चयन हटाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso con una cartella scelta. Togli dalla scelta la cartella che li contiene prima di cambiare questi elementi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象のフォルダに含まれています。これらの項目を変更するには、先に内包しているフォルダを対象から外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폴더에 포함됨. 이 항목을 변경하기 전에 상위 폴더 선택을 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inbegrepen bij een gekozen map. Haal de bovenliggende map uit de keuze voordat je deze onderdelen wijzigt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluído com uma pasta escolhida. Cancele a escolha da pasta superior antes de mudar estes itens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingår i en vald mapp. Välj bort den överordnade mappen innan du ändrar de här objekten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已随所选文件夹一起包含。请先取消选择所属文件夹，再更改这些项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已包含在選擇的檔案夾中。更改這些項目前，請先取消選擇上層檔案夾。"
          }
        }
      }
    },
    "Includes small downloads too. Opens a separate review; nothing is chosen for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt auch kleine Downloads ein. Öffnet eine eigene Prüfung; nichts wird für dich ausgewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También incluye descargas pequeñas. Abre una revisión aparte; no se elige nada por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclut aussi les petits téléchargements. Ouvre un examen séparé ; rien n’est choisi pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटे डाउनलोड भी शामिल हैं। एक अलग समीक्षा खुलती है; आपके लिए कुछ नहीं चुना जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include anche i download piccoli. Apre una revisione separata; nulla viene scelto automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さいダウンロードも含みます。別の確認画面が開きます。自動で対象になるものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 다운로드도 포함합니다. 별도의 검토가 열리며 자동으로 선택되는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omvat ook kleine downloads. Opent een apart overzicht; er wordt niets voor je gekozen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui também downloads pequenos. Abre uma revisão separada; nada é escolhido automaticamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar även med små hämtade filer. Öppnar en separat granskning. Inget väljs åt dig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也包含小体积的下载项。会打开单独的检查界面；不会替你勾选任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也包括較小的下載項目。會打開另外的檢視畫面；不會自動為你選擇任何項目。"
          }
        }
      }
    },

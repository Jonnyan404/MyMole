    "Search stopped. Earlier complete results remain; a first search may show only the apps found before Stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche gestoppt. Frühere vollständige Ergebnisse bleiben; eine erste Suche zeigt eventuell nur die Apps, die vor dem Stoppen gefunden wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Búsqueda detenida. Se mantienen los resultados completos anteriores; una primera búsqueda puede mostrar solo las apps encontradas antes de detenerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche arrêtée. Les résultats complets antérieurs restent ; une première recherche peut n’afficher que les apps trouvées avant l’arrêt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज रोकी गई। पहले के पूरे परिणाम बने रहते हैं; पहली खोज में केवल रोकने से पहले मिले ऐप दिख सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca interrotta. I risultati completi precedenti restano; una prima ricerca potrebbe mostrare solo le app trovate prima dell’interruzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索を停止しました。以前の完全な結果は残ります。初めての検索では、停止までに見つかったアプリだけが表示されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 중지됨. 이전의 전체 결과는 남으며, 첫 검색에서는 중지 전에 찾은 앱만 표시될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoeken gestopt. Eerdere volledige resultaten blijven staan; een eerste zoekactie toont mogelijk alleen de apps die vóór het stoppen zijn gevonden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca interrompida. Os resultados completos anteriores permanecem; uma primeira busca pode mostrar apenas os apps encontrados antes de Parar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökningen stoppades. Tidigare fullständiga resultat finns kvar. En första sökning visar kanske bara apparna som hittades före Stoppa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索已停止。此前完整的结果仍保留；首次搜索可能只显示停止前找到的应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋已停止。先前的完整結果會保留；首次搜尋可能只會顯示停止前找到的App。"
          }
        }
      }
    },

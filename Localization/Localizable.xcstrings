    "%@ from %lld project(s):\n%@\n\nAnything holding a Git repository, key files, files Git tracks or uncommitted work stays. You can undo right after, or put things back from the Trash later." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ from %2$lld project(s):\n%3$@\n\nAnything holding a Git repository, key files, files Git tracks or uncommitted work stays. You can undo right after, or put things back from the Trash later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，来自 %2$lld 个项目：\n%3$@\n\n含 Git 仓库、密钥文件、Git 跟踪的文件或未提交改动的项目会保留。你可以随后立即撤销，也可以稍后从废纸篓放回。"
          }
        }
      }
    },
    "%@ has kept the processor busy" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 一直占用处理器"

    "Undo puts back the last %lld moves of each pane until you quit; after that, Finder's Put Back still works for what is in the Trash. Items moved to the Trash take space until it's emptied. History keeps only counts and sizes, never file names." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Widerrufen“ legt %#@arg1@ jedes Bereichs zurück, bis du beendest; danach funktioniert „Zurücklegen“ im Finder weiterhin für das, was im Papierkorb ist. In den Papierkorb gelegte Objekte belegen Platz, bis er entleert wird. Der Verlauf speichert nur Anzahlen und Größen, nie Dateinamen."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "die letzte Bewegung"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "die letzten %arg Bewegungen"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Undo puts back the last move of each pane until you quit; after that, Finder's Put Back still works for what is in the Trash. Items moved to the Trash take space until it's emptied. History keeps only counts and sizes, never file names."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Undo puts back the last %arg moves of each pane until you quit; after that, Finder's Put Back still works for what is in the Trash. Items moved to the Trash take space until it's emptied. History keeps only counts and sizes, never file names."
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshacer devuelve %#@arg1@ de cada panel hasta que cierres la app; después, Devolver del Finder sigue funcionando para lo que está en la Papelera. Los elementos trasladados a la Papelera ocupan espacio hasta que se vacía. El historial solo guarda cantidades y tamaños, nunca nombres de archivo."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "el último traslado"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "los últimos %arg traslados"
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler remet %#@arg1@ de chaque sous-fenêtre jusqu’à ce que vous quittiez ; ensuite, Remettre du Finder fonctionne toujours pour ce qui est dans la Corbeille. Les éléments placés dans la Corbeille occupent de l’espace jusqu’à ce qu’elle soit vidée. L’historique ne garde que des nombres et des tailles, jamais de noms de fichiers."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "le dernier déplacement"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "les %arg derniers déplacements"
                    }
                  }
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले जैसा करें, बंद करने तक हर पैन की पिछली %lld चालें वापस रखता है; उसके बाद भी ट्रैश में मौजूद चीज़ों के लिए Finder का वापस रखें काम करता है। ट्रैश में ले जाए आइटम उसके खाली होने तक जगह लेते हैं। इतिहास केवल गिनती और आकार रखता है, कभी फ़ाइल नाम नहीं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 취소는 종료할 때까지 각 패널의 마지막 이동 %lld개를 되돌립니다. 그 후에도 휴지통에 있는 항목은 Finder의 되돌려 놓기로 복원할 수 있습니다. 휴지통으로 이동한 항목은 비울 때까지 공간을 차지합니다. 기록에는 개수와 크기만 저장되며 파일 이름은 저장되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你退出前，撤销可以放回各面板最近 %1$lld 次移动的内容；退出后，对废纸篓中的内容仍可使用访达的“放回原处”。移到废纸篓的项目在清空之前仍占空间。历史只保留数量和大小，从不记录文件名。"
          }
        }
      }
    },
    "Undo puts them back." : {
      "localizations" : {

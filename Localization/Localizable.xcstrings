    "What's in %@ isn't listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt von %@ wird nicht aufgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido de %@ no aparece en la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu de %@ n’est pas listé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ की सामग्री सूचीबद्ध नहीं है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 내용은 표시되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中的内容不会列出。"
          }
        }
      }
    },
    "What's in %@ isn't listed. The result isn't saved as complete; give MyMole Full Disk Access or scan again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt von %@ wird nicht aufgeführt. Das Ergebnis wird nicht als vollständig gesichert; gewähre MyMole Festplattenvollzugriff oder scanne erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido de %@ no aparece en la lista. El resultado no se guarda como completo; da a MyMole acceso total al disco o vuelve a analizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu de %@ n’est pas listé. Le résultat n’est pas enregistré comme complet ; donnez à MyMole l’accès complet au disque ou relancez l’analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ की सामग्री सूचीबद्ध नहीं है। परिणाम पूरा मानकर सहेजा नहीं गया; MyMole को पूर्ण डिस्क ऐक्सेस दें या फिर से स्कैन करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 내용은 표시되지 않습니다. 결과가 완전한 것으로 저장되지 않으니 MyMole에 전체 디스크 접근 권한을 부여하거나 다시 스캔하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中的内容不会列出。该结果不会保存为完整结果；请授予 MyMole“完全磁盘访问”或重新扫描。"
          }
        }
      }
    },
    "What's on screen stays until you quit. After the next launch each pane scans afresh. Keep lists, project rules and History aren't touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was auf dem Bildschirm ist, bleibt bis zum Beenden. Nach dem nächsten Start scannt jeder Bereich neu. Behalten-Listen, Projektregeln und Verlauf bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que hay en pantalla se queda hasta que cierres la app. Tras la próxima apertura, cada panel analiza de nuevo. Las listas de conservación, las reglas de proyecto y el Historial no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est à l’écran reste jusqu’à ce que vous quittiez. Après le prochain lancement, chaque sous-fenêtre analyse à neuf. Les listes de conservation, règles de projet et l’Historique ne sont pas touchés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन पर जो है वह बंद करने तक रहता है। अगले लॉन्च के बाद हर पैन नए सिरे से स्कैन करता है। रखें-सूचियाँ, प्रोजेक्ट नियम और इतिहास को छुआ नहीं जाता।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면의 내용은 종료할 때까지 유지됩니다. 다음 실행 후 각 패널이 새로 스캔합니다. 보관 목록, 프로젝트 규칙 및 기록은 건드리지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕上的内容会保留到你退出为止。下次启动后，每个面板会重新扫描。保留清单、项目规则和历史不受影响。"
          }
        }
      }
    },
    "What's on the disk but isn't in this map" : {

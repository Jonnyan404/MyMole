    "Debug symbols for one device's OS version. Copied again when that device connects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugsymbole für die OS-Version eines Geräts. Werden erneut kopiert, wenn dieses Gerät verbunden wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Símbolos de depuración para la versión del sistema de un dispositivo. Se vuelven a copiar cuando ese dispositivo se conecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symboles de débogage pour la version de l’OS d’un appareil. Recopiés quand cet appareil se connecte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी डिवाइस के OS संस्करण के डीबग सिंबल। वह डिवाइस जुड़ने पर फिर से कॉपी होते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simboli di debug per la versione del sistema operativo di un dispositivo. Vengono copiati di nuovo quando quel dispositivo si collega."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つのデバイスのOSバージョン用のデバッグシンボルです。そのデバイスを接続すると再びコピーされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 기기의 OS 버전에 대한 디버그 기호입니다. 해당 기기를 연결하면 다시 복사됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugsymbolen voor de OS-versie van één apparaat. Worden opnieuw gekopieerd wanneer dat apparaat verbinding maakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Símbolos de depuração da versão do sistema de um dispositivo. Copiados novamente quando esse dispositivo se conecta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felsökningssymboler för en enhets OS-version. Kopieras igen när enheten ansluts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某台设备系统版本的调试符号。该设备再次连接时会重新复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某個裝置作業系統版本的除錯符號。該裝置連接時會再次拷貝。"
          }
        }
      }
    },
    "Declarations identify providers. They don't prove a menu item is currently enabled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deklarationen nennen Anbieter. Sie beweisen nicht, dass ein Menüpunkt gerade aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las declaraciones identifican a los proveedores. No demuestran que un elemento de menú esté activado ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déclarations identifient les fournisseurs. Elles ne prouvent pas qu’un élément de menu est actuellement activé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घोषणाएँ प्रदाताओं की पहचान करती हैं। वे यह साबित नहीं करतीं कि कोई मेनू आइटम अभी चालू है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dichiarazioni identificano i fornitori. Non dimostrano che una voce di menu sia attualmente attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宣言からは提供元がわかります。メニュー項目が現在有効であることを示すものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선언은 제공자를 식별할 뿐, 메뉴 항목이 현재 켜져 있음을 증명하지는 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Declaraties wijzen aanbieders aan. Ze bewijzen niet dat een menuonderdeel nu is ingeschakeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As declarações identificam provedores. Elas não provam que um item de menu esteja ativado no momento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppgifterna anger leverantörer. De bevisar inte att ett menyalternativ är aktiverat just nu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声明只能识别提供方，不能证明某个菜单项当前已启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宣告可識別提供者，但不能證明選單項目目前已啟用。"
          }
        }
      }
    },

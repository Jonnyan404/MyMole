    "Tagged %@; other copies are tagged differently. Choose which one stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Tag %@ versehen; andere Kopien haben andere Tags. Wähle, welche bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetado %@; las otras copias tienen otras etiquetas. Elige cuál se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiqueté %@ ; les autres copies ont d’autres étiquettes. Choisissez celle qui reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ टैग किया गया; अन्य कॉपियों के टैग अलग हैं। चुनें कि कौन-सी रहे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag: %@; altre copie hanno tag diversi. Scegli quale deve restare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のタグが付いていますが、ほかのコピーのタグは異なります。どれを残すか決めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그 %@이(가) 지정됨. 다른 사본에는 다른 태그가 있습니다. 남길 사본을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags: %@; andere exemplaren hebben andere tags. Kies welk exemplaar blijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetada como %@; outras cópias têm etiquetas diferentes. Escolha qual fica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taggad %@. Andra kopior har andra taggar. Välj vilken som blir kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已标记 %1$@；其他副本的标记不同。请选择保留哪一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤為%@；其他副本的標籤不同。請選擇要留下哪一個。"
          }
        }
      }
    },

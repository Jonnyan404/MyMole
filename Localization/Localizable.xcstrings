    "Choose visible cards and their size. Drag rows or use the arrows to change order. Your layout is saved on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle sichtbare Karten und ihre Größe. Ziehe Zeilen oder verwende die Pfeile, um die Reihenfolge zu ändern. Dein Layout wird auf diesem Mac gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las tarjetas visibles y su tamaño. Arrastra las filas o usa las flechas para cambiar el orden. Tu disposición se guarda en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les cartes visibles et leur taille. Faites glisser les lignes ou utilisez les flèches pour changer l’ordre. Votre disposition est enregistrée sur ce Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखने वाले कार्ड और उनका आकार चुनें। क्रम बदलने के लिए पंक्तियाँ खींचें या तीरों का उपयोग करें। आपका लेआउट इस Mac पर सहेजा जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli le schede visibili e le loro dimensioni. Trascina le righe o usa le frecce per cambiare l’ordine. Il tuo layout viene salvato su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示するカードとサイズを設定します。行をドラッグするか、矢印を使って順序を変更します。レイアウトはこのMacに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시할 카드와 크기를 선택하세요. 행을 드래그하거나 화살표로 순서를 바꿉니다. 레이아웃은 이 Mac에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies welke kaarten zichtbaar zijn en hun grootte. Sleep rijen of gebruik de pijlen om de volgorde te wijzigen. Je indeling wordt op deze Mac bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os cartões visíveis e o tamanho deles. Arraste as linhas ou use as setas para mudar a ordem. Seu layout é salvo neste Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vilka kort som visas och deras storlek. Dra rader eller använd pilarna för att ändra ordning. Din layout sparas på den här datorn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要显示的卡片及其大小。拖动行或使用箭头调整顺序。你的布局会保存在这台 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇可見的卡片及其大小。拖移列或使用箭頭來更改順序。你的版面會儲存在這部Mac上。"
          }
        }
      }
    },

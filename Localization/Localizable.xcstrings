          }
        }
      }
    },
    "App libraries, dependency folders, hidden folders and Git repositories are excluded. Add a folder of personal files to search there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Bibliotheken, Abhängigkeitsordner, ausgeblendete Ordner und Git-Repositorys sind ausgeschlossen. Füge einen Ordner mit persönlichen Dateien hinzu, um dort zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se excluyen las bibliotecas de apps, las carpetas de dependencias, las carpetas ocultas y los repositorios Git. Añade una carpeta de archivos personales para buscar en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bibliothèques d’apps, dossiers de dépendances, dossiers masqués et dépôts Git sont exclus. Ajoutez un dossier de fichiers personnels pour y chercher."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप लाइब्रेरी, डिपेंडेंसी फ़ोल्डर, छिपे फ़ोल्डर और Git रिपॉज़िटरी बाहर रखे गए हैं। वहाँ खोजने के लिए निजी फ़ाइलों का फ़ोल्डर जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le librerie delle app, le cartelle di dipendenze, le cartelle nascoste e i repository Git sono esclusi. Aggiungi una cartella di file personali in cui cercare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリライブラリ、依存ファイルのフォルダ、不可視フォルダ、Gitリポジトリは除外されます。検索するには、個人用のファイルがあるフォルダを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 라이브러리, 종속성 폴더, 숨겨진 폴더 및 Git 저장소는 제외됩니다. 개인 파일이 있는 폴더를 추가하면 그곳을 검색합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appbibliotheken, mappen met afhankelijkheden, verborgen mappen en Git-repository's zijn uitgesloten. Voeg een map met persoonlijke bestanden toe om daar te zoeken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotecas de apps, pastas de dependências, pastas ocultas e repositórios Git ficam de fora. Adicione uma pasta de arquivos pessoais para buscar nela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appbibliotek, beroendemappar, dolda mappar och Git-förråd är undantagna. Lägg till en mapp med personliga filer för att söka där."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用资源库、依赖文件夹、隐藏文件夹和 Git 仓库会被排除。可添加一个个人文件文件夹，在那里搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不包含App圖庫、相依套件檔案夾、隱藏檔案夾和Git儲存庫。請加入個人檔案的檔案夾來搜尋。"
          }
        }
      }
    },
    "App metadata is read inside this folder, including build outputs. App bundles aren't searched for nested copies; dependency and version-control folders are skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Metadaten werden in diesem Ordner gelesen, auch in Build-Ausgaben. App-Bundles werden nicht nach verschachtelten Kopien durchsucht; Abhängigkeits- und Versionskontrollordner werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los metadatos de apps se leen dentro de esta carpeta, incluidos los resultados de compilación. No se buscan copias anidadas dentro de los paquetes de apps; se omiten las carpetas de dependencias y de control de versiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées d’app sont lues dans ce dossier, y compris les résultats de compilation. Les paquets d’apps ne sont pas fouillés à la recherche de copies imbriquées ; les dossiers de dépendances et de contrôle de version sont ignorés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ोल्डर के अंदर ऐप मेटाडेटा पढ़ा जाता है, बिल्ड आउटपुट समेत। ऐप बंडल में नेस्टेड कॉपियाँ नहीं खोजी जातीं; डिपेंडेंसी और वर्ज़न-कंट्रोल फ़ोल्डर छोड़ दिए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I metadati delle app vengono letti in questa cartella, compresi gli output di build. Nei bundle delle app non vengono cercate copie annidate; le cartelle di dipendenze e di controllo versioni vengono saltate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビルド生成物も含め、このフォルダ内のアプリのメタデータを読み取ります。アプリバンドルの中のコピーは検索しません。依存ファイルとバージョン管理のフォルダはスキップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌드 결과물을 포함해 이 폴더 안의 앱 메타데이터를 읽습니다. 앱 번들 안의 중첩된 사본은 검색하지 않으며, 종속성 및 버전 관리 폴더는 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deze map worden metagegevens van apps gelezen, ook in builduitvoer. Appbundels worden niet doorzocht op exemplaren erin; mappen met afhankelijkheden en versiebeheer worden overgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os metadados dos apps são lidos dentro desta pasta, incluindo as saídas da compilação. Não são buscadas cópias aninhadas dentro dos pacotes de apps; pastas de dependências e de controle de versão são ignoradas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuppgifter läses i den här mappen, även i byggresultat. Appaket genomsöks inte efter nästlade kopior. Beroende- och versionshanteringsmappar hoppas över."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会在此文件夹内读取应用元数据，包括构建产物。不会在应用包内搜索嵌套副本；依赖与版本控制文件夹会被跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會讀取此檔案夾中的App後設資料，包括建置產物。不會在App套件中搜尋巢狀副本；會略過相依套件和版本控制檔案夾。"
          }
        }
      }
    },
    "App metadata or protections are not a bounded regular file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Metadaten oder Schutzregeln sind keine reguläre Datei begrenzter Größe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los metadatos de la app o las protecciones no son un archivo normal de tamaño limitado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées de l’app ou les protections ne sont pas un fichier ordinaire de taille limitée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप मेटाडेटा या सुरक्षाएँ सीमित आकार की सामान्य फ़ाइल नहीं हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I metadati o le protezioni dell’app non sono un file normale di dimensioni limitate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのメタデータまたは保護のデータが、上限内の通常のファイルではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 메타데이터 또는 보호 규칙이 크기가 제한된 일반 파일이 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De metagegevens of bescherming van de app zijn geen gewoon bestand van begrensde grootte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os metadados ou as proteções do app não são um arquivo comum de tamanho limitado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens metadata eller skydd är inte en vanlig fil av begränsad storlek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用元数据或保护规则不是大小受限的普通文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App的後設資料或保護不是大小受限的一般檔案。"
          }
        }
      }
    },
    "App metadata or protections changed while being read." : {
      "localizations" : {
        "de" : {

    "Sites look up their address again on the next visit. Nothing to undo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites suchen ihre Adresse beim nächsten Besuch erneut. Nichts zu widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios vuelven a buscar su dirección en la próxima visita. No hay nada que deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites recherchent à nouveau leur adresse à la prochaine visite. Rien à annuler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली बार आने पर साइटें अपना पता फिर से खोजती हैं। पहले जैसा करने को कुछ नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I siti cercano di nuovo il loro indirizzo alla visita successiva. Nulla da annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回アクセスしたときに、サイトのアドレスが再び調べられます。取り消すものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 방문 시 사이트 주소를 다시 조회합니다. 실행 취소할 것이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites zoeken hun adres bij het volgende bezoek opnieuw op. Er valt niets ongedaan te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço dos sites é consultado novamente na próxima visita. Não há nada a desfazer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webbplatser slår upp sin adress igen vid nästa besök. Det finns inget att ångra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网站会在下次访问时重新查询地址。无需撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次造訪時，網站會再次查詢其位址。沒有需要還原的內容。"
          }
        }
      }
    },

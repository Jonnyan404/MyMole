    "Allow MyMole to control Finder in System Settings → Privacy & Security → Automation, then try Undo again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube MyMole unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Automation“, den Finder zu steuern, und versuche dann erneut zu widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que MyMole controle el Finder en Ajustes del Sistema → Privacidad y seguridad → Automatización y vuelve a probar Deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez MyMole à contrôler le Finder dans Réglages Système → Confidentialité et sécurité → Automatisation, puis réessayez Annuler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग → गोपनीयता और सुरक्षा → ऑटोमेशन में MyMole को Finder नियंत्रित करने दें, फिर पहले जैसा करें को फिर से आज़माएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a MyMole di controllare il Finder in Impostazioni di Sistema → Privacy e sicurezza → Automazione, poi riprova con “Annulla azione”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“システム設定”→“プライバシーとセキュリティ”→“オートメーション”でMyMoleにFinderの制御を許可してから、もう一度“取り消す”を実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 개인정보 보호 및 보안 → 자동화에서 MyMole이 Finder를 제어하도록 허용한 다음 실행 취소를 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta in Systeeminstellingen → Privacy en beveiliging → Automatisering toe dat MyMole Finder bedient en probeer 'Herstel' opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o MyMole controle o Finder em Ajustes do Sistema → Privacidade e Segurança → Automação e tente Desfazer novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt MyMole att styra Finder i Systeminställningar → Integritet och säkerhet → Automatisering och försök sedan med Ångra igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”→“隐私与安全性”→“自动化”中允许 MyMole 控制访达，然后重新尝试撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」→「隱私權與安全性」→「自動化」中允許MyMole控制Finder，然後再試一次「還原」。"
          }
        }
      }
    },
    "Allow MyMole to control Finder in System Settings → Privacy & Security → Automation, then try again. No app data was moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube MyMole unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Automation“, den Finder zu steuern, und versuche es dann erneut. Es wurden keine App-Daten bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que MyMole controle el Finder en Ajustes del Sistema → Privacidad y seguridad → Automatización y vuelve a intentarlo. No se movió ningún dato de apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez MyMole à contrôler le Finder dans Réglages Système → Confidentialité et sécurité → Automatisation, puis réessayez. Aucune donnée d’app n’a été déplacée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग → गोपनीयता और सुरक्षा → ऑटोमेशन में MyMole को Finder नियंत्रित करने दें, फिर से कोशिश करें। कोई ऐप डेटा नहीं ले जाया गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a MyMole di controllare il Finder in Impostazioni di Sistema → Privacy e sicurezza → Automazione, poi riprova. Non è stato spostato nessun dato delle app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“システム設定”→“プライバシーとセキュリティ”→“オートメーション”でMyMoleにFinderの制御を許可してから、やり直してください。アプリのデータは移動されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 개인정보 보호 및 보안 → 자동화에서 MyMole이 Finder를 제어하도록 허용한 다음 다시 시도하세요. 앱 데이터는 이동되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta in Systeeminstellingen → Privacy en beveiliging → Automatisering toe dat MyMole Finder bedient en probeer het opnieuw. Er zijn geen appgegevens verplaatst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o MyMole controle o Finder em Ajustes do Sistema → Privacidade e Segurança → Automação e tente novamente. Nenhum dado do app foi movido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt MyMole att styra Finder i Systeminställningar → Integritet och säkerhet → Automatisering och försök sedan igen. Inga appdata flyttades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”→“隐私与安全性”→“自动化”中允许 MyMole 控制访达，然后重试。没有移动任何应用数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」→「隱私權與安全性」→「自動化」中允許MyMole控制Finder，然後再試一次。未搬移任何App資料。"
          }
        }
      }
    },

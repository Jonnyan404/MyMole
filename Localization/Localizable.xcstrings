              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "असत्यापित — सावधानी से उपयोग करें। आपने %arg असत्यापित मिलान चुना। स्वामित्व की पुष्टि नहीं हो सकी; अन्य ऐप यह डेटा उपयोग कर सकते हैं। केवल तभी आगे बढ़ें जब आपने चुने पथ देख लिए हों। यह ट्रैश में जाता है, जहाँ से आप इसे पुनर्स्थापित कर सकते हैं।"

    "Installers in %@ aren't shown. The result isn't saved as complete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installationsprogramme in %@ werden nicht angezeigt. Das Ergebnis wird nicht als vollständig gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los instaladores de %@ no se muestran. El resultado no se guarda como completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les installeurs dans %@ ne sont pas affichés. Le résultat n’est pas enregistré comme complet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के इंस्टॉलर नहीं दिखाए गए। परिणाम पूरा मानकर सहेजा नहीं गया।"

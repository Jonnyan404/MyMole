    "No container uses it. A container made it without a name; it may still hold that container's data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Container verwendet es. Ein Container hat es ohne Namen erstellt; es kann noch Daten dieses Containers enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún contenedor lo usa. Un contenedor lo creó sin nombre; puede que aún guarde datos de ese contenedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun conteneur ne l’utilise. Un conteneur l’a créé sans nom ; il peut encore contenir les données de ce conteneur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई कंटेनर इसका उपयोग नहीं करता। एक कंटेनर ने इसे बिना नाम के बनाया; इसमें अभी भी उस कंटेनर का डेटा हो सकता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하는 컨테이너가 없습니다. 컨테이너가 이름 없이 만들었으며 그 컨테이너의 데이터가 아직 있을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有容器在使用它。某个容器以匿名方式创建了它；其中可能仍有该容器的数据。"
          }
        }
      }
    },

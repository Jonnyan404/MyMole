          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune des copies choisies ne peut partager son stockage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई कोई भी प्रति अपना स्टोरेज साझा नहीं कर सकती।"

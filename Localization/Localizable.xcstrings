    "Unverified — use with caution. You chose %lld unverified matches. Ownership couldn't be confirmed; other apps may use this data. Continue only if you reviewed the selected paths. They go to the Trash, where you can restore them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Ungeprüft – mit Vorsicht verwenden. Du hast %arg ungeprüfte Übereinstimmung ausgewählt. Die Zugehörigkeit konnte nicht bestätigt werden; andere Apps verwenden diese Daten eventuell. Fahre nur fort, wenn du die ausgewählten Pfade geprüft hast. Sie kommt in den Papierkorb, wo du sie wiederherstellen kannst."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Ungeprüft – mit Vorsicht verwenden. Du hast %arg ungeprüfte Übereinstimmungen ausgewählt. Die Zugehörigkeit konnte nicht bestätigt werden; andere Apps verwenden diese Daten eventuell. Fahre nur fort, wenn du die ausgewählten Pfade geprüft hast. Sie kommen in den Papierkorb, wo du sie wiederherstellen kannst."
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Unverified — use with caution. You chose %arg unverified match. Ownership couldn't be confirmed; other apps may use this data. Continue only if you reviewed the selected paths. It goes to the Trash, where you can restore it."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Unverified — use with caution. You chose %arg unverified matches. Ownership couldn't be confirmed; other apps may use this data. Continue only if you reviewed the selected paths. They go to the Trash, where you can restore them."
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Sin verificar: úsalo con precaución. Elegiste %arg coincidencia sin verificar. No se pudo confirmar a quién pertenece; otras apps pueden usar estos datos. Continúa solo si revisaste las rutas seleccionadas. Va a la Papelera, donde puedes restaurarla."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Sin verificar: úsalo con precaución. Elegiste %arg coincidencias sin verificar. No se pudo confirmar a quién pertenecen; otras apps pueden usar estos datos. Continúa solo si revisaste las rutas seleccionadas. Van a la Papelera, donde puedes restaurarlas."
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Non vérifié — à utiliser avec prudence. Vous avez choisi %arg correspondance non vérifiée. L’appartenance n’a pas pu être confirmée ; d’autres apps peuvent utiliser ces données. Continuez seulement si vous avez examiné les chemins sélectionnés. Elle va dans la Corbeille, où vous pouvez la restaurer."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Non vérifié — à utiliser avec prudence. Vous avez choisi %arg correspondances non vérifiées. L’appartenance n’a pas pu être confirmée ; d’autres apps peuvent utiliser ces données. Continuez seulement si vous avez examiné les chemins sélectionnés. Elles vont dans la Corbeille, où vous pouvez les restaurer."
                    }
                  }
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "असत्यापित — सावधानी से उपयोग करें। आपने %arg असत्यापित मिलान चुना। स्वामित्व की पुष्टि नहीं हो सकी; अन्य ऐप यह डेटा उपयोग कर सकते हैं। केवल तभी आगे बढ़ें जब आपने चुने पथ देख लिए हों। यह रद्दी में जाता है, जहाँ से आप इसे पुनर्स्थापित कर सकते हैं।"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "असत्यापित — सावधानी से उपयोग करें। आपने %arg असत्यापित मिलान चुने। स्वामित्व की पुष्टि नहीं हो सकी; अन्य ऐप यह डेटा उपयोग कर सकते हैं। केवल तभी आगे बढ़ें जब आपने चुने पथ देख लिए हों। ये रद्दी में जाते हैं, जहाँ से आप इन्हें पुनर्स्थापित कर सकते हैं।"
                    }
                  }
                }
              }
            }
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n1@"
          },
          "substitutions" : {
            "n1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Non verificato: usa con cautela. Hai scelto %arg corrispondenza non verificata. Non è stato possibile confermare l’appartenenza; altre app potrebbero usare questi dati. Continua solo se hai rivisto i percorsi selezionati. Va nel Cestino, da dove puoi ripristinarla."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Non verificato: usa con cautela. Hai scelto %arg corrispondenze non verificate. Non è stato possibile confermare l’appartenenza; altre app potrebbero usare questi dati. Continua solo se hai rivisto i percorsi selezionati. Vanno nel Cestino, da dove puoi ripristinarle."
                    }
                  }
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未確認 — 注意してください。未確認の一致%lld件が対象に含まれています。所有元を確認できませんでした。ほかのアプリがこのデータを使っている可能性があります。対象のパスを確認した場合にだけ続けてください。これらはゴミ箱に入り、そこから元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {

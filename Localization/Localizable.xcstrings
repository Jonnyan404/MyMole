        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रखें-सूचियाँ पढ़ी नहीं जा सकीं, इसलिए जब तक पढ़ी न जा सकें, कुछ अनइंस्टॉल नहीं होता। सेटिंग्ज़ में सूचियाँ और प्रोजेक्ट में अपने नियम देखें।"
          }
        },
        "ko" : {
          "stringUnit" : {

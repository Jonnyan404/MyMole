    "Asked because it's a big move. Settings → Confirmations → Always ask before big moves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefragt, weil es eine große Verschiebung ist. „Einstellungen“ → „Bestätigungen“ → „Vor großen Verschiebungen immer fragen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pregunta porque es un movimiento grande. Ajustes → Confirmaciones → Preguntar siempre antes de movimientos grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandé parce que c’est un gros déplacement. Réglages → Confirmations → Toujours demander avant les gros déplacements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सवाल इसलिए पूछा गया क्योंकि यह बड़ा स्थानांतरण है। सेटिंग्ज़ → पुष्टियाँ → बड़े स्थानांतरण से पहले हमेशा पूछें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma richiesta perché lo spostamento è grande. Impostazioni → Conferme → Chiedi sempre prima di spostamenti grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大量の移動のため確認しています。“設定”→“確認メッセージ”→“大量の移動の前に必ず確認”で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 이동이라서 묻습니다. 설정 → 확인 → 큰 이동 전에는 항상 묻기."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je krijgt deze vraag omdat het om een grote verplaatsing gaat. Instellingen → Bevestigingen → Vraag altijd vóór grote verplaatsingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunta feita porque é uma movimentação grande. Ajustes → Confirmações → Sempre perguntar antes de grandes movimentações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frågas eftersom det är en stor flytt. Inställningar → Bekräftelser → Fråga alltid före stora flyttar."

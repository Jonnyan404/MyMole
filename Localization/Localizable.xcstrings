    },
    "ESET's support says to open it, in the app's Contents/Helpers folder, and choose Uninstall. It also removes ESET's protection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ESET-Support empfiehlt, es im Ordner Contents/Helpers der App zu öffnen und „Uninstall“ zu wählen. Es entfernt auch den Schutz von ESET."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El soporte de ESET indica abrirlo, en la carpeta Contents/Helpers de la app, y elegir Uninstall. También elimina la protección de ESET."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistance d'ESET indique de l'ouvrir, dans le dossier Contents/Helpers de l'app, puis de choisir Uninstall. Il supprime aussi la protection d'ESET."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESET सपोर्ट इसे ऐप के Contents/Helpers फ़ोल्डर में खोलकर Uninstall चुनने को कहता है। यह ESET की सुरक्षा भी हटाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistenza di ESET dice di aprirlo, nella cartella Contents/Helpers dell’app, e di scegliere Uninstall. Rimuove anche la protezione di ESET."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESETのサポートで案内されている方法です。アプリのContents/Helpersフォルダにあるこれを開き、“Uninstall”を選びます。ESETの保護機能も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESET 지원팀은 앱의 Contents/Helpers 폴더에서 이것을 열고 Uninstall을 선택하라고 안내합니다. ESET의 보호 기능도 함께 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgens support van ESET open je dit, in de map Contents/Helpers van de app, en kies je 'Uninstall'. Hiermee wordt ook de beveiliging van ESET verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O suporte da ESET diz para abri-lo, na pasta Contents/Helpers do app, e escolher Uninstall. Ele também remove a proteção da ESET."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESET:s support säger att du ska öppna det, i appens mapp Contents/Helpers, och välja Uninstall. Det tar även bort ESET:s skydd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESET 支持建议在应用的 Contents/Helpers 文件夹中打开它并选择 Uninstall。它还会移除 ESET 的防护功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESET支援部門建議打開它（位於App的Contents/Helpers檔案夾），然後選擇Uninstall。它也會移除ESET的防護。"
          }
        }
      }
    },
    "Each" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Stück"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun"
          }
        },

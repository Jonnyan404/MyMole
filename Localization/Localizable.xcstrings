    },
    "%@ is part of macOS, so it stays. Its caches and settings can be reset; its data is never offered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist Teil von macOS, daher bleibt es. Seine Caches und Einstellungen können zurückgesetzt werden; seine Daten werden nie angeboten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forma parte de macOS, así que se queda. Se pueden restablecer sus cachés y ajustes; sus datos nunca se ofrecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait partie de macOS : il reste donc en place. Ses caches et réglages peuvent être réinitialisés ; ses données ne sont jamais proposées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS का हिस्सा है, इसलिए यह बना रहता है। इसके कैश और सेटिंग्ज़ रीसेट किए जा सकते हैं; इसका डेटा कभी पेश नहीं किया जाता।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) macOS의 일부이므로 그대로 남습니다. 캐시와 설정은 재설정할 수 있지만 데이터는 절대 제안되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 属于 macOS，因此保留。它的缓存和设置可以重置；它的数据永远不会被选中。"
          }
        }
      }
    },
    "%@ is part of macOS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist Teil von macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forma parte de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait partie de macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS का हिस्सा है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) macOS의 일부입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 属于 macOS。"
          }
        }
      }
    },
    "%@ isn't a disk image MyMole can move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein Image, das MyMole bewegen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una imagen de disco que MyMole pueda mover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas une image disque que MyMole peut déplacer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ऐसी डिस्क इमेज नहीं है जिसे MyMole ले जा सके।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) MyMole이 이동할 수 있는 디스크 이미지가 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不是 MyMole 可以移动的磁盘映像。"
          }
        }
      }
    },
    "%@ macOS lets App Store apps into the folders you choose, so choose %@ in the next window. MyMole remembers it; you can take it back in Settings.%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS lässt App Store-Apps nur in die Ordner, die du auswählst, also wähle im nächsten Fenster %@. MyMole merkt sich das; du kannst es in den Einstellungen zurücknehmen.%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ macOS lets App Store apps into the folders you choose, so choose %2$@ in the next window. MyMole remembers it; you can take it back in Settings.%3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS deja que las apps del App Store entren en las carpetas que elijas, así que elige %@ en la siguiente ventana. MyMole lo recuerda; puedes retirarlo en Ajustes.%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS permet aux apps de l’App Store d’accéder aux dossiers que vous choisissez ; choisissez donc %@ dans la fenêtre suivante. MyMole s’en souvient ; vous pouvez retirer cet accès dans Réglages.%@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS App Store ऐप्स को केवल आपके चुने फ़ोल्डरों में जाने देता है, इसलिए अगली विंडो में %@ चुनें। MyMole इसे याद रखता है; आप इसे सेटिंग्ज़ में वापस ले सकते हैं।%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS는 App Store 앱이 사용자가 선택한 폴더에만 접근하도록 허용하므로, 다음 윈도우에서 %@을(를) 선택하세요. MyMole이 이를 기억하며, 설정에서 철회할 수 있습니다.%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ macOS 只允许应用商店版访问你选择的文件夹，请在下一个窗口中选择 %2$@。MyMole 会记住这次选择，你可以随时在设置中收回。%3$@"
          }
        }
      }
    },

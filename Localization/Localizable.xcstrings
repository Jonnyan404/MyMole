    "Your keep list couldn't be read (%@). Nothing is moved until it can be." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Behalten-Liste konnte nicht gelesen werden (%@). Nichts wird bewegt, bis sie gelesen werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer tu lista de conservación (%@). No se mueve nada hasta que se pueda leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre liste de conservation n’a pas pu être lue (%@). Rien n’est déplacé tant qu’elle ne peut pas l’être."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रखें-सूची पढ़ी नहीं जा सकी (%@)। जब तक पढ़ी न जा सके, कुछ नहीं ले जाया जाता।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관 목록을 읽을 수 없습니다(%@). 읽을 수 있을 때까지 아무것도 이동되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取你的保留清单（%1$@）。在能读取之前，不会移动任何内容。"
          }
        }
      }
    },
    "Your keep list couldn't be read (%@). Nothing is removed until it can be." : {
      "localizations" : {

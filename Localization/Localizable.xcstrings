        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描完成後即可使用「整個掃描」。"
          }
        }
      }
    },
    "Entire Scan includes folders and individual files of 1 MB or more. Smaller files are counted inside folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Gesamter Scan“ umfasst Ordner und einzelne Dateien ab 1 MB. Kleinere Dateien werden in Ordnern gezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Análisis completo incluye carpetas y archivos individuales de 1 MB o más. Los archivos más pequeños se cuentan dentro de las carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse entière inclut les dossiers et les fichiers individuels de 1 Mo ou plus. Les fichiers plus petits sont comptés dans leurs dossiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे स्कैन में फ़ोल्डर और 1 MB या उससे बड़ी अलग-अलग फ़ाइलें शामिल हैं। छोटी फ़ाइलें फ़ोल्डरों के अंदर गिनी जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Intera scansione” include cartelle e singoli file da 1 MB o più. I file più piccoli sono contati all’interno delle cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“スキャン全体”には、1 MB以上のフォルダと個別のファイルが含まれます。それより小さいファイルは、フォルダの中に集計されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 스캔에는 폴더와 1MB 이상의 개별 파일이 포함됩니다. 더 작은 파일은 폴더 안에서 계산됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Hele scan' omvat mappen en afzonderlijke bestanden van 1 MB of meer. Kleinere bestanden worden meegeteld in mappen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Análise Inteira inclui pastas e arquivos individuais de 1 MB ou mais. Os arquivos menores são contados dentro das pastas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hela skanningen omfattar mappar och enskilda filer på minst 1 MB. Mindre filer räknas in i mapparna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“整个扫描”包含文件夹以及 1 MB 及以上的单个文件。更小的文件计入所属文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「整個掃描」包括檔案夾和1 MB或以上的個別檔案。較小的檔案會計入檔案夾中。"
          }
        }
      }
    },
    "Erases and rebuilds the Spotlight index of the startup disk. Search is incomplete for a while." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den Spotlight-Index des Startvolumes und erstellt ihn neu. Die Suche ist eine Weile unvollständig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra y reconstruye el índice de Spotlight del disco de arranque. La búsqueda está incompleta durante un rato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface et reconstruit l’index Spotlight du disque de démarrage. La recherche est incomplète pendant un moment."
          }

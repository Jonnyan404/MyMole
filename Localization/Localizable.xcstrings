    "This app changed or couldn't be fully read. Scan again before reviewing its removal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App hat sich geändert oder konnte nicht vollständig gelesen werden. Scanne erneut, bevor du ihr Entfernen prüfst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app cambió o no se pudo leer por completo. Vuelve a analizar antes de revisar su eliminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app a changé ou n’a pas pu être entièrement lue. Relancez l’analyse avant d’examiner sa suppression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऐप बदल गया या पूरा पढ़ा नहीं जा सका। इसे हटाने की समीक्षा से पहले फिर से स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {

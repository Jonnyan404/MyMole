    "Tick copies for removal. One copy always stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere Kopien zum Entfernen. Eine Kopie bleibt immer."
          }
        },
        "es" : {
          "stringUnit" : {

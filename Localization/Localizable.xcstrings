        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso total al disco y Gestión de apps, cuando los activas en Ajustes del Sistema. Una contraseña de administrador para archivos y tareas del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès complet au disque et Gestion des apps, lorsque vous les activez dans Réglages Système. Un mot de passe administrateur pour les fichiers et tâches système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्ण डिस्क ऐक्सेस और ऐप प्रबंधन, जब आप उन्हें सिस्टम सेटिंग्ज़ में चालू करते हैं। सिस्टम फ़ाइलों और सिस्टम कार्यों के लिए व्यवस्थापक पासवर्ड।"

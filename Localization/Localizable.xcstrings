    "Every copy in its group is chosen, so none is left to share with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Kopie ihrer Gruppe ist ausgewählt, also bleibt keine zum Teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las copias de su grupo están elegidas, así que no queda ninguna con la que compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les copies de son groupe sont choisies : il n’en reste aucune avec qui partager."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके समूह की हर प्रति चुनी गई है, इसलिए साझा करने के लिए कोई नहीं बची।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le copie del suo gruppo sono scelte, quindi non ne resta nessuna con cui condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループ内のすべてのコピーが対象になっているため、共有する相手が残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹의 모든 사본이 선택되어 공유할 사본이 남아 있지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk exemplaar in de groep is gekozen, dus er blijft geen over om mee te delen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as cópias do grupo estão escolhidas, por isso não resta nenhuma com que compartilhar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla kopior i gruppen är valda, så det finns ingen kvar att dela med."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其所在组的所有副本都已选中，没有可共享的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其群組中的每個副本都已選擇，因此沒有副本可以共用。"
          }
        }
      }
    },
    "Every core for scans you wait on, and half of them for scans started ahead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Kerne für Scans, auf die du wartest, und die Hälfte davon für vorab gestartete Scans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los núcleos para los análisis que esperas, y la mitad para los iniciados por adelantado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les cœurs pour les analyses que vous attendez, et la moitié pour celles lancées à l’avance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन स्कैन की आप प्रतीक्षा करते हैं उनके लिए सभी कोर, और पहले से शुरू किए स्कैन के लिए उनमें से आधे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i core per le scansioni che attendi e metà di essi per quelle avviate in anticipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果待ちのスキャンにはすべてのコアを、先行して開始するスキャンにはその半分を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기다리는 스캔에는 모든 코어를, 미리 시작한 스캔에는 그 절반을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke core voor scans waarop je wacht en de helft ervan voor scans die vooraf zijn gestart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os núcleos para as análises que você aguarda e metade deles para as análises iniciadas com antecedência."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla kärnor för skanningar du väntar på, och hälften av dem för skanningar som startas i förväg."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为你等待的扫描使用全部核心，提前启动的扫描使用其中一半。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你等待中的掃描使用所有核心，預先開始的掃描使用一半。"
          }
        }
      }
    },

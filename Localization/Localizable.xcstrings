          }
        }
      }
    },
    "This location has no Trash; MyMole doesn't delete permanently." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ort hat keinen Papierkorb; MyMole löscht nicht endgültig."
          }
        },

    "1 copy now shares its storage · %@ is free once the Trash is emptied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Kopie teilt jetzt ihren Speicher · %@ sind frei, sobald der Papierkorb geleert ist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 copia comparte ahora su almacenamiento · %@ quedan libres al vaciar la Papelera"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 copie partage désormais son stockage · %@ seront libérés une fois la Corbeille vidée"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 प्रति अब अपना स्टोरेज साझा करती है · रद्दी खाली करने पर %@ खाली होगा"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 copia ora condivide lo spazio · %@ si liberano quando il Cestino viene svuotato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1個のコピーがストレージを共有するようになりました · ゴミ箱を空にすると%@空きます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본 1개가 이제 저장 공간을 공유함 · 휴지통을 비우면 %@ 확보"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 exemplaar deelt nu zijn opslag · %@ is vrij zodra de prullenmand is geleegd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 cópia agora compartilha o espaço · %@ ficam livres quando o Lixo for esvaziado"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kopia delar nu lagringsutrymme · %@ blir ledigt när papperskorgen töms"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 个副本现已共享存储空间 · 清倒废纸篓后释放 %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1個副本現在共用儲存空間 · 清空垃圾桶後會釋放%@"
          }
        }
      }
    },
    "1 copy shares with the copy that stays · %@ frees once the Trash is emptied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Kopie teilt sich den Speicher mit der Kopie, die bleibt · %@ werden frei, sobald der Papierkorb geleert ist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 copia comparte con la copia que se queda · %@ quedan libres al vaciar la Papelera"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 copie partage avec la copie qui reste · %@ seront libérés une fois la Corbeille vidée"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 प्रति बनी रहने वाली प्रति के साथ साझा करती है · रद्दी खाली करने पर %@ खाली होगा"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

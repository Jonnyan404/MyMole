        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 다운로드도 포함합니다. 별도의 검토가 열리며 자동으로 선택되는 것은 없습니다."
          }
        },
        "zh-Hans" : {

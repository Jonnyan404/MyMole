            "state" : "translated",
            "value" : "Une tâche système précédente est peut-être encore en cours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पिछला सिस्टम कार्य अभी भी चल रहा हो सकता है।"

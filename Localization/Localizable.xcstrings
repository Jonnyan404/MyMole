    "Maven's downloaded libraries. Fetched again on the next build, which needs the network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Maven geladene Bibliotheken. Werden beim nächsten Build erneut geladen; dafür ist das Netzwerk nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotecas descargadas por Maven. Se vuelven a descargar en la próxima compilación, lo que necesita la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliothèques téléchargées par Maven. Récupérées à nouveau à la prochaine compilation, ce qui nécessite le réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maven द्वारा डाउनलोड की लाइब्रेरी। अगले बिल्ड पर फिर से लाई जाती हैं, जिसके लिए नेटवर्क चाहिए।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maven이 다운로드한 라이브러리입니다. 다음 빌드에서 다시 받으며 네트워크가 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maven 下载的库。下次构建时会重新获取，需要联网。"

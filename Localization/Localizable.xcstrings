    "Installed apps' helper identities couldn't be read, so no leftovers were offered. Try Scan Again after checking app access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Helfer-Identitäten installierter Apps konnten nicht gelesen werden, daher wurden keine Reste angeboten. Versuche „Erneut scannen“, nachdem du den App-Zugriff geprüft hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer las identidades de los asistentes de las apps instaladas, así que no se ofreció ningún resto. Prueba Volver a analizar tras comprobar el acceso de las apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identités des assistants des apps installées n’ont pas pu être lues, aucun reste n’a donc été proposé. Essayez Relancer l’analyse après avoir vérifié l’accès des apps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंस्टॉल ऐप्स की हेल्पर पहचान पढ़ी नहीं जा सकी, इसलिए कोई बचा हुआ आइटम पेश नहीं किया गया। ऐप ऐक्सेस जाँचने के बाद फिर से स्कैन करें आज़माएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere le identità degli assistenti delle app installate, quindi non sono stati proposti residui. Controlla l’accesso alle app, poi prova “Scansiona di nuovo”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みアプリのヘルパーの識別情報を読み取れなかったため、残存ファイルは表示されません。アプリへのアクセスを確認してから、“もう一度スキャン”を試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 앱의 도우미 식별 정보를 읽을 수 없어 잔여 항목을 제안하지 않았습니다. 앱 접근 권한을 확인한 후 다시 스캔을 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De identiteiten van helpers van geïnstalleerde apps konden niet worden gelezen, dus er zijn geen restanten aangeboden. Controleer de toegang tot apps en probeer 'Scan opnieuw'."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as identidades dos auxiliares dos apps instalados, por isso nenhuma sobra foi oferecida. Tente Analisar Novamente após verificar o acesso aos apps."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteterna för installerade appars hjälpprogram kunde inte läsas, så inga rester erbjöds. Prova Skanna igen när du har kontrollerat appåtkomsten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已安装应用的辅助程序身份，因此没有提供残留项。请检查应用访问权限后重试“重新扫描”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已安裝App的輔助程式身分，因此未列出任何殘留項目。請檢查App取用權限後嘗試「再次掃描」。"
          }
        }
      }
    },
    "Installed by the app's own installer, and by no other" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom eigenen Installationsprogramm der App installiert, und von keinem anderen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado por el propio instalador de la app, y por ningún otro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installé par le programme d’installation de l’app, et par aucun autre"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के अपने इंस्टॉलर ने इंस्टॉल किया, किसी और ने नहीं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installato dall’installer dell’app e da nessun altro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ自身のインストーラだけがインストールしたもの"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 자체의 설치 프로그램만 설치함"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geïnstalleerd door het eigen installatieprogramma van de app en door geen ander"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado pelo instalador do próprio app, e por nenhum outro"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerat av appens eget installationsprogram, och inte av något annat"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由该应用自己的安装程序安装，且仅此一个"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由App自己的安裝程式安裝，並非由其他安裝程式安裝"
          }
        }
      }
    },
    "Installed for every user or the system. Remove it with its app's own uninstaller." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für alle Benutzer oder das System installiert. Entferne es mit dem eigenen Deinstallationsprogramm seiner App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado para todos los usuarios o para el sistema. Elimínalo con el desinstalador de su app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installé pour tous les utilisateurs ou pour le système. Supprimez-le avec le programme de désinstallation de son app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी उपयोगकर्ताओं या सिस्टम के लिए इंस्टॉल। इसे इसके ऐप के अपने अनइंस्टॉलर से हटाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installato per tutti gli utenti o per il sistema. Rimuovilo con il programma di disinstallazione della sua app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのユーザまたはシステム用にインストールされています。アプリ自身のアンインストーラで削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사용자 또는 시스템용으로 설치됨. 해당 앱의 자체 제거 프로그램으로 제거하세요."
          }
        },
        "nl" : {

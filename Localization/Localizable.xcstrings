          }
        }
      }
    },
    "The Photos library is left alone: remove pictures there in Photos. Nothing leaves the Mac; pictures are compared by a small fingerprint made here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos-Mediathek bleibt unangetastet: Entferne Bilder dort in Fotos. Nichts verlässt den Mac; Bilder werden über einen kleinen, hier erstellten Fingerabdruck verglichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fototeca de Fotos no se toca: elimina allí las imágenes desde Fotos. Nada sale del Mac; las imágenes se comparan con una pequeña huella creada aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque Photos n’est pas touchée : supprimez-y les images dans Photos. Rien ne quitte le Mac ; les images sont comparées par une petite empreinte calculée ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos लाइब्रेरी को छुआ नहीं जाता: वहाँ की तस्वीरें Photos में हटाएँ। कुछ भी Mac से बाहर नहीं जाता; तस्वीरों की तुलना यहीं बने छोटे फ़िंगरप्रिंट से होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria di Foto non viene toccata: rimuovi lì le immagini usando Foto. Nulla lascia il Mac; le immagini vengono confrontate tramite una piccola impronta creata qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真ライブラリには手を付けません。そこにある画像は“写真”アプリで削除してください。Macの外には何も送信されません。画像は、このMacで作成した小さなフィンガープリントで比較されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 보관함은 건드리지 않으므로 사진 앱에서 직접 제거하세요. Mac 밖으로 나가는 것은 없으며, 여기서 만든 작은 지문으로 사진을 비교합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Foto's-bibliotheek wordt ongemoeid gelaten: verwijder afbeeldingen daar in Foto's. Niets verlaat de Mac; afbeeldingen worden vergeleken via een kleine vingerafdruk die hier wordt gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fototeca do Fotos não é tocada: remova imagens de lá no app Fotos. Nada sai do Mac; as imagens são comparadas por uma pequena impressão digital criada aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder-biblioteket lämnas orört. Ta bort bilder där i appen Bilder. Inget lämnar datorn. Bilderna jämförs med ett litet fingeravtryck som skapas här."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“照片”图库不会被改动：请在那里的“照片”中删除照片。任何内容都不会离开这台 Mac；照片通过在本机生成的少量指纹进行比对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會動到「照片」圖庫：請在「照片」中移除其中的圖片。沒有任何內容會離開這部Mac；圖片是以在這裡製作的小型指紋來比較。"
          }
        }
      }
    },

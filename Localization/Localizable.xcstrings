        }
      }
    },
    "This list couldn't be read (%@). Nothing is removed against it until it can be." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Liste konnte nicht gelesen werden (%@). Nichts wird gegen sie entfernt, bis sie gelesen werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer esta lista (%@). No se elimina nada en su contra hasta que se pueda leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste n’a pas pu être lue (%@). Rien n’est supprimé à son encontre tant qu’elle ne peut pas l’être."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सूची पढ़ी नहीं जा सकी (%@)। जब तक पढ़ी न जा सके, इसके विरुद्ध कुछ नहीं हटाया जाता।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 목록을 읽을 수 없습니다(%@). 읽을 수 있을 때까지 이 목록에 반하여 제거되는 것은 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取此清单（%1$@）。在能读取之前，不会依据它移除任何内容。"
          }
        }
      }
    },
    "This list is filtered by its text only. Conditions such as size: and kind: work in lists of files and folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Liste wird nur nach Text gefiltert. Bedingungen wie size: und kind: funktionieren in Listen von Dateien und Ordnern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta lista solo se filtra por texto. Las condiciones como size: y kind: funcionan en las listas de archivos y carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste n’est filtrée que par son texte. Les conditions comme size: et kind: fonctionnent dans les listes de fichiers et de dossiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सूची केवल टेक्स्ट से फ़िल्टर होती है। size: और kind: जैसी शर्तें फ़ाइलों और फ़ोल्डरों की सूचियों में काम करती हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {

          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 copia comparte con la copia que se queda · %@ quedan libres al vaciar la Papelera"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 copie partage avec la copie qui reste · %@ seront libérés une fois la Corbeille vidée"
          }

    "Search by app name, ID, version or path. Choose a build folder to include apps missing from the system index." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach App-Name, ID, Version oder Pfad. Wähle einen Build-Ordner, um Apps einzuschließen, die im Systemindex fehlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca por nombre de app, ID, versión o ruta. Elige una carpeta de compilación para incluir apps que faltan en el índice del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez par nom d’app, identifiant, version ou chemin. Choisissez un dossier de compilation pour inclure les apps absentes de l’index du système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप नाम, ID, संस्करण या पथ से खोजें। सिस्टम इंडेक्स में न मौजूद ऐप शामिल करने के लिए बिल्ड फ़ोल्डर चुनें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 이름, ID, 버전 또는 경로로 검색하세요. 시스템 색인에 없는 앱을 포함하려면 빌드 폴더를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按应用名称、ID、版本或路径搜索。可选择构建文件夹，以包含系统索引中缺失的应用。"
          }
        }
      }
    },

        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对保留清单的修改尚未保存。"
          }
        }
      }
    },
    "A container uses it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Container verwendet es."
          }

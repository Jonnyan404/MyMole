    },
    "The tool stopped with code %d." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tool wurde mit Code %d beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta se detuvo con el código %d."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil s’est arrêté avec le code %d."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टूल कोड %d के साथ रुक गया।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구가 코드 %d로 중지되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工具已停止，代码 %d。"
          }
        }
      }
    },
    "The tool that made it noted this project's path with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tool, das es erstellt hat, hat den Pfad dieses Projekts dazu vermerkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta que lo creó anotó con él la ruta de este proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil qui l’a créé y a noté le chemin de ce projet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे बनाने वाले टूल ने इसके साथ इस प्रोजेक्ट का पथ दर्ज किया।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이를 만든 도구가 이 프로젝트의 경로를 함께 기록했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成它的工具同时记录了该项目的路径。"
          }
        }
      }
    },
    "The user's Trash could not be created on the same volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Papierkorb des Benutzers konnte nicht auf demselben Volume erstellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo crear la Papelera del usuario en el mismo volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Corbeille de l’utilisateur n’a pas pu être créée sur le même volume."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता का ट्रैश उसी वॉल्यूम पर बनाया नहीं जा सका।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 볼륨에 사용자의 휴지통을 만들 수 없었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在同一宗卷上创建该用户的废纸篓。"
          }
        }
      }
    },
    "The user's Trash could not be prepared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Papierkorb des Benutzers konnte nicht vorbereitet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo preparar la Papelera del usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Corbeille de l’utilisateur n’a pas pu être préparée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता का ट्रैश तैयार नहीं हो सका।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 휴지통을 준비할 수 없었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法准备该用户的废纸篓。"
          }
        }
      }
    },
    "The user's Trash is not available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Papierkorb des Benutzers ist nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Papelera del usuario no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Corbeille de l’utilisateur n’est pas disponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता का ट्रैश उपलब्ध नहीं है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 휴지통을 사용할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该用户的废纸篓不可用。"
          }
        }
      }
    },
    "The user's Trash is not private to that user." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Papierkorb des Benutzers ist nicht nur für diesen Benutzer zugänglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Papelera del usuario no es privada para ese usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Corbeille de l’utilisateur ne lui est pas privée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता का ट्रैश उस उपयोगकर्ता के लिए निजी नहीं है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 휴지통이 해당 사용자 전용이 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该用户的废纸篓不是该用户专属的。"
          }
        }
      }
    },
    "The user's Trash must be a real directory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Papierkorb des Benutzers muss ein echter Ordner sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Papelera del usuario debe ser una carpeta real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Corbeille de l’utilisateur doit être un vrai dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता का ट्रैश एक असली फ़ोल्डर होना चाहिए।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 휴지통은 실제 폴더여야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该用户的废纸篓必须是一个真实的目录。"
          }
        }
      }
    },
    "Their contents aren't counted above. Most are protected by macOS; Full Disk Access lets MyMole see inside the ones that belong to you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Inhalt wird oben nicht mitgezählt. Die meisten schützt macOS; Festplattenvollzugriff lässt MyMole in die hineinsehen, die dir gehören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su contenido no se cuenta arriba. La mayoría los protege macOS; el acceso total al disco permite que MyMole vea dentro de los que te pertenecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leur contenu n’est pas compté ci-dessus. La plupart sont protégés par macOS ; l’accès complet au disque permet à MyMole de voir l’intérieur de ceux qui vous appartiennent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनकी सामग्री ऊपर नहीं गिनी गई। ज़्यादातर macOS द्वारा सुरक्षित हैं; पूर्ण डिस्क ऐक्सेस MyMole को उनमें देखने देता है जो आपके हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내용은 위에서 계산되지 않습니다. 대부분 macOS가 보호하며, 전체 디스크 접근 권한이 있으면 MyMole이 내 소유의 폴더 안을 볼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们的内容未计入上方统计。多数受 macOS 保护；授予“完全磁盘访问”后，MyMole 才能看清属于你的那些内容。"
          }
        }
      }
    },
    "Theme" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thema"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tema"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thème"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थीम"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테마"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主题"
          }
        }
      }
    },
    "These components may serve other Google products or installations. They aren't attributed exclusively to this app and aren't separate removal choices here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Komponenten dienen eventuell anderen Google-Produkten oder -Installationen. Sie sind nicht ausschließlich dieser App zugeordnet und hier keine eigene Auswahl zum Entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos componentes pueden servir a otros productos o instalaciones de Google. No se atribuyen solo a esta app y aquí no son elecciones aparte para eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces composants peuvent servir à d’autres produits ou installations Google. Ils ne sont pas attribués exclusivement à cette app et ne sont pas des choix de suppression séparés ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये घटक अन्य Google उत्पादों या इंस्टॉलेशन के काम आ सकते हैं। ये केवल इस ऐप के नहीं माने जाते और यहाँ अलग से हटाने के विकल्प नहीं हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 구성 요소는 다른 Google 제품이나 설치에서도 쓰일 수 있습니다. 이 앱에만 속하지 않으며 여기서 별도의 제거 대상이 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些组件可能还供其他 Google 产品或安装使用。它们并非此应用专属，因此在这里不作为单独的移除选项。"
          }
        }
      }
    },
    "These items and everything inside them stay, even when a parent is chosen for cleanup. Path rules also protect moves to the Trash in other views." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Objekte und alles darin bleiben, auch wenn ein übergeordnetes Objekt zur Bereinigung ausgewählt ist. Pfadregeln schützen auch Bewegungen in den Papierkorb in anderen Ansichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos elementos y todo lo que contienen se quedan, aunque se elija para limpiar una carpeta superior. Las reglas de ruta también protegen los traslados a la Papelera en otras vistas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces éléments et tout leur contenu restent, même quand un parent est choisi pour le nettoyage. Les règles de chemin protègent aussi les placements dans la Corbeille dans d’autres vues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये आइटम और इनके अंदर की हर चीज़ बनी रहती है, भले ही सफ़ाई के लिए पैरेंट चुना गया हो। पथ नियम अन्य व्यू में ट्रैश में ले जाने से भी बचाते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목과 그 안의 모든 것은 상위 항목을 정리 대상으로 선택해도 남습니다. 경로 규칙은 다른 보기에서 휴지통으로 이동하는 것도 보호합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使父项被选作清理，这些项目及其中的全部内容也会保留。路径规则在其他视图中同样会阻止移到废纸篓。"
          }
        }
      }
    },
    "These names are excluded inside Projects, including their contents. To protect a folder from Trash moves in other views too, whitelist its specific path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Namen sind in „Projekte“ ausgeschlossen, samt Inhalt. Um einen Ordner auch in anderen Ansichten vor dem Bewegen in den Papierkorb zu schützen, setze seinen genauen Pfad auf die weiße Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos nombres se excluyen en Proyectos, con su contenido. Para proteger también una carpeta de los traslados a la Papelera en otras vistas, añade su ruta concreta a la lista blanca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces noms sont exclus dans Projets, avec leur contenu. Pour protéger aussi un dossier des placements dans la Corbeille dans d’autres vues, mettez son chemin précis en liste blanche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये नाम प्रोजेक्ट में बाहर रखे जाते हैं, उनकी सामग्री समेत। किसी फ़ोल्डर को अन्य व्यू में भी ट्रैश में जाने से बचाने के लिए उसका सटीक पथ व्हाइटलिस्ट करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이름은 내용과 함께 프로젝트에서 제외됩니다. 다른 보기에서도 폴더가 휴지통으로 이동되지 않도록 보호하려면 정확한 경로를 화이트리스트에 추가하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些名称会在“项目”中被排除，其内容也一并排除。若要在其他视图中也阻止该文件夹被移到废纸篓，请把它的具体路径加入保留列表。"
          }
        }
      }
    },
    "They appear here as the scan finds them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie erscheinen hier, sobald der Scan sie findet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparecen aquí a medida que el análisis los encuentra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils apparaissent ici au fur et à mesure que l’analyse les trouve."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन में मिलते ही ये यहाँ दिखते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔에서 찾는 대로 여기에 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描发现时会逐个出现在这里。"
          }
        }
      }
    },
    "They couldn't be read through, or changed while they were read, so whether they have copies isn't known. Search again to try them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie konnten nicht vollständig gelesen werden oder haben sich beim Lesen geändert, daher ist unbekannt, ob sie Kopien haben. Suche erneut, um sie zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer por completo, o cambiaron mientras se leían, así que no se sabe si tienen copias. Vuelve a buscar para intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils n’ont pas pu être lus jusqu’au bout, ou ont changé pendant la lecture : on ne sait donc pas s’ils ont des copies. Relancez la recherche pour les réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें पूरा पढ़ा नहीं जा सका, या पढ़ते समय ये बदल गईं, इसलिए पता नहीं कि इनकी कॉपियाँ हैं या नहीं। इन्हें आज़माने के लिए फिर से खोजें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝까지 읽을 수 없었거나 읽는 동안 변경되어 사본이 있는지 알 수 없습니다. 다시 검색하여 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们无法完整读取，或在读取过程中发生了变化，因此无法确定是否有副本。请重新搜索以再次尝试。"
          }
        }
      }
    },
    "They take the space of one copy on the disk, as copies made with Finder's Duplicate do. If you change one later, it gets space of its own again; the others stay as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie belegen auf dem Laufwerk den Platz einer Kopie, so wie Kopien, die mit „Duplizieren“ im Finder entstehen. Änderst du später eine, bekommt sie wieder eigenen Platz; die anderen bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupan en el disco el espacio de una copia, como las copias hechas con Duplicar en el Finder. Si cambias una más adelante, vuelve a tener espacio propio; las demás se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles occupent sur le disque l’espace d’une copie, comme les copies faites avec Dupliquer dans le Finder. Si vous en modifiez une plus tard, elle retrouve un espace propre ; les autres restent telles quelles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे डिस्क पर एक प्रति जितनी जगह लेती हैं, जैसे Finder के डुप्लिकेट से बनी प्रतियाँ। बाद में आप किसी को बदलें, तो उसे फिर अपनी जगह मिलती है; बाकी वैसी ही रहती हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder의 복제로 만든 사본처럼 디스크에서 사본 하나만큼의 공간을 차지합니다. 나중에 하나를 바꾸면 그 파일만 다시 자기 공간을 갖고, 나머지는 그대로입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们在磁盘上只占一个副本的空间，就像在访达中用“复制”得到的副本一样。以后修改其中一个，它会重新拥有自己的空间，其他的保持不变。"
          }
        }
      }
    },
    "This Folder" : {

          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une modification de la liste de conservation n’a pas été enregistrée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रखें-सूची का एक बदलाव सहेजा नहीं गया है।"

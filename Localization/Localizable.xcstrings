    "Review its caches and settings, turn off Open at Login and move the app to the Trash. Nothing is deleted permanently." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe ihre Caches und Einstellungen, deaktiviere „Bei der Anmeldung öffnen“ und lege die App in den Papierkorb. Nichts wird dauerhaft gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa sus cachés y ajustes, desactiva Abrir al iniciar sesión y traslada la app a la Papelera. No se elimina nada definitivamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examinez ses caches et réglages, désactivez Ouvrir à la connexion et placez l’app dans la Corbeille. Rien n’est supprimé définitivement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके कैश और सेटिंग्ज़ की समीक्षा करें, लॉगइन पर खोलें बंद करें और ऐप को रद्दी में ले जाएँ। कुछ भी स्थायी रूप से नहीं हटाया जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivedi cache e impostazioni, disattiva l’apertura al login e sposta l’app nel Cestino. Nulla viene eliminato definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュと設定を確認し、“ログイン時に開く”をオフにして、アプリをゴミ箱に入れます。完全に削除されるものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시와 설정을 검토하고, 로그인 시 열기를 끈 다음 앱을 휴지통으로 이동합니다. 영구적으로 삭제되는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk de caches en instellingen ervan, schakel openen bij inloggen uit en verplaats de app naar de prullenmand. Er wordt niets definitief verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise os caches e ajustes dele, desative Abrir no Início da Sessão e mova o app para o Lixo. Nada é apagado definitivamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska dess cachar och inställningar, stäng av Öppna vid inloggning och flytta appen till papperskorgen. Inget raderas permanent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查它的缓存和设置、关闭“登录时打开”，并把应用移到废纸篓。不会永久删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視其快取和設定，關閉「在登入時打開」，並將App丟到垃圾桶。不會永久刪除任何項目。"
          }
        }
      }
    },
    "Review similar photos" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnliche Fotos prüfen"
          }

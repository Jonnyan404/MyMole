            "value" : "Mantiene más gráficos, iconos y medidas de texto listos, y redibuja los análisis en curso más a menudo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde plus de graphiques, d’icônes et de mesures de texte prêts, et rafraîchit les analyses en cours plus souvent."
          }
        },
        "hi" : {
          "stringUnit" : {

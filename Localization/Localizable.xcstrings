    },
    "A Gradle version a project's wrapper downloaded. Fetched again when a project that names it builds, which needs the network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Gradle-Version, die der Wrapper eines Projekts geladen hat. Wird erneut geladen, wenn ein Projekt, das sie nennt, gebaut wird; dafür ist das Netzwerk nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una versión de Gradle que descargó el wrapper de un proyecto. Se vuelve a descargar cuando se compila un proyecto que la nombra, lo que necesita la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une version de Gradle téléchargée par le wrapper d’un projet. Récupérée à nouveau quand un projet qui la nomme est compilé, ce qui nécessite le réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी प्रोजेक्ट के wrapper द्वारा डाउनलोड किया गया Gradle संस्करण। जब उसे नामित करने वाला प्रोजेक्ट बिल्ड होता है तो फिर से लाया जाता है, जिसके लिए नेटवर्क चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una versione di Gradle scaricata dal wrapper di un progetto. Viene recuperata di nuovo quando si compila un progetto che la indica, il che richiede la rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトのラッパーがダウンロードしたGradleのバージョンです。それを指定したプロジェクトをビルドするときに再び取得され、ネットワークが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트의 wrapper가 다운로드한 Gradle 버전입니다. 이를 지정한 프로젝트를 빌드할 때 다시 받으며, 네트워크가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Gradle-versie die de wrapper van een project heeft gedownload. Wordt opnieuw opgehaald wanneer een project dat die noemt wordt gebouwd, waarvoor het netwerk nodig is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma versão do Gradle que o wrapper de um projeto baixou. Buscada novamente quando um projeto que a cita é compilado, o que requer a rede."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Gradle-version som ett projekts wrapper har hämtat. Hämtas igen när ett projekt som anger den byggs, vilket kräver nätverk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目 wrapper 下载的 Gradle 版本。指定它的项目构建时会重新下载，需要联网。"

    "Open in %@ — quit it first, or it goes on writing to the file in the Trash" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geöffnet in %@ – beende es zuerst, sonst schreibt es weiter in die Datei im Papierkorb"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat bij %@ hoort, kon niet volledig worden geverifieerd. Mogelijke restanten worden alleen getoond om te bekijken. De apps zelf kunnen nog steeds weg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar totalmente a propriedade de %@. As possíveis sobras são mostradas apenas para inspeção. Os apps em si ainda podem sair."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ägarskapet kunde inte verifieras helt för %@. Möjliga rester visas bara för granskning. Själva apparna kan ändå tas bort."

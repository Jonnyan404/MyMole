          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg1@ ; %#@arg2@. Annuler les réessaie, ou utilisez Remettre dans la Corbeille."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {

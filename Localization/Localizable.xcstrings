    "In the folder every user of this Mac shares. Other users' copies of the app may still use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Ordner, den alle Benutzer dieses Mac teilen. Kopien der App anderer Benutzer verwenden ihn eventuell noch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la carpeta que comparten todos los usuarios de este Mac. Las copias de la app de otros usuarios aún pueden usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le dossier que partagent tous les utilisateurs de ce Mac. Les copies de l’app d’autres utilisateurs peuvent encore l’utiliser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस फ़ोल्डर में जिसे इस Mac के सभी उपयोगकर्ता साझा करते हैं। अन्य उपयोगकर्ताओं की ऐप कॉपियाँ अभी भी इसका उपयोग कर सकती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella cartella condivisa da tutti gli utenti di questo Mac. Le copie dell’app di altri utenti potrebbero ancora usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacのすべてのユーザが共有するフォルダにあります。ほかのユーザのアプリのコピーがまだ使用している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 모든 사용자가 공유하는 폴더에 있습니다. 다른 사용자의 앱 사본이 아직 사용 중일 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de map die alle gebruikers van deze Mac delen. Exemplaren van de app van andere gebruikers kunnen die nog gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pasta que todos os usuários deste Mac compartilham. As cópias do app de outros usuários ainda podem usá-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I mappen som alla användare av datorn delar. Andra användares kopior av appen kan fortfarande använda den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于这台 Mac 上所有用户共享的文件夹中。其他用户的应用副本可能仍在使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於這部Mac所有使用者共用的檔案夾中。其他使用者的App副本可能仍在使用。"
          }
        }
      }
    },

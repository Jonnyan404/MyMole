            "value" : "%1$@ 在你的某个保留清单上，因此保留。"
          }
        }
      }
    },
    "%@ is open. Quit it before resetting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist geöffnet. Beende die App vor dem Zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está abierta. Ciérrala antes de restablecerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert. Quittez-le avant de le réinitialiser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ खुला है। रीसेट करने से पहले इसे बंद करें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 열려 있습니다. 재설정하기 전에 종료하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在运行。请先退出再重置。"
          }
        }
      }
    },

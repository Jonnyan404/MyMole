    },
    "This match can't pass the ownership or protection checks. You can inspect it in Finder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Übereinstimmung besteht die Zugehörigkeits- oder Schutzprüfungen nicht. Du kannst sie im Finder ansehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta coincidencia no puede pasar las comprobaciones de pertenencia o protección. Puedes inspeccionarla en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette correspondance ne peut pas passer les vérifications d’appartenance ou de protection. Vous pouvez l’examiner dans le Finder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह मिलान स्वामित्व या सुरक्षा जाँच पास नहीं कर सकता। आप इसे Finder में देख सकते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 일치 항목은 소유권 또는 보호 확인을 통과할 수 없습니다. Finder에서 검사할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此匹配项无法通过归属或保护检查。你可以在访达中查看它。"
          }
        }
      }
    },
    "This match couldn't pass the review's ownership, path or protection checks. Refresh the review or inspect it in Finder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Übereinstimmung hat die Zugehörigkeits-, Pfad- oder Schutzprüfungen der Prüfung nicht bestanden. Aktualisiere die Prüfung oder sieh sie dir im Finder an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta coincidencia no pudo pasar las comprobaciones de pertenencia, ruta o protección de la revisión. Actualiza la revisión o inspecciónala en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette correspondance n’a pas pu passer les vérifications d’appartenance, de chemin ou de protection de l’examen. Actualisez l’examen ou examinez-la dans le Finder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह मिलान समीक्षा की स्वामित्व, पथ या सुरक्षा जाँच पास नहीं कर सका। समीक्षा रीफ़्रेश करें या इसे Finder में देखें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 일치 항목이 검토의 소유권, 경로 또는 보호 확인을 통과하지 못했습니다. 검토를 새로 고치거나 Finder에서 검사하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此匹配项未通过检查中的归属、路径或保护校验。请刷新检查，或在访达中查看。"
          }
        }
      }
    },
    "This picture is kept, so it stays." : {

          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole ट्रैश नहीं पढ़ सका।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole이 휴지통을 읽을 수 없었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

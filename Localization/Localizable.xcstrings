        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称"
          }
        }
      }
    },
    "Names can differ; the full contents must match. Select a group to compare its copies." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称可以不同；完整内容必须一致。选择一个组以比较其副本。"
          }
        }
      }
    },
    "Narrow the leftovers listed below by category. This does not run another search or change your removal choices." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

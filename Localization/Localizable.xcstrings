    "Don't Ask Again applies only to this action. Turn the question on again in Settings → Confirmations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nicht mehr fragen“ gilt nur für diese Aktion. Aktiviere die Frage unter „Einstellungen“ → „Bestätigungen“ wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No volver a preguntar solo se aplica a esta acción. Vuelve a activar la pregunta en Ajustes → Confirmaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne plus demander s’applique seulement à cette action. Réactivez la question dans Réglages → Confirmations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर से न पूछें केवल इस क्रिया पर लागू है। सेटिंग्ज़ → पुष्टियाँ में सवाल फिर से चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Non chiedere più” vale solo per questa azione. Puoi riattivare la domanda in Impostazioni → Conferme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“次回から確認しない”は、この操作だけに適用されます。“設定”→“確認メッセージ”で再びオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 묻지 않기는 이 작업에만 적용됩니다. 설정 → 확인에서 질문을 다시 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Vraag niet opnieuw' geldt alleen voor deze handeling. Schakel de vraag weer in via Instellingen → Bevestigingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não Perguntar Novamente vale apenas para esta ação. Ative a pergunta novamente em Ajustes → Confirmações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga inte igen gäller bara den här åtgärden. Slå på frågan igen i Inställningar → Bekräftelser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“不再询问”只对这次操作生效。可在“设置”→“确认”中重新开启询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「不再詢問」只適用於此動作。可在「設定」→「確認」中再次開啟此詢問。"
          }
        }
      }
    },
    "Don't Ask Again turns off only this warning. Turn it on again in Settings → Confirmations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nicht mehr fragen“ schaltet nur diese Warnung aus. Du kannst sie unter Einstellungen → Bestätigungen wieder einschalten."
          }

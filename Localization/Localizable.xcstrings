    "Copies %@ and MyMole's version, to quote when asking for help. No file names or paths are included." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert %@ und die Version von MyMole, um sie bei einer Hilfeanfrage anzugeben. Es werden keine Dateinamen oder Pfade übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia %@ y la versión de MyMole, para citarlos al pedir ayuda. No se incluyen nombres de archivo ni rutas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

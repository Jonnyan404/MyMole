                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ 保留。已选的 %arg 项残留（%3$@）移到废纸篓，因此它会像首次启动那样重新开始。你可以随后立即撤销。"
                    }
                  }
                }
              }
            }
          }
        }

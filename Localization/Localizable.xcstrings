    "Choose for removal. ⌫ chooses or unchooses the selected rows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Entfernen auswählen. ⌫ wählt die ausgewählten Zeilen aus oder ab."
          }
        },

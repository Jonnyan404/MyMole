        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En qué se fue tu espacio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où est passé votre espace"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी जगह कहाँ गई"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간을 차지하는 항목"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

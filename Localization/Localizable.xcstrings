            "value" : "पूर्ण डिस्क ऐक्सेस और ऐप प्रबंधन, जब आप उन्हें सिस्टम सेटिंग में चालू करते हैं। सिस्टम फ़ाइलों और सिस्टम कार्यों के लिए व्यवस्थापक पासवर्ड।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Accesso completo al disco” e “Gestione app”, quando li attivi in Impostazioni di Sistema. Una password di amministratore per i file e le attività di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定でオンにした場合は、フルディスクアクセスとアプリ管理。システムファイルとシステムタスクには管理者パスワード。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 켠 경우 전체 디스크 접근 권한과 앱 관리. 시스템 파일과 시스템 작업에는 관리자 암호."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledige schijftoegang en Appbeheer, wanneer je die inschakelt in Systeeminstellingen. Een beheerderswachtwoord voor systeembestanden en systeemtaken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso Total ao Disco e Gerenciamento de Apps, quando você os ativa nos Ajustes do Sistema. Uma senha de administrador para arquivos do sistema e tarefas do sistema."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full skivtillgång och Apphantering, när du slår på dem i Systeminställningar. Ett administratörslösenord för systemfiler och systemåtgärder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全磁盘访问权限和App管理（在系统设置中打开后）。系统文件和系统任务需要管理员密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「完全取用磁碟」和「App管理」，在你於「系統設定」中開啟後使用。系統檔案和系統作業需要管理者密碼。"
          }
        }
      }
    },

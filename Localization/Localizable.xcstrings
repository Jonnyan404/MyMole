    "The search reached its size or depth limit. Choose a smaller folder to inspect the remaining apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche hat ihre Größen- oder Tiefengrenze erreicht. Wähle einen kleineren Ordner, um die übrigen Apps zu untersuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda llegó a su límite de tamaño o profundidad. Elige una carpeta más pequeña para inspeccionar las apps restantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche a atteint sa limite de taille ou de profondeur. Choisissez un dossier plus petit pour examiner les apps restantes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज अपनी आकार या गहराई सीमा तक पहुँच गई। बाकी ऐप जाँचने के लिए छोटा फ़ोल्डर चुनें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색이 크기 또는 깊이 한도에 도달했습니다. 나머지 앱을 검사하려면 더 작은 폴더를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索达到了大小或深度上限。请选择更小的文件夹以检查其余应用。"
          }
        }
      }
    },
    "The search reached its time or entry limit. Results are incomplete; only completely measured candidates are offered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche hat ihre Zeit- oder Eintragsgrenze erreicht. Die Ergebnisse sind unvollständig; nur vollständig gemessene Kandidaten werden angeboten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda llegó a su límite de tiempo o de entradas. Los resultados están incompletos; solo se ofrecen los candidatos medidos por completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche a atteint sa limite de temps ou d’entrées. Les résultats sont incomplets ; seuls les candidats entièrement mesurés sont proposés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोज अपनी समय या प्रविष्टि सीमा तक पहुँच गई। परिणाम अधूरे हैं; केवल पूरी तरह मापे गए उम्मीदवार पेश किए जाते हैं।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색이 시간 또는 항목 한도에 도달했습니다. 결과가 불완전하며 완전히 측정된 후보만 제안됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索达到了时间或条目上限。结果不完整；只提供已完整测量的候选项。"
          }
        }
      }
    },
    "The search was limited or partly unreadable for %@. Only completely measured candidates are offered; additional app data may remain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche war für %@ begrenzt oder teilweise nicht lesbar. Nur vollständig gemessene Kandidaten werden angeboten; weitere App-Daten können bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda se limitó o fue parcialmente ilegible para %@. Solo se ofrecen los candidatos medidos por completo; pueden quedar más datos de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche a été limitée ou en partie illisible pour %@. Seuls les candidats entièrement mesurés sont proposés ; d’autres données d’app peuvent rester."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के लिए खोज सीमित थी या आंशिक रूप से अपठनीय थी। केवल पूरी तरह मापे गए उम्मीदवार पेश किए जाते हैं; और ऐप डेटा बचा रह सकता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 대한 검색이 제한되었거나 일부를 읽을 수 없었습니다. 완전히 측정된 후보만 제안되며 추가 앱 데이터가 남아 있을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对 %1$@ 的搜索受限或部分无法读取。只提供已完整测量的候选项；可能仍有其他应用数据。"
          }
        }
      }
    },
    "The signed-in user changed. Return to MyMole and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

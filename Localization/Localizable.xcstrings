    "Entire Scan becomes available when scanning finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Gesamter Scan“ ist verfügbar, wenn der Scan fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Análisis completo estará disponible cuando termine el análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse entière devient disponible à la fin de l’analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन पूरा होने पर पूरा स्कैन उपलब्ध होता है।"
          }
        },
        "it" : {
          "stringUnit" : {

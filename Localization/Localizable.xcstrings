        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono scelti solo i dati la cui ultima modifica è precedente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これより前に最後に変更されたデータだけが対象になります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 날짜 이전에 마지막으로 변경된 데이터만 선택됨"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen gegevens die hiervóór voor het laatst zijn gewijzigd, worden gekozen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só são escolhidos os dados alterados pela última vez antes disto"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara data som senast ändrades före den tidpunkten väljs"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅选择最后更改时间早于此的数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會選擇在此之前最後更改的資料"
          }
        }
      }
    },
    "Only in the Disk Map." : {
      "localizations" : {
        "de" : {

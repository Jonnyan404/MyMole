    "System caches and logs are already tidy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System-Caches und -Protokolle sind bereits aufgeräumt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cachés y registros del sistema ya están en orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les caches et journaux système sont déjà en ordre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम कैश और लॉग पहले से साफ़-सुथरे हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache e log di sistema sono già in ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのキャッシュとログはすでに整理されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 캐시와 로그가 이미 정리되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeemcaches en logbestanden zijn al netjes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os caches e registros do sistema já estão em ordem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemcachar och systemloggar är redan i ordning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统缓存和日志已经很整洁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統快取和記錄檔已經很整潔。"
          }
        }
      }
    },
    "System caches belong to root, which App Store apps may not ask for. The direct edition of MyMole cleans them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System-Caches gehören root, wonach App Store-Apps nicht fragen dürfen. Die direkte Edition von MyMole bereinigt sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cachés del sistema pertenecen a root, y las apps del App Store no pueden pedirlo. La edición directa de MyMole las limpia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les caches système appartiennent à root, ce que les apps de l’App Store ne peuvent pas demander. L’édition directe de MyMole les nettoie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम कैश root के हैं, जिसे App Store ऐप माँग नहीं सकते। MyMole का डायरेक्ट संस्करण इन्हें साफ़ करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache di sistema appartengono a root, i cui diritti le app di App Store non possono chiedere. L’edizione diretta di MyMole le pulisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのキャッシュはrootが所有しており、App Storeのアプリはその権限を求めることができません。MyMoleの直接配布版ではクリーンアップできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 캐시는 root 소유이며 App Store 앱은 이를 요청할 수 없습니다. MyMole 직접 배포 에디션이 정리합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeemcaches zijn van root en apps uit de App Store mogen daar niet om vragen. De directe editie van MyMole ruimt ze op."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os caches do sistema pertencem ao root, cujos direitos os apps da App Store não podem pedir. A edição direta do MyMole os limpa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemcachar tillhör root, som App Store-appar inte får be om. Den direkta utgåvan av MyMole rensar dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统缓存属于 root，应用商店版不能请求这类权限。MyMole 的直装版可以清理它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統快取屬於root，App Store的App不得要求該權限。MyMole的直接發行版可以清理。"
          }
        }
      }
    },

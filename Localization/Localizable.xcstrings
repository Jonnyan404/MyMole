        }
      }
    },
    "Includes small downloads too. Opens a separate review; nothing is chosen for you." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也包含小体积的下载项。会打开单独的检查界面；不会替你勾选任何内容。"

    },
    "MyMole couldn't read the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole konnte den Papierkorb nicht lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole no pudo leer la Papelera."
          }
        },

    "Used / total" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已用 / 总量"
          }
        }
      }
    },
    "Used by macOS itself. Usually rebuilt, but some services take a while." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 自身使用的部分。通常会自动重建，但某些服务需要一些时间。"

          }
        }
      }
    },
    "Keeps the most within limits ready, repaints running scans most often, and reuses a result only minutes old at launch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält innerhalb der Grenzen das meiste bereit, zeichnet laufende Scans am häufigsten neu und verwendet beim Start ein nur Minuten altes Ergebnis erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene listo lo máximo dentro de los límites, redibuja los análisis en curso con la mayor frecuencia y reutiliza al abrir un resultado de hace solo unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le plus possible prêt dans les limites, rafraîchit les analyses en cours le plus souvent, et réutilise au lancement un résultat vieux de quelques minutes seulement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीमाओं के भीतर सबसे ज़्यादा तैयार रखता है, चल रहे स्कैन सबसे ज़्यादा बार बनाता है, और लॉन्च पर कुछ ही मिनट पुराना परिणाम फिर से उपयोग करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene pronto il massimo entro i limiti, ridisegna le scansioni in corso con la massima frequenza e all’avvio riutilizza un risultato di pochi minuti prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限内で最大限のものを用意しておき、実行中のスキャンを最も頻繁に再描画します。起動時には、数分以内の結果だけを再利用します。"

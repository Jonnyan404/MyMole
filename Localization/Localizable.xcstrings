    "The app changed, already quit, or couldn't accept the request. No other process was asked to quit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App hat sich geändert, wurde bereits beendet oder konnte die Anfrage nicht annehmen. Kein anderer Prozess wurde zum Beenden aufgefordert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app cambió, ya se cerró o no pudo aceptar la solicitud. No se pidió a ningún otro proceso que se cerrara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a changé, a déjà quitté ou n’a pas pu accepter la demande. Aucun autre processus n’a été invité à quitter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बदल गया, पहले ही बंद हो गया, या अनुरोध स्वीकार नहीं कर सका। किसी अन्य प्रोसेस को बंद करने को नहीं कहा गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app è cambiata, è già stata chiusa o non ha potuto accettare la richiesta. A nessun altro processo è stato chiesto di chiudersi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが変更されたか、すでに終了しているか、要求を受け付けられませんでした。ほかのプロセスには終了を要求していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 변경되었거나 이미 종료되었거나 요청을 받을 수 없었습니다. 다른 프로세스에는 종료를 요청하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app is gewijzigd, is al gestopt of kon het verzoek niet accepteren. Er is geen ander proces gevraagd te stoppen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app mudou, já foi encerrado ou não pôde aceitar a solicitação. Nenhum outro processo recebeu pedido para encerrar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen har ändrats, redan avslutats eller kunde inte ta emot begäran. Ingen annan process ombads avsluta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用已更改、已退出，或无法接受该请求。没有要求其他进程退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App已更改、已結束，或無法接受此要求。未要求其他程序結束。"
          }
        }
      }
    },
    "The app changed. Nothing was moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App hat sich geändert. Nichts wurde bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app cambió. No se movió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a changé. Rien n’a été déplacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बदल गया। कुछ नहीं ले जाया गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app è cambiata. Non è stato spostato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが変更されました。何も移動されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 변경되었습니다. 아무것도 이동되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app is gewijzigd. Er is niets verplaatst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app mudou. Nada foi movido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen har ändrats. Inget flyttades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用发生了变化。没有移动任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App已更改。未搬移任何項目。"
          }
        }
      }
    },
    "The app could not be verified at its original location. Undo can retry from its last verified location. Check in Finder before trying again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App konnte an ihrem ursprünglichen Ort nicht geprüft werden. „Widerrufen“ kann es vom zuletzt geprüften Ort erneut versuchen. Sieh vor einem erneuten Versuch im Finder nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar la app en su ubicación original. Deshacer puede volver a intentarlo desde su última ubicación verificada. Compruébalo en el Finder antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app n’a pas pu être vérifiée à son emplacement d’origine. Annuler peut réessayer depuis son dernier emplacement vérifié. Vérifiez dans le Finder avant de réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप अपने मूल स्थान पर सत्यापित नहीं हो सका। पहले जैसा करें उसके अंतिम सत्यापित स्थान से फिर से कोशिश कर सकता है। फिर से कोशिश करने से पहले Finder में जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile verificare l’app nella sua posizione originale. “Annulla azione” può riprovare dall’ultima posizione verificata. Controlla nel Finder prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが元の場所にあることを確認できませんでした。“取り消す”で、最後に確認された場所からやり直せます。やり直す前にFinderで確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원래 위치에서 앱을 확인할 수 없었습니다. 실행 취소는 마지막으로 확인된 위치에서 다시 시도할 수 있습니다. 다시 시도하기 전에 Finder에서 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app kon niet worden geverifieerd op de oorspronkelijke locatie. 'Herstel' kan het opnieuw proberen vanaf de laatst geverifieerde locatie. Controleer dit in Finder voordat je het opnieuw probeert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o app no local original. Desfazer pode tentar novamente a partir do último local verificado. Verifique no Finder antes de tentar novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen kunde inte verifieras på sin ursprungliga plats. Ångra kan försöka igen från den senast verifierade platsen. Kontrollera i Finder innan du försöker igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在原位置核实该应用。撤销可以从上次核实的位置重试。重试前请在访达中确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法在原始位置驗證App。「還原」可從上次驗證的位置再次嘗試。請先在Finder中檢查再試一次。"
          }
        }
      }
    },
    "The app has a running process that isn't a verified bundled agent. Quit the app and its background processes before uninstalling." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App hat einen laufenden Prozess, der kein geprüfter mitgelieferter Agent ist. Beende die App und ihre Hintergrundprozesse vor dem Deinstallieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app tiene un proceso en ejecución que no es un agente incluido verificado. Cierra la app y sus procesos en segundo plano antes de desinstalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a un processus en cours qui n’est pas un agent intégré vérifié. Quittez l’app et ses processus d’arrière-plan avant de la désinstaller."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का एक चल रहा प्रोसेस सत्यापित बंडल एजेंट नहीं है। अनइंस्टॉल करने से पहले ऐप और उसके बैकग्राउंड प्रोसेस बंद करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ha un processo in esecuzione che non è un agente incluso verificato. Esci dall’app e dai suoi processi in background prima di disinstallarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリに、確認済みの内蔵エージェントではない実行中のプロセスがあります。アンインストールする前に、アプリとそのバックグラウンドプロセスを終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에 확인된 포함 에이전트가 아닌 실행 중인 프로세스가 있습니다. 제거하기 전에 앱과 백그라운드 프로세스를 종료하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app heeft een actief proces dat geen geverifieerde meegeleverde agent is. Stop de app en de achtergrondprocessen ervan voordat je deïnstalleert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app tem um processo em execução que não é um agente incluído verificado. Encerre o app e seus processos em segundo plano antes de desinstalar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen har en process som körs och som inte är en verifierad inbyggd agent. Avsluta appen och dess bakgrundsprocesser före avinstallation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该应用有正在运行的进程不属于已核实的内置自启动项。请在卸载前退出该应用及其后台进程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App有執行中的程序不是已驗證的內附代理程式。解除安裝前，請先結束App及其背景程序。"
          }
        }
      }
    },
    "The app has too many bundled agent entries to verify safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App hat zu viele mitgelieferte Agent-Einträge, um sie sicher zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app tiene demasiadas entradas de agentes incluidos para verificarlas con seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a trop d’entrées d’agents intégrés pour être vérifiée sans risque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप में सुरक्षित रूप से सत्यापित करने के लिए बहुत ज़्यादा बंडल एजेंट प्रविष्टियाँ हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ha troppe voci di agenti inclusi per una verifica sicura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの内蔵エージェントの項目が多すぎるため、安全に確認できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에 포함된 에이전트 항목이 너무 많아 안전하게 확인할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app heeft te veel meegeleverde agents om veilig te verifiëren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app tem entradas demais de agentes incluídos para verificar com segurança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen har för många inbyggda agentposter för att kunna verifieras säkert."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该应用的内置自启动项条目太多，无法安全核实。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App內附的代理程式項目過多，無法安全驗證。"
          }
        }
      }
    },
    "The app in the Trash changed or was restored. Choose it again before cleaning its leftovers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App im Papierkorb hat sich geändert oder wurde wiederhergestellt. Wähle sie erneut, bevor du ihre Reste bereinigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app de la Papelera cambió o se restauró. Vuelve a elegirla antes de limpiar sus restos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app dans la Corbeille a changé ou a été restaurée. Choisissez-la à nouveau avant de nettoyer ses restes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रद्दी में ऐप बदल गया या पुनर्स्थापित हो गया। इसके बचे हुए आइटम साफ़ करने से पहले इसे फिर से चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app nel Cestino è cambiata o è stata ripristinata. Sceglila di nuovo prima di pulirne i residui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱内のアプリが変更されたか、元に戻されました。残存ファイルをクリーンアップする前に、もう一度選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통의 앱이 변경되었거나 복원되었습니다. 잔여 항목을 정리하기 전에 다시 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app in de prullenmand is gewijzigd of teruggezet. Kies de app opnieuw voordat je de restanten ervan opruimt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app no Lixo mudou ou foi restaurado. Escolha-o novamente antes de limpar as sobras dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen i papperskorgen har ändrats eller återställts. Välj den igen innan du rensar dess rester."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "废纸篓中的应用发生了变化或被恢复。清理其残留项前请重新选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垃圾桶中的App已更改或已還原。清理其殘留項目前，請再次選擇。"
          }
        }
      }
    },
    "The app is asked to quit normally, so it can save its work or ask you first. A changed or restarted process is left alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wird gebeten, normal zu beenden, damit sie ihre Arbeit sichern oder dich vorher fragen kann. Ein geänderter oder neu gestarteter Prozess bleibt unangetastet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pide a la app que se cierre con normalidad, para que pueda guardar su trabajo o preguntarte antes. Un proceso que cambió o se reinició se deja tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app est invitée à quitter normalement, pour qu’elle puisse enregistrer son travail ou vous demander d’abord. Un processus modifié ou redémarré est laissé tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप से सामान्य रूप से बंद होने को कहा जाता है, ताकि वह अपना काम सहेज सके या पहले आपसे पूछ सके। बदला या फिर से शुरू हुआ प्रोसेस छोड़ दिया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’app viene chiesto di chiudersi normalmente, così può salvare il lavoro o chiederti prima. Un processo cambiato o riavviato non viene toccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリに通常の終了を要求するため、アプリは作業内容を保存したり、先に確認を求めたりできます。変更または再起動されたプロセスには何もしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업을 저장하거나 먼저 묻도록 앱에 정상 종료를 요청합니다. 변경되었거나 다시 시작된 프로세스는 그대로 둡니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app wordt gevraagd normaal te stoppen, zodat die je werk kan bewaren of eerst iets aan je kan vragen. Een gewijzigd of opnieuw gestart proces wordt ongemoeid gelaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app recebe um pedido para encerrar normalmente, para que ele possa salvar seu trabalho ou perguntar a você antes. Um processo alterado ou reiniciado é deixado como está."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen ombeds avsluta som vanligt, så att den kan spara sitt arbete eller fråga dig först. En process som ändrats eller startats om lämnas orörd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会请求应用正常退出，以便它保存工作或先询问你。发生变化或已重启的进程会被跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會要求App正常結束，讓它可以儲存工作內容或先詢問你。已更改或重新啟動的程序不會動到。"
          }
        }
      }
    },
    "The app is kept at %@/%@/bundle.app; its request.json records the original location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wird unter %@/%@/bundle.app aufbewahrt; ihre request.json vermerkt den ursprünglichen Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The app is kept at %1$@/%2$@/bundle.app; its request.json records the original location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se conserva en %@/%@/bundle.app; su request.json registra la ubicación original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app est conservée à %@/%@/bundle.app ; son request.json indique l’emplacement d’origine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप %@/%@/bundle.app पर रखा गया है; इसकी request.json मूल स्थान दर्ज करती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app è conservata in %@/%@/bundle.app; il suo request.json registra la posizione originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリは%@/%@/bundle.appに保管されています。元の場所はrequest.jsonに記録されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 %@/%@/bundle.app에 보관되며, request.json에 원래 위치가 기록되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

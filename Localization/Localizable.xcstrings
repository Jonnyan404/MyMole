    "Backups made on this Mac. Remove old ones in Finder, with the device's General settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups, die auf diesem Mac erstellt wurden. Entferne alte im Finder, in den Einstellungen „Allgemein“ des Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias de seguridad hechas en este Mac. Elimina las antiguas en el Finder, en los ajustes Generales del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardes faites sur ce Mac. Supprimez les anciennes dans le Finder, dans les réglages Général de l’appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Mac पर बनाए गए बैकअप। पुराने बैकअप Finder में, डिवाइस की सामान्य सेटिंग्ज़ में हटाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup creati su questo Mac. Rimuovi quelli vecchi nel Finder, nelle impostazioni Generali del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacで作成されたバックアップです。古いものは、Finderでデバイスの“一般”設定から削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 만든 백업입니다. 오래된 백업은 Finder에서 기기의 일반 설정을 통해 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back-ups die op deze Mac zijn gemaakt. Verwijder oude in Finder, via de algemene instellingen van het apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups feitos neste Mac. Remova os antigos no Finder, nos ajustes Geral do dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopior som gjorts på den här datorn. Ta bort gamla i Finder, i enhetens allmänna inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台 Mac 上制作的备份。请在访达中该设备的“通用”设置里移除旧备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這部Mac上製作的備份。請在Finder中透過裝置的「一般」設定移除舊備份。"
          }
        }
      }
    },

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各画面の前回のスキャンとディスクマップの履歴です。起動後すぐに表示されます: %@。"
          }
        },
        "ko" : {
          "stringUnit" : {

          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ajustes do Git dele poderiam executar programas, por isso ele não foi verificado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess Git-inställningar skulle kunna köra program, så det kontrollerades inte."

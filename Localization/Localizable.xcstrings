        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅供检查"
          }
        }
      }
    },
    "Installed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装"
          }
        }
      }
    },
    "Installed Packages" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的软件包"
          }
        }
      }
    },
    "Installed Packages…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的软件包…"
          }
        }
      }
    },
    "Installed apps' helper identities couldn't be read, so no leftovers were offered. Try Scan Again after checking app access." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已安装应用的辅助程序身份，因此没有提供残留项。请检查应用访问权限后重试“重新扫描”。"
          }
        }
      }
    },
    "Installed for every user or the system. Remove it with its app's own uninstaller." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为所有用户或系统安装。请用其应用自带的卸载程序移除。"
          }
        }
      }
    },
    "Installers" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装包"
          }
        }
      }
    },
    "Installers in %@ aren't shown. The result isn't saved as complete." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中的安装包不会显示。该结果不会保存为完整结果。"

    "Uninstall includes the app. Reset keeps the app and only moves the chosen data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Deinstallieren“ schließt die App ein. „Zurücksetzen“ behält die App und bewegt nur die ausgewählten Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desinstalar incluye la app. Restablecer conserva la app y solo mueve los datos elegidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désinstaller inclut l’app. Réinitialiser garde l’app et ne déplace que les données choisies."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनइंस्टॉल में ऐप शामिल है। रीसेट ऐप रखता है और केवल चुना डेटा ले जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disinstalla include l’app. Reimposta mantiene l’app e sposta solo i dati scelti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“アンインストール”ではアプリも対象になります。“リセット”ではアプリを残し、対象のデータだけを移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제거에는 앱이 포함됩니다. 재설정은 앱을 유지하고 선택한 데이터만 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deïnstalleren omvat de app. Opnieuw instellen behoudt de app en verplaatst alleen de gekozen gegevens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desinstalar inclui o app. Redefinir mantém o app e move apenas os dados escolhidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avinstallera tar med appen. Nollställ behåller appen och flyttar bara de valda data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“卸载”会包含应用本身。“重置”会保留应用，只移动所选的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「解除安裝」包含App。「重置」會保留App，只搬移選擇的資料。"
          }
        }
      }
    },
    "Uninstall now moves only the app. Related files can be chosen when the search finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Deinstallieren“ bewegt jetzt nur die App. Zugehörige Dateien können ausgewählt werden, wenn die Suche fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desinstalar ahora solo mueve la app. Los archivos relacionados se podrán elegir cuando termine la búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désinstaller ne déplace maintenant que l’app. Les fichiers associés pourront être choisis à la fin de la recherche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनइंस्टॉल अभी केवल ऐप ले जाता है। खोज पूरी होने पर संबंधित फ़ाइलें चुनी जा सकती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora Disinstalla sposta solo l’app. I file correlati si potranno scegliere al termine della ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今アンインストールすると、アプリだけが移動します。関連ファイルは、検索が終わると対象に追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 제거하면 앱만 이동합니다. 관련 파일은 검색이 끝나면 선택할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je nu deïnstalleert, wordt alleen de app verplaatst. Bijbehorende bestanden kun je kiezen zodra het zoeken klaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desinstalar agora move apenas o app. Os arquivos relacionados podem ser escolhidos quando a busca terminar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du avinstallerar nu flyttas bara appen. Relaterade filer kan väljas när sökningen är klar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

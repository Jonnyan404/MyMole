      }
    },
    "The app's background agent couldn't be stopped (launchctl %d). The app stayed in place. Reopen the app if an earlier agent was stopped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrund-Agent der App konnte nicht gestoppt werden (launchctl %d). Die App ist geblieben. Öffne die App erneut, wenn ein früherer Agent gestoppt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo detener el agente en segundo plano de la app (launchctl %d). La app se quedó donde estaba. Vuelve a abrir la app si se detuvo un agente anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent d’arrière-plan de l’app n’a pas pu être arrêté (launchctl %d). L’app est restée en place. Rouvrez l’app si un agent précédent a été arrêté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का बैकग्राउंड एजेंट रोका नहीं जा सका (launchctl %d)। ऐप अपनी जगह रहा। अगर कोई पिछला एजेंट रोका गया था तो ऐप फिर से खोलें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 백그라운드 에이전트를 중지할 수 없었습니다(launchctl %d). 앱은 그대로 남았습니다. 이전 에이전트가 중지되었다면 앱을 다시 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法停止该应用的自启动项（launchctl %d）。应用保持原位。如果之前的自启动项已被停止，请重新打开该应用。"
          }
        }
      }
    },
    "The app's bundled agents couldn't be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die mitgelieferten Agents der App konnten nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los agentes incluidos en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents intégrés de l’app n’ont pas pu être lus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के बंडल एजेंट पढ़े नहीं जा सके।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에 포함된 에이전트를 읽을 수 없었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取该应用的内置自启动项。"
          }
        }
      }
    },
    "The app's loaded background agents couldn't be checked. Nothing was moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geladenen Hintergrund-Agents der App konnten nicht geprüft werden. Nichts wurde bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron comprobar los agentes en segundo plano cargados de la app. No se movió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents d’arrière-plan chargés de l’app n’ont pas pu être vérifiés. Rien n’a été déplacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के लोड किए बैकग्राउंड एजेंट जाँचे नहीं जा सके। कुछ नहीं ले जाया गया।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 로드된 백그라운드 에이전트를 확인할 수 없었습니다. 아무것도 이동되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法检查该应用已加载的自启动项。没有移动任何内容。"
          }
        }
      }
    },
    "The app's move to the Trash could not be verified. No app data was moved. Check the app in Finder before trying again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bewegen der App in den Papierkorb konnte nicht geprüft werden. Es wurden keine App-Daten bewegt. Sieh dir die App im Finder an, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el traslado de la app a la Papelera. No se movió ningún dato de apps. Comprueba la app en el Finder antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le placement de l’app dans la Corbeille n’a pas pu être vérifié. Aucune donnée d’app n’a été déplacée. Vérifiez l’app dans le Finder avant de réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को ट्रैश में ले जाना सत्यापित नहीं हो सका। कोई ऐप डेटा नहीं ले जाया गया। फिर से कोशिश करने से पहले Finder में ऐप जाँचें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 휴지통으로 이동한 것을 확인할 수 없었습니다. 앱 데이터는 이동되지 않았습니다. 다시 시도하기 전에 Finder에서 앱을 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法核实应用移到废纸篓的操作。没有移动任何应用数据。重试前请在访达中确认该应用。"
          }
        }
      }
    },
    "The battery holds %lld%% of its original charge" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Batterie hält %lld %% ihrer ursprünglichen Ladung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batería conserva el %lld %% de su carga original"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batterie conserve %lld %% de sa charge d’origine"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैटरी अपने मूल चार्ज का %lld%% रखती है"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 원래 충전 용량의 %lld%%를 유지합니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池容量为原始容量的 %lld%%"
          }
        }
      }
    },
    "The clone couldn't be made: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Klon konnte nicht angelegt werden: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo crear el clon: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clone n’a pas pu être créé : %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लोन नहीं बन सका: %@।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클론을 만들 수 없음: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法创建克隆：%@。"
          }
        }
      }
    },
    "The complete folder contents couldn't be selected. Nothing was added. Check access or choose smaller groups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der vollständige Ordnerinhalt konnte nicht ausgewählt werden. Nichts wurde hinzugefügt. Prüfe den Zugriff oder wähle kleinere Gruppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo seleccionar todo el contenido de la carpeta. No se añadió nada. Comprueba el acceso o elige grupos más pequeños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu complet du dossier n’a pas pu être sélectionné. Rien n’a été ajouté. Vérifiez l’accès ou choisissez des groupes plus petits."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोल्डर की पूरी सामग्री चुनी नहीं जा सकी। कुछ नहीं जोड़ा गया। ऐक्सेस जाँचें या छोटे समूह चुनें।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더 내용 전체를 선택할 수 없었습니다. 아무것도 추가되지 않았습니다. 접근 권한을 확인하거나 더 작은 그룹을 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法选定完整的文件夹内容。没有添加任何内容。请检查访问权限，或选择更小的范围。"
          }
        }
      }
    },
    "The copies being replaced go to the Trash, named “before sharing”. The space is free once the Trash is emptied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ersetzten Kopien kommen in den Papierkorb, mit dem Namenszusatz „vor dem Teilen“. Der Platz ist frei, sobald der Papierkorb geleert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias reemplazadas van a la Papelera con el añadido «antes de compartir». El espacio queda libre al vaciar la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies remplacées vont dans la Corbeille, avec la mention « avant partage ». L’espace est libéré une fois la Corbeille vidée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदली जा रही प्रतियाँ “साझा करने से पहले” नाम के साथ ट्रैश में जाती हैं। ट्रैश खाली करने पर जगह खाली होती है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "교체되는 사본은 ‘공유 전’이라는 이름으로 휴지통에 들어갑니다. 휴지통을 비우면 공간이 확보됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被替换的副本会移到废纸篓，名称带有“共享前”。清倒废纸篓后即可释放空间。"
          }
        }
      }
    },
    "The copies of %lld files have different tags, so they're left for you to choose." : {

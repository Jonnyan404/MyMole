    "MyMole is source-available. Personal non-commercial use is permitted; business and organizational use requires a paid commercial license." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Quelltext von MyMole ist verfügbar. Private, nicht kommerzielle Nutzung ist erlaubt; geschäftliche und organisatorische Nutzung erfordert eine kostenpflichtige kommerzielle Lizenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código fuente de MyMole está disponible. Se permite el uso personal no comercial; el uso empresarial y por organizaciones requiere una licencia comercial de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code source de MyMole est disponible. L’usage personnel non commercial est autorisé ; l’usage professionnel et par des organisations nécessite une licence commerciale payante."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole का सोर्स उपलब्ध है। निजी गैर-व्यावसायिक उपयोग की अनुमति है; व्यावसायिक और संगठनात्मक उपयोग के लिए सशुल्क व्यावसायिक लाइसेंस आवश्यक है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole è source-available. È consentito l’uso personale non commerciale; l’uso in aziende e organizzazioni richiede una licenza commerciale a pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMoleはソース公開ソフトウェアです。個人の非商用利用は許可されています。企業や組織での利用には、有料の商用ライセンスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole은 소스 공개 소프트웨어입니다. 개인적인 비상업적 사용은 허용되며, 업무 및 단체 사용에는 유료 상업용 라이선스가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole is source-available. Persoonlijk niet-commercieel gebruik is toegestaan; voor gebruik door bedrijven en organisaties is een betaalde commerciële licentie vereist."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código-fonte do MyMole está disponível. O uso pessoal não comercial é permitido; o uso por empresas e organizações exige uma licença comercial paga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole har öppet tillgänglig källkod (source-available). Personlig, icke-kommersiell användning är tillåten. Användning i företag och organisationer kräver en betald kommersiell licens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole 公开源代码。允许个人非商业使用；商业与组织使用需要付费商业许可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole提供原始碼。允許個人非商業使用；企業和組織使用需要付費的商業授權。"
          }
        }
      }
    },
    "MyMole keeps every scan of a folder. Scan again later — after an update, a project, a week of use — and compare any two to see exactly what grew." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole speichert jeden Scan eines Ordners. Scanne später erneut – nach einem Update, einem Projekt, einer Woche Nutzung – und vergleiche zwei beliebige, um genau zu sehen, was gewachsen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole guarda cada análisis de una carpeta. Vuelve a analizar más tarde —después de una actualización, un proyecto o una semana de uso— y compara dos cualesquiera para ver exactamente qué creció."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole garde chaque analyse d’un dossier. Analysez à nouveau plus tard — après une mise à jour, un projet, une semaine d’utilisation — et comparez-en deux pour voir exactement ce qui a grossi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole किसी फ़ोल्डर का हर स्कैन रखता है। बाद में फिर से स्कैन करें — किसी अपडेट, प्रोजेक्ट या एक सप्ताह के उपयोग के बाद — और कोई भी दो स्कैन तुलना करके देखें कि क्या बढ़ा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole conserva ogni scansione di una cartella. Ripeti la scansione più avanti, dopo un aggiornamento, un progetto o una settimana di utilizzo, e confrontane due qualsiasi per vedere esattamente cosa è cresciuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMoleはフォルダのすべてのスキャンを保存します。時間をおいて、アップデートやプロジェクトのあと、1週間使ったあとなどにもう一度スキャンし、任意の2つを比較すると、何が増えたかを正確に確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole은 폴더의 모든 스캔을 보관합니다. 업데이트, 프로젝트 또는 일주일 사용 후 나중에 다시 스캔하고 두 스캔을 비교하면 무엇이 늘었는지 정확히 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole bewaart elke scan van een map. Scan later opnieuw — na een update, een project, een week gebruik — en vergelijk er twee om precies te zien wat is gegroeid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MyMole guarda todas as análises de uma pasta. Analise novamente mais tarde — após uma atualização, um projeto, uma semana de uso — e compare duas quaisquer para ver exatamente o que aumentou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole sparar varje skanning av en mapp. Skanna igen senare – efter en uppdatering, ett projekt, en veckas användning – och jämför två valfria för att se exakt vad som har vuxit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole 会保留同一文件夹的每次扫描。稍后再扫一次 —— 系统升级后、新建项目后、用了一周后 —— 然后比较任意两次，就能看清究竟什么变大了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole會保存檔案夾的每次掃描。稍後再次掃描（在更新、完成專案或使用一週之後），並比較任兩次掃描來查看究竟是什麼變大了。"
          }
        }
      }
    },
    "MyMole looks for folders with a project file (Package.swift, package.json, .git …) in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole sucht in %@ nach Ordnern mit einer Projektdatei (Package.swift, package.json, .git …)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole busca carpetas con un archivo de proyecto (Package.swift, package.json, .git …) en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole cherche les dossiers contenant un fichier de projet (Package.swift, package.json, .git …) dans %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole %@ में प्रोजेक्ट फ़ाइल (Package.swift, package.json, .git …) वाले फ़ोल्डर खोजता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole cerca le cartelle con un file di progetto (Package.swift, package.json, .git …) in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMoleは、プロジェクトファイル（Package.swift、package.json、.gitなど）のあるフォルダを%@で探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole은 %@에서 프로젝트 파일(Package.swift, package.json, .git …)이 있는 폴더를 찾습니다."
          }
        },
        "nl" : {
          "stringUnit" : {

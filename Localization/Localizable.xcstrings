    "Conda's downloaded packages. Fetched again when an environment needs one, which needs the network; environments keep what they use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Conda geladene Pakete. Werden erneut geladen, wenn eine Umgebung eines braucht; dafür ist das Netzwerk nötig. Umgebungen behalten, was sie verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paquetes descargados por Conda. Se vuelven a descargar cuando un entorno necesita uno, lo que necesita la red; los entornos conservan lo que usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paquets téléchargés par Conda. Récupérés à nouveau quand un environnement en a besoin, ce qui nécessite le réseau ; les environnements gardent ce qu’ils utilisent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conda द्वारा डाउनलोड किए पैकेज। किसी एनवायरनमेंट को ज़रूरत होने पर फिर से लाए जाते हैं, जिसके लिए नेटवर्क चाहिए; एनवायरनमेंट जो उपयोग करते हैं उसे रखते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacchetti scaricati da Conda. Vengono recuperati di nuovo quando un ambiente ne ha bisogno, il che richiede la rete; gli ambienti conservano ciò che usano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードされたCondaのパッケージです。環境で必要になると再び取得され、ネットワークが必要です。環境が使っているものは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conda가 다운로드한 패키지입니다. 환경에 필요할 때 다시 받으며 네트워크가 필요합니다. 환경은 사용하는 패키지를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedownloade pakketten van Conda. Worden opnieuw opgehaald wanneer een omgeving er een nodig heeft, waarvoor het netwerk nodig is; omgevingen behouden wat ze gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacotes baixados pelo Conda. Buscados novamente quando um ambiente precisa de um, o que requer a rede; os ambientes mantêm o que usam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condas hämtade paket. Hämtas igen när en miljö behöver något, vilket kräver nätverk. Miljöer behåller det de använder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conda 下载的软件包。环境需要时会重新获取，需要联网；环境正在使用的包会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conda下載的套件。環境需要時會再次取得，需要網路；環境會保留其使用的套件。"
          }
        }
      }
    },

    "The app builds it again as it needs it; it may start a little slower once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App erstellt es bei Bedarf neu; sie startet eventuell einmal etwas langsamer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app lo reconstruye cuando lo necesita; puede que tarde un poco más en iniciarse una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app le reconstruit au besoin ; elle peut démarrer un peu plus lentement une fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप ज़रूरत पड़ने पर इसे फिर से बनाता है; एक बार यह थोड़ा धीमा शुरू हो सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app la ricrea quando le serve; potrebbe avviarsi un po’ più lentamente, una volta sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要に応じてアプリが作り直します。一度だけ起動が少し遅くなることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 필요할 때 다시 만들며, 한 번은 시작이 조금 느릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app bouwt het opnieuw op wanneer het nodig is; het starten kan eenmalig iets langzamer gaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app o recria conforme precisa; pode iniciar um pouco mais devagar uma vez."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen återskapar det när den behöver det. Den kan starta lite långsammare en gång."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会在需要时重新生成；下次启动可能稍慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App會在需要時再次建立；可能會有一次啟動稍慢。"
          }
        }
      }
    },
    "The app changed after the review. Nothing was moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App hat sich nach der Prüfung geändert. Nichts wurde bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app cambió después de la revisión. No se movió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a changé après l’examen. Rien n’a été déplacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समीक्षा के बाद ऐप बदल गया। कुछ नहीं ले जाया गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app è cambiata dopo la revisione. Non è stato spostato nulla."

        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のインストーラは表示されていません。結果は完全なものとしては保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 설치 프로그램은 표시되지 않습니다. 결과가 완전한 것으로 저장되지 않습니다."

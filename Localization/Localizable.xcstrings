    },
    "The tool downloads it again when a project needs it; the next install or build is slower once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tool lädt es erneut, wenn ein Projekt es braucht; die nächste Installation oder der nächste Build ist einmal langsamer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta lo vuelve a descargar cuando un proyecto lo necesita; la próxima instalación o compilación es más lenta una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil le retélécharge quand un projet en a besoin ; la prochaine installation ou compilation est plus lente une fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी प्रोजेक्ट को ज़रूरत होने पर टूल इसे फिर से डाउनलोड करता है; अगला इंस्टॉल या बिल्ड एक बार धीमा होगा।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트에 필요할 때 도구가 다시 다운로드합니다. 다음 설치나 빌드가 한 번 느려집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目需要时工具会重新下载；下次安装或构建会慢一次。"
          }
        }
      }
    },
    "The tool must run as root." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tool muss als root laufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta debe ejecutarse como root."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil doit s’exécuter en tant que root."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टूल को root के रूप में चलना चाहिए।"
          }
        },
        "ko" : {

    "macOS hasn't provided battery data. You can hide this card if it isn't useful on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat keine Batteriedaten geliefert. Du kannst diese Karte ausblenden, wenn sie auf diesem Mac nicht nützlich ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha proporcionado datos de batería. Puedes ocultar esta tarjeta si no es útil en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas fourni de données de batterie. Vous pouvez masquer cette carte si elle n’est pas utile sur ce Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ने बैटरी डेटा नहीं दिया। अगर यह कार्ड इस Mac पर उपयोगी नहीं है तो इसे छिपा सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha fornito dati sulla batteria. Puoi nascondere questa scheda se non è utile su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSからバッテリーのデータが提供されていません。このMacで不要な場合は、このカードを非表示にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 배터리 데이터를 제공하지 않았습니다. 이 Mac에서 유용하지 않으면 이 카드를 가릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS heeft geen batterijgegevens doorgegeven. Je kunt deze kaart verbergen als die op deze Mac niet nuttig is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não forneceu dados da bateria. Você pode ocultar este cartão se ele não for útil neste Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS har inte lämnat några batteridata. Du kan gömma kortet om det inte är till nytta på den här datorn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 没有提供电池数据。如果这张卡片对这台 Mac 没用，可以隐藏它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS未提供電池資料。若此卡片在這部Mac上沒有用處，你可以將其隱藏。"
          }
        }
      }
    },
    "macOS is waiting for you to allow MyMole in System Settings → General → Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wartet darauf, dass du MyMole unter „Systemeinstellungen“ → „Allgemein“ → „Anmeldeobjekte“ erlaubst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS está esperando a que permitas MyMole en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS attend que vous autorisiez MyMole dans Réglages Système → Général → Ouverture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS आपके सिस्टम सेटिंग → सामान्य → लॉगइन आइटम में MyMole को अनुमति देने की प्रतीक्षा कर रहा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

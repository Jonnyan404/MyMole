    "%lld system items are deleted for good; they can't go to the Trash. The services that made them rebuild what they need. macOS asks for an administrator's password first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Systemobjekt wird endgültig gelöscht; es kann nicht in den Papierkorb. Der Dienst, der es erstellt hat, erstellt neu, was er braucht. macOS fragt zuerst nach dem Passwort eines Administrators."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Systemobjekte werden endgültig gelöscht; sie können nicht in den Papierkorb. Die Dienste, die sie erstellt haben, erstellen neu, was sie brauchen. macOS fragt zuerst nach dem Passwort eines Administrators."
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg system item is deleted for good; it can't go to the Trash. The service that made it rebuilds what it needs. macOS asks for an administrator's password first."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg system items are deleted for good; they can't go to the Trash. The services that made them rebuild what they need. macOS asks for an administrator's password first."
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg elemento del sistema se elimina definitivamente; no puede ir a la Papelera. El servicio que lo creó reconstruye lo que necesita. macOS pide primero la contraseña de un administrador."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg elementos del sistema se eliminan definitivamente; no pueden ir a la Papelera. Los servicios que los crearon reconstruyen lo que necesitan. macOS pide primero la contraseña de un administrador."
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg élément système est supprimé définitivement ; il ne peut pas aller dans la Corbeille. Le service qui l’a créé reconstruit ce dont il a besoin. macOS demande d’abord le mot de passe d’un administrateur."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg éléments système sont supprimés définitivement ; ils ne peuvent pas aller dans la Corbeille. Les services qui les ont créés reconstruisent ce dont ils ont besoin. macOS demande d’abord le mot de passe d’un administrateur."
                    }
                  }
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg सिस्टम आइटम स्थायी रूप से हटाया जाता है; यह ट्रैश में नहीं जा सकता। इसे बनाने वाली सेवा जो चाहिए वह फिर से बनाती है। macOS पहले एडमिनिस्ट्रेटर का पासवर्ड माँगता है।"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg सिस्टम आइटम स्थायी रूप से हटाए जाते हैं; ये ट्रैश में नहीं जा सकते। इन्हें बनाने वाली सेवाएँ जो चाहिए वह फिर से बनाती हैं। macOS पहले एडमिनिस्ट्रेटर का पासवर्ड माँगता है।"
                    }
                  }
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "시스템 항목 %arg개가 영구적으로 삭제되며 휴지통으로 이동할 수 없습니다. 이를 만든 서비스가 필요한 것을 다시 만듭니다. macOS가 먼저 관리자 암호를 요청합니다."
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg 个系统项将被永久删除，无法移到废纸篓。生成它们的服务会重建所需内容。macOS 会先要求输入管理员密码。"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håller minst i minnet och på skivan: stora listor flyttas till skivan tidigast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "%@ runs from a disk image mounted at %@, and MyMole couldn't find the image file. Eject it in Finder, then move the image file to the Trash." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ runs from a disk image mounted at %2$@, and MyMole couldn't find the image file. Eject it in Finder, then move the image file to the Trash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 从挂载在 %2$@ 的磁盘映像运行，MyMole 找不到该映像文件。请在访达中推出它，再把映像文件移到废纸篓。"
          }
        }
      }
    },
    "%@ runs from the disk image %@. An app can't be removed from a disk image: the image is ejected and its file moved to the Trash. A copy in Applications is uninstalled from the list." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

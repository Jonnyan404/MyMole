    "Hidden items only" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ausgeblendete Objekte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

    "Sizes come from the last scan. Running status updates live; Reload measures sizes again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größen stammen aus dem letzten Scan. Der Laufstatus wird live aktualisiert; „Neu laden“ misst die Größen erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tamaños vienen del último análisis. El estado de ejecución se actualiza en vivo; Volver a cargar mide de nuevo los tamaños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tailles viennent de la dernière analyse. L’état d’exécution se met à jour en direct ; Recharger mesure à nouveau les tailles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार पिछले स्कैन से हैं। चलने की स्थिति लाइव अपडेट होती है; फिर से लोड करें आकार दोबारा मापता है।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기는 마지막 스캔 기준입니다. 실행 상태는 실시간으로 업데이트되며, 다시 불러오기로 크기를 다시 측정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大小来自上次扫描。运行状态会实时更新；重新载入会重新测量大小。"
          }
        }
      }
    },

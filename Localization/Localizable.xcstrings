    "Has %lld other name%@ (hard link%@) — its space stays in use until every name goes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Has %1$lld other name%2$@ (hard link%3$@) — its space stays in use until every name goes"

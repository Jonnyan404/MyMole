          }
        }
      }
    },
    "A PDF goes three levels and a thousand files deep at most. Choose CSV for every level and file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein PDF geht höchstens drei Ebenen tief und listet höchstens tausend Dateien. Wähle CSV für alle Ebenen und Dateien."
          }
        },
        "es" : {

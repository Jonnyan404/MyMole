    "Measuring the project folder. Sizes inside it are from the last scan until then." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Projektordner wird gemessen. Größen darin stammen bis dahin aus dem letzten Scan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midiendo la carpeta del proyecto. Hasta entonces, los tamaños de dentro son los del último análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure du dossier du projet. Les tailles à l’intérieur sont celles de la dernière analyse d’ici là."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",

    "One of Ollama's model lists couldn't be read, so it isn't known which layers other models use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine der Modelllisten von Ollama konnte nicht gelesen werden, daher ist nicht bekannt, welche Schichten andere Modelle nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer una de las listas de modelos de Ollama, así que no se sabe qué capas usan otros modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une des listes de modèles d’Ollama n’a pas pu être lue : on ne sait donc pas quelles couches les autres modèles utilisent."

              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "此应用和已选的 %arg 项数据会移到废纸篓，“登录时打开”会被关闭。随后 MyMole 会退出。你可以在“访达”的废纸篓中用“放回原处”恢复；退出后无法使用应用内撤销。"
                    }
                  }
                }
              }
            }
          }
        }
      }

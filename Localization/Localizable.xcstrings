    "MyMole is in the Trash. Some chosen data couldn't be moved and stays where it is. Quit when you're ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole ist im Papierkorb. Einige ausgewählte Daten konnten nicht bewegt werden und bleiben, wo sie sind. Beende die App, wenn du bereit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole está en la Papelera. Algunos datos elegidos no se pudieron mover y se quedan donde están. Cierra la app cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole est dans la Corbeille. Certaines données choisies n’ont pas pu être déplacées et restent en place. Quittez quand vous êtes prêt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole रद्दी में है। कुछ चुना डेटा ले जाया नहीं जा सका और अपनी जगह रहता है। तैयार होने पर बंद करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole è nel Cestino. Non è stato possibile spostare alcuni dei dati scelti, che restano dove sono. Esci quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMoleはゴミ箱に入っています。対象のデータの一部は移動できず、元の場所に残っています。準備ができたら終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole이 휴지통에 있습니다. 선택한 일부 데이터는 이동할 수 없어 그 자리에 남습니다. 준비되면 종료하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole ligt in de prullenmand. Sommige gekozen gegevens konden niet worden verplaatst en blijven op hun plaats. Stop MyMole wanneer je klaar bent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MyMole está no Lixo. Alguns dados escolhidos não puderam ser movidos e continuam onde estão. Encerre quando quiser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole ligger i papperskorgen. En del valda data kunde inte flyttas och finns kvar på sin plats. Avsluta när du är redo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole 已在废纸篓中。部分所选数据无法移动，仍留在原处。准备好后请退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyMole已在垃圾桶中。部分選擇的資料無法搬移，因此留在原處。準備好後即可結束。"
          }
        }
      }
    },

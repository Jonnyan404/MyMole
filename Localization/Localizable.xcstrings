    "Sessions and DerivedData are tied to the project by the path their tool recorded. Items in ~/Library are matched by name: their bundle ID contains “%@”. Check those before removing them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen und DerivedData sind über den Pfad, den ihr Tool erfasst hat, mit dem Projekt verknüpft. Objekte in ~/Library werden nach Namen gefunden: Ihre Bundle-ID enthält „%@“. Prüfe diese vor dem Entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones y DerivedData se vinculan al proyecto por la ruta que registró su herramienta. Los elementos de ~/Library coinciden por nombre: su ID de paquete contiene “%@”. Revísalos antes de eliminarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions et DerivedData sont liés au projet par le chemin que leur outil a enregistré. Les éléments de ~/Library sont trouvés par le nom : leur identifiant de paquet contient « %@ ». Vérifiez-les avant de les supprimer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सत्र और DerivedData उस पथ से प्रोजेक्ट से जुड़े हैं जिसे उनके टूल ने दर्ज किया। ~/Library के आइटम नाम से मेल खाते हैं: उनकी बंडल ID में “%@” है। हटाने से पहले इन्हें जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessioni e DerivedData sono legati al progetto dal percorso registrato dal loro strumento. Gli elementi in ~/Library sono abbinati per nome: il loro ID bundle contiene “%@”. Controllali prima di rimuoverli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションとDerivedDataは、ツールが記録したパスによってプロジェクトに関連付けられます。~/Library内の項目は名前で照合され、バンドルIDに“%@”が含まれています。削除する前に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션과 DerivedData는 도구가 기록한 경로로 프로젝트와 연결됩니다. ~/Library의 항목은 이름으로 일치하며 번들 ID에 “%@”이(가) 포함됩니다. 제거하기 전에 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessies en DerivedData zijn aan het project gekoppeld via het pad dat hun tool heeft vastgelegd. Onderdelen in ~/Library zijn op naam gevonden: hun bundel-ID bevat '%@'. Controleer die voordat je ze verwijdert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões e o DerivedData são ligados ao projeto pelo caminho que a ferramenta registrou. Os itens em ~/Library são associados pelo nome: o ID de pacote deles contém “%@”. Verifique-os antes de remover."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessioner och DerivedData hör till projektet genom sökvägen som deras verktyg har antecknat. Objekt i ~/Library matchas på namn: deras paket-ID innehåller ”%@”. Kontrollera dem innan du tar bort dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话与 DerivedData 通过其工具记录的路径与项目关联。~/Library 中的项目按名称匹配：其 Bundle ID 含“%1$@”。移除前请先核实这些项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段和DerivedData是依其工具記錄的路徑與專案建立關聯。~/Library中的項目是依名稱比對：其套件識別碼包含「%@」。移除前請先檢查。"
          }
        }
      }
    },

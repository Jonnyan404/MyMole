    "Get every pane ready at launch Disk map history scans per folder Saved results Each kind Clear Saved Results Remove prefetch memory cache storage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Bereich beim Start vorbereiten Verlauf der Festplattenkarte Scans pro Ordner Gesicherte Ergebnisse Jede Art Gesicherte Ergebnisse löschen Entfernen Vorladen Arbeitsspeicher Cache Speicher prefetch memory storage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparar todos los paneles al abrir Historial del mapa del disco análisis por carpeta Resultados guardados Cada tipo Borrar resultados guardados Eliminar precarga memoria caché almacenamiento prefetch memory storage"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparer chaque sous-fenêtre au lancement Historique de la carte du disque analyses par dossier Résultats enregistrés Chaque type Effacer les résultats enregistrés Supprimer préchargement mémoire cache stockage prefetch memory storage"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉन्च पर हर पैन तैयार करें डिस्क मैप इतिहास प्रति फ़ोल्डर स्कैन सहेजे गए परिणाम हर प्रकार सहेजे गए परिणाम हटाएँ हटाएँ प्रीफ़ेच मेमोरी कैश स्टोरेज prefetch memory storage"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara ogni pannello all’avvio Cronologia della mappa del disco scansioni per cartella Risultati salvati Ogni tipo Cancella risultati salvati Rimuovi precaricamento memoria cache spazio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にすべての画面を準備 ディスクマップの履歴 フォルダごとのスキャン数 保存された結果 種類別 保存された結果を消去 削除 先読み メモリー キャッシュ ストレージ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 시 모든 패널 준비 디스크 맵 기록 폴더당 스캔 저장된 결과 각 종류 저장된 결과 지우기 제거 미리 불러오기 메모리 캐시 저장 공간 prefetch memory storage"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak elk paneel klaar Bij openen Schijfkaartgeschiedenis scans per map Bewaarde resultaten Elke soort Wis bewaarde resultaten Verwijder vooraf laden geheugen cache opslag"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixar todas as telas prontas ao abrir Histórico do mapa do disco análises por pasta Resultados salvos Cada tipo Limpar Resultados Salvos Remover memória cache armazenamento"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör alla paneler redo vid start Lagringskarta historik skanningar per mapp Sparade resultat Varje typ Rensa sparade resultat Ta bort förladdning minne cache lagring"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时预先准备所有面板 磁盘图历史 每个文件夹的扫描次数 已保存的结果 每种类型 清除已保存的结果 移除预取 内存 缓存 存储"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動時備妥所有面板 磁碟地圖歷史記錄 每個檔案夾的掃描 已儲存的結果 每種類型 清除已儲存的結果 移除 預先載入 記憶體 快取 儲存空間"
          }
        }
      }
    },
    "Git couldn't check it for tracked files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git konnte es nicht auf verfolgte Dateien prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git no pudo comprobar si tiene archivos seguidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git n’a pas pu y chercher de fichiers suivis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git इसमें ट्रैक की गई फ़ाइलें नहीं जाँच सका।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git non è riuscito a controllare se contiene file tracciati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理されているファイルがあるかどうか、Gitで確認できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git이 추적 파일을 확인할 수 없었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git kon dit niet controleren op gevolgde bestanden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Git não conseguiu verificar se há arquivos rastreados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git kunde inte kontrollera om det innehåller spårade filer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 无法检查其中是否有被跟踪的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git無法檢查其中是否有追蹤的檔案。"
          }
        }
      }
    },
    "Git couldn't check it for uncommitted work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git konnte es nicht auf nicht festgeschriebene Arbeit prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git no pudo comprobar si tiene trabajo sin confirmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git n’a pas pu y chercher de travail non validé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git इसमें बिना कमिट किया काम नहीं जाँच सका।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git non è riuscito a controllare se contiene lavoro non salvato con un commit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミットされていない作業があるかどうか、Gitで確認できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git이 커밋되지 않은 작업을 확인할 수 없었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git kon dit niet controleren op niet-gecommit werk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Git não conseguiu verificar se há trabalho sem commit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git kunde inte kontrollera om det innehåller arbete som inte har checkats in."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 无法检查其中是否有未提交的改动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git無法檢查其中是否有未提交的工作內容。"
          }
        }
      }
    },

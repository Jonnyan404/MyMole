    },
    "The copy couldn't be replaced: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie konnte nicht ersetzt werden: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo reemplazar la copia: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie n’a pas pu être remplacée : %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रति बदली नहीं जा सकी: %@।"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

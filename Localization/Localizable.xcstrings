    "This app and the %lld chosen data items go to the Trash. Open at Login is turned off. MyMole then quits. You can restore them with Put Back in Finder's Trash; in-app Undo isn't available after quitting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Diese App und das ausgewählte Datenobjekt kommen in den Papierkorb. „Bei der Anmeldung öffnen“ wird deaktiviert. MyMole wird dann beendet. Du kannst sie mit „Zurücklegen“ im Papierkorb des Finder wiederherstellen; „Widerrufen“ in der App ist nach dem Beenden nicht verfügbar."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Diese App und die %arg ausgewählten Datenobjekte kommen in den Papierkorb. „Bei der Anmeldung öffnen“ wird deaktiviert. MyMole wird dann beendet. Du kannst sie mit „Zurücklegen“ im Papierkorb des Finder wiederherstellen; „Widerrufen“ in der App ist nach dem Beenden nicht verfügbar."
                    }
                  }
                }
              }
            }
          }
        },

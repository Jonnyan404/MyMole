    "Written in the last few minutes, probably by something running in the background. Left unticked; tick it yourself if it can go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den letzten Minuten geschrieben, vermutlich von etwas im Hintergrund. Nicht markiert gelassen; markiere es selbst, wenn es weg kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrito en los últimos minutos, probablemente por algo en segundo plano. Se deja sin marcar; márcalo tú si se puede ir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit ces dernières minutes, probablement par un processus en arrière-plan. Laissé décoché ; cochez-le vous-même s’il peut partir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले कुछ मिनटों में लिखा गया, शायद बैकग्राउंड में चल रही किसी चीज़ ने। बिना चिह्न छोड़ा गया; अगर यह जा सकता है तो खुद चिह्नित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scritto negli ultimi minuti, probabilmente da qualcosa in esecuzione in background. Lasciato senza spunta; spuntalo tu se può essere tolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数分以内に、おそらくバックグラウンドで動作中のものが書き込みました。チェックは付いていません。削除してよければチェックを付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 몇 분 동안 기록되었으며 아마 백그라운드 작업 때문일 것입니다. 체크하지 않은 상태로 두었으니 제거해도 된다면 직접 체크하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is de afgelopen minuten naar geschreven, waarschijnlijk door iets dat op de achtergrond actief is. Niet aangevinkt; vink het zelf aan als het weg kan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravado nos últimos minutos, provavelmente por algo em execução em segundo plano. Deixado desmarcado; marque-o você mesmo se puder sair."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrevs under de senaste minuterna, troligen av något som körs i bakgrunden. Lämnas utan kryss. Kryssa för den själv om den kan tas bort."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近几分钟内有写入，可能是后台运行的某个东西写的。已保持未勾选；如果可以移除，请自行勾选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在過去幾分鐘內寫入，可能是由背景執行的程式所寫。未勾選；若可以移除，請自行勾選。"
          }
        }
      }
    },

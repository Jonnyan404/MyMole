          }
        }
      }
    },
    "A list of the folders and largest files in this map, with their sizes. It's saved only where you choose, and can't be opened as a scan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Liste der Ordner und größten Dateien in dieser Karte mit ihren Größen. Sie wird nur dort gespeichert, wo du es wählst, und lässt sich nicht als Scan öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lista de las carpetas y los archivos más grandes de este mapa, con sus tamaños. Se guarda solo donde elijas y no se puede abrir como análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une liste des dossiers et des plus gros fichiers de cette carte, avec leurs tailles. Elle est enregistrée uniquement à l’endroit choisi et ne peut pas être ouverte comme une analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस मैप के फ़ोल्डरों और सबसे बड़ी फ़ाइलों की सूची, उनके आकार के साथ। यह केवल वहीं सहेजी जाती है जहाँ आप चुनते हैं, और इसे स्कैन के रूप में नहीं खोला जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elenco delle cartelle e dei file più grandi di questa mappa, con le loro dimensioni. Viene salvato solo dove scegli e non può essere aperto come scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマップのフォルダと最大級のファイルを、サイズとともに一覧にしたものです。指定した場所だけに保存され、スキャンとして開くことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 맵의 폴더와 가장 큰 파일 목록과 크기입니다. 선택한 위치에만 저장되며 스캔으로 열 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een lijst van de mappen en grootste bestanden in deze kaart, met hun grootte. Die wordt alleen bewaard waar je kiest en kan niet als scan worden geopend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma lista das pastas e dos maiores arquivos deste mapa, com seus tamanhos. É salva apenas onde você escolher e não pode ser aberta como uma análise."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lista över mapparna och de största filerna i den här kartan, med storlekar. Den sparas bara där du väljer och kan inte öppnas som en skanning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此磁盘图中的文件夹和最大文件的列表及其大小。它只保存在你选择的位置，且不能作为扫描打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地圖中檔案夾和最大檔案的列表及其大小。只會儲存在你選擇的位置，且無法當作掃描打開。"
          }
        }
      }
    },
    "A looser match of its name; look before choosing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein lockerer Treffer nach dem Namen; vor dem Auswählen ansehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una coincidencia menos estricta con su nombre; míralo antes de elegirlo"

    "Messages and their attachments. Remove them in Mail and Messages; Messages can keep them for a set time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten und ihre Anhänge. Entferne sie in Mail und Nachrichten; Nachrichten kann sie für eine bestimmte Zeit behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensajes y sus adjuntos. Elimínalos en Mail y Mensajes; Mensajes puede guardarlos durante un tiempo fijado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages et leurs pièces jointes. Supprimez-les dans Mail et Messages ; Messages peut les garder pendant une durée choisie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदेश और उनके अटैचमेंट। इन्हें Mail और Messages में हटाएँ; Messages इन्हें तय समय तक रख सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi e i loro allegati. Rimuovili in Mail e Messaggi; Messaggi può conservarli per un periodo stabilito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージとその添付ファイルです。“メール”アプリと“メッセージ”アプリで削除してください。メッセージの保存期間は“メッセージ”アプリで設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지와 첨부 파일입니다. Mail과 메시지에서 제거하세요. 메시지는 정해진 기간만 보관하도록 설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berichten en de bijlagen ervan. Verwijder ze in Mail en Berichten; Berichten kan ze een bepaalde tijd bewaren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensagens e seus anexos. Remova-os no Mail e no Mensagens; o Mensagens pode guardá-los por um tempo definido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelanden och deras bilagor. Ta bort dem i Mail och Meddelanden. Meddelanden kan spara dem under en angiven tid."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件、信息及其附件。请在邮件和信息中移除；信息可设为只保留一段时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "郵件、訊息及其附件。請在「郵件」和「訊息」中移除；「訊息」可以只保留一段設定的時間。"
          }
        }
      }
    },

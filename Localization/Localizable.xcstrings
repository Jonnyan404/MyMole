    "Files under 1 MB, counted together. Tick them to choose the files there now; a file made later isn't chosen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien unter 1 MB, zusammen gezählt. Wähle sie aus, um die jetzt vorhandenen Dateien auszuwählen; eine später erstellte Datei gehört nicht dazu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos de menos de 1 MB, contados juntos. Márcalos para elegir los archivos que hay ahora; un archivo creado después no se elige."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers de moins de 1 Mo, comptés ensemble. Cochez-les pour choisir les fichiers présents maintenant ; un fichier créé plus tard n’est pas choisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 MB से छोटी फ़ाइलें, साथ में गिनी गईं। अभी मौजूद फ़ाइलों को चुनने के लिए इन पर सही का निशान लगाएँ; बाद में बनी फ़ाइल नहीं चुनी जाती।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File sotto 1 MB, contati insieme. Spuntali per scegliere i file presenti ora; un file creato in seguito non viene scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 MB未満のファイルをまとめたものです。チェックを付けると、現在そこにあるファイルが対象になります。あとで作成されたファイルは対象になりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1MB 미만 파일을 함께 계산합니다. 선택하면 지금 있는 파일이 선택되며, 나중에 만들어진 파일은 선택되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden kleiner dan 1 MB, samen geteld. Vink ze aan om de bestanden te kiezen die er nu zijn; een bestand dat later wordt gemaakt, wordt niet gekozen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos com menos de 1 MB, contados juntos. Marque-os para escolher os arquivos que estão lá agora; um arquivo criado depois não é escolhido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer under 1 MB, räknade tillsammans. Kryssa för dem för att välja filerna som finns där nu. En fil som skapas senare är inte vald."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小于 1 MB 的文件合并统计。勾选后会选择当前已有的文件；之后新建的文件不会被选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

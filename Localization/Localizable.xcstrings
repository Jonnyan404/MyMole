    "“%@:” isn't a condition. Use size:, kind:, ext:, age: or hidden:, or put the word in quotes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@:“ ist keine Bedingung. Verwende size:, kind:, ext:, age: oder hidden:, oder setze das Wort in Anführungszeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@:» no es una condición. Usa size:, kind:, ext:, age: o hidden:, o pon la palabra entre comillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@: » n’est pas une condition. Utilisez size:, kind:, ext:, age: ou hidden:, ou mettez le mot entre guillemets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@:” कोई शर्त नहीं है। size:, kind:, ext:, age: या hidden: का उपयोग करें, या शब्द को उद्धरण चिह्नों में रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@:” non è una condizione. Usa size:, kind:, ext:, age: o hidden:, oppure metti la parola tra virgolette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@:”は条件ではありません。size:、kind:、ext:、age:、hidden:のいずれかを使うか、語句を引用符で囲んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@:”은(는) 조건이 아닙니다. size:, kind:, ext:, age:, hidden: 중 하나를 쓰거나 단어를 따옴표로 묶으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@:' is geen voorwaarde. Gebruik size:, kind:, ext:, age: of hidden:, of zet het woord tussen aanhalingstekens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@:” não é uma condição. Use size:, kind:, ext:, age: ou hidden:, ou coloque a palavra entre aspas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@:” är inget villkor. Använd size:, kind:, ext:, age: eller hidden:, eller sätt ordet inom citattecken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@:”不是条件。请使用 size:、kind:、ext:、age: 或 hidden:，或将该词放在引号中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@:」不是條件。請使用size:、kind:、ext:、age: 或hidden:，或用引號括住該字詞。"
          }
        }
      }
    },
